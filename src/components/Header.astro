---
import { t } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
import { getActiveTeams } from '../lib/fetch/teams';
import { getBadgeText, getTeamDefs, type TeamCategory } from '../data/teams';

interface Props {
  locale?: Locale;
}

// Single-URL site: build-time render is German; the client engine swaps text
// to English in place. `locale` stays for the German default render only.
const { locale = 'de' } = Astro.props;

// Links are locale-less now — one URL per page.
const l = (path: string) => path;

// Volleyball nav — live leagues/labels from Directus (Volleymanager is the
// source of truth), so the dropdown follows the D1/D2 swap automatically.
// Falls back to the static defs if Directus is unreachable at build time.
type NavTeam = { slug: string; displayName: string; league: string; chipLabel: string; category: string; order: number };
let vbNav: NavTeam[] = [];
try {
  vbNav = (await getActiveTeams())
    .filter((tm) => tm.sport === 'volleyball' && tm.hasDetailPage)
    .map((tm) => ({ slug: tm.slug, displayName: tm.displayName, league: tm.league, chipLabel: tm.chipLabel, category: tm.category, order: tm.order }));
} catch { /* fall back below */ }
if (!vbNav.length) {
  vbNav = (['women', 'men', 'youth'] as TeamCategory[])
    .flatMap((c) => getTeamDefs('volleyball', c))
    .filter((d) => d.hasDetailPage)
    .map((d) => ({ slug: d.slug, displayName: d.displayName, league: d.fallbackLeague || '', chipLabel: d.chipLabel, category: d.category, order: d.order }));
}
const vbBy = (cat: string) => vbNav.filter((tm) => tm.category === cat).sort((a, b) => a.order - b.order);
const vbWomen = vbBy('women');
const vbMen = vbBy('men');
const vbYouth = vbBy('youth');

// Basketball nav — same treatment as volleyball above.
//
// These five links were hardcoded, and three of them contradicted the page they
// pointed at: /basketball/h3 was labelled "Herren 3" but its page reads "Herren 2",
// /basketball/h4 was "Herren 4" against "Unicorns Herren 3", and Rhinos was tagged
// "2. Liga" while its league is D3LR, i.e. the third. Hand-maintained labels drift
// away from Directus at every season rollover; the volleyball half has been built
// from live data all along, so this just mirrors it.
let bbNav: NavTeam[] = [];
try {
  bbNav = (await getActiveTeams())
    .filter((tm) => tm.sport === 'basketball' && tm.hasDetailPage)
    .map((tm) => ({ slug: tm.slug, displayName: tm.displayName, league: tm.league, chipLabel: tm.chipLabel, category: tm.category, order: tm.order }));
} catch { /* fall back below */ }
if (!bbNav.length) {
  bbNav = (['women', 'men', 'youth'] as TeamCategory[])
    .flatMap((c) => getTeamDefs('basketball', c))
    .filter((d) => d.hasDetailPage)
    .map((d) => ({ slug: d.slug, displayName: d.displayName, league: d.fallbackLeague || '', chipLabel: d.chipLabel, category: d.category, order: d.order }));
}
const bbBy = (cat: string) => bbNav.filter((tm) => tm.category === cat).sort((a, b) => a.order - b.order);
const bbWomen = bbBy('women');
const bbMen = bbBy('men');
