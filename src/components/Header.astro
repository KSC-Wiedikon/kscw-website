---
import { t, getAlternateUrl } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
import { getActiveTeams } from '../lib/fetch/teams';
import { getBadgeText, getTeamDefs, type TeamCategory } from '../data/teams';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const otherLocale = locale === 'de' ? 'en' : 'de';
const altUrl = getAlternateUrl(Astro.url);

// Helper to prefix locale
const l = (path: string) => `/${locale}${path}`;

// Volleyball nav — live leagues/labels from Directus (Volleymanager is the
// source of truth), so the dropdown follows the D1/D2 swap automatically.
// Falls back to the static defs if Directus is unreachable at build time.
type NavTeam = { slug: string; displayName: string; league: string; chipLabel: string; category: string; order: number };
let vbNav: NavTeam[] = [];
try {
  vbNav = (await getActiveTeams())
    .filter((tm) => tm.sport === 'volleyball' && tm.hasDetailPage)
    .map((tm) => ({ slug: tm.slug, displayName: tm.displayName, league: tm.league, chipLabel: tm.chipLabel, category: tm.category, order: tm.order }));
} catch { /* fall back below */ }
if (!vbNav.length) {
  vbNav = (['women', 'men', 'youth'] as TeamCategory[])
    .flatMap((c) => getTeamDefs('volleyball', c))
    .filter((d) => d.hasDetailPage)
    .map((d) => ({ slug: d.slug, displayName: d.displayName, league: d.fallbackLeague || '', chipLabel: d.chipLabel, category: d.category, order: d.order }));
}
const vbBy = (cat: string) => vbNav.filter((tm) => tm.category === cat).sort((a, b) => a.order - b.order);
const vbWomen = vbBy('women');
const vbMen = vbBy('men');
const vbYouth = vbBy('youth');

// Build the alternate path for language toggle
const currentPath = Astro.url.pathname;
const dePath = currentPath.replace(`/en/`, `/de/`).replace(/^\/en$/, '/de');
const enPath = currentPath.replace(`/de/`, `/en/`).replace(/^\/de$/, '/en');
---
  <header class="site-header">
    <div class="container">
      <nav class="nav-inner">
        <a href={l('/')} class="nav-logo">
          <img src="/images/kscw_weiss.png" alt="KSC Wiedikon" class="logo-dark">
          <img src="/images/kscw_blau.png" alt="KSC Wiedikon" class="logo-light">
          <span>KSC Wiedikon</span>
        </a>

        <!-- Desktop Navigation -->
        <div class="nav-menu">
          <div class="nav-item">
            <button type="button" class="nav-link">
              <span>{t(locale, 'navClub')}</span>
              <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="nav-dropdown">
              <a href={l('/news/')} class="dropdown-link">{t(locale, 'navNews')}</a>
              <a href={l('/club/ueber-uns')} class="dropdown-link">{t(locale, 'navAbout')}</a>
              <a href={l('/club/vorstand')} class="dropdown-link">{t(locale, 'navBoard')}</a>
              <a href={l('/club/kontakt')} class="dropdown-link">{t(locale, 'navContact')}</a>
            </div>
          </div>

          <div class="nav-item">
            <button type="button" class="nav-link">
              <span>{t(locale, 'navVolleyball')}</span>
              <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="nav-dropdown">
              <a href={l('/volleyball/')} class="dropdown-link">{t(locale, 'navOverview')}</a>
              <div class="dropdown-divider"></div>
              <div class="dropdown-group">
                <button class="dropdown-group-toggle" aria-expanded="false">
                  <span>{t(locale, 'navWomen')}</span>
                  <svg class="dropdown-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="dropdown-group-items">
                  {vbWomen.map((tm) => (
                    <a href={l(`/volleyball/${tm.slug}`)} class="dropdown-link">{tm.displayName} — {getBadgeText(tm.league, tm.chipLabel)}</a>
                  ))}
                </div>
              </div>
              <div class="dropdown-group">
                <button class="dropdown-group-toggle" aria-expanded="false">
                  <span>{t(locale, 'navMen')}</span>
                  <svg class="dropdown-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="dropdown-group-items">
                  {vbMen.map((tm) => (
                    <a href={l(`/volleyball/${tm.slug}`)} class="dropdown-link">{tm.displayName} — {getBadgeText(tm.league, tm.chipLabel)}</a>
                  ))}
                </div>
              </div>
              <div class="dropdown-group">
                <button class="dropdown-group-toggle" aria-expanded="false">
                  <span>{t(locale, 'navYouth')}</span>
                  <svg class="dropdown-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="dropdown-group-items">
                  {vbYouth.map((tm) => (
                    <a href={l(`/volleyball/${tm.slug}`)} class="dropdown-link">{tm.displayName}</a>
                  ))}
                </div>
              </div>
              <div class="dropdown-divider"></div>
              <a href={l(locale === 'de' ? '/volleyball/reglemente' : '/volleyball/regulations')} class="dropdown-link">{t(locale, 'navRegulations')}</a>
              <a href={l(locale === 'de' ? '/volleyball/spielplanung' : '/volleyball/scheduling')} class="dropdown-link">{t(locale, 'navScheduling')}</a>
            </div>
          </div>

          <div class="nav-item">
            <button type="button" class="nav-link">
              <span>{t(locale, 'navBasketball')}</span>
              <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="nav-dropdown">
              <a href={l('/basketball/')} class="dropdown-link">{t(locale, 'navOverview')}</a>
              <div class="dropdown-divider"></div>
              <div class="dropdown-group">
                <button class="dropdown-group-toggle" aria-expanded="false">
                  <span>{t(locale, 'navWomen')}</span>
                  <svg class="dropdown-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="dropdown-group-items">
                  <a href={l('/basketball/lions')} class="dropdown-link">Lions — 1. Liga</a>
                  <a href={l('/basketball/rhinos')} class="dropdown-link">Rhinos — 2. Liga</a>
                </div>
              </div>
              <div class="dropdown-group">
                <button class="dropdown-group-toggle" aria-expanded="false">
                  <span>{t(locale, 'navMen')}</span>
                  <svg class="dropdown-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="dropdown-group-items">
                  <a href={l('/basketball/h1')} class="dropdown-link">Herren 1 — 1. Liga</a>
                  <a href={l('/basketball/h3')} class="dropdown-link">Herren 3 — 3. Liga</a>
                  <a href={l('/basketball/h4')} class="dropdown-link">Herren 4 — 4. Liga</a>
                </div>
              </div>
              <div class="dropdown-group">
                <button class="dropdown-group-toggle" aria-expanded="false">
                  <span>{t(locale, 'navYouth')}</span>
                  <svg class="dropdown-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                <div class="dropdown-group-items">
                  <a href={l('/basketball/teams/nachwuchs')} class="dropdown-link">{t(locale, 'navAllYouthTeams')}</a>
                </div>
              </div>
              <a href={l(locale === 'de' ? '/basketball/spielplanung' : '/basketball/scheduling')} class="dropdown-link">{t(locale, 'navScheduling')}</a>
            </div>
          </div>

          <div class="nav-item">
            <button type="button" class="nav-link">
              <span>{t(locale, 'navMore')}</span>
              <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="nav-dropdown">
              <a href={l('/weiteres/kalender')} class="dropdown-link">{t(locale, 'navCalendar')}</a>
              <a href={l('/weiteres/mitgliedschaft')} class="dropdown-link">{t(locale, 'navMembership')}</a>
              <a href={l('/weiteres/schreiberkurse')} class="dropdown-link">{t(locale, 'navScorerCourses')}</a>
              <a href={l('/weiteres/logos')} class="dropdown-link">{t(locale, 'navLogos')}</a>
              <a href={l('/sponsoren/')} class="dropdown-link">{t(locale, 'navSponsors')}</a>
              <a href={l('/weiteres/partner')} class="dropdown-link">{t(locale, 'navPartner')}</a>
            </div>
          </div>
        <a href="https://wiedisync.kscw.ch" class="nav-link btn btn-gold btn-sm" target="_blank" rel="noopener"><i data-lucide="lock" style="width:14px;height:14px;"></i> Wiedisync</a>
        <div class="lang-toggle" role="radiogroup" aria-label="Language">
          <a href={locale === 'de' ? currentPath : dePath} class={`lang-btn ${locale === 'de' ? 'active' : ''}`} aria-label="Deutsch" data-lang-choice="de">DE</a>
          <span class="lang-sep">|</span>
          <a href={locale === 'en' ? currentPath : enPath} class={`lang-btn ${locale === 'en' ? 'active' : ''}`} aria-label="English" data-lang-choice="en">EN</a>
        </div>
        <a href="/admin" class="admin-link" aria-label={t(locale, 'navAdmin')} title={t(locale, 'navAdmin')}>
          <i data-lucide="lock" style="width:14px;height:14px;"></i>
        </a>
        </div>

        <button class="nav-hamburger" aria-label={t(locale, 'navOpenMenu')}>
          <div class="hamburger-icon">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </button>
      </nav>
    </div>

    <!-- Mobile Navigation -->
    <div class="mobile-nav">
      <div class="lang-toggle mobile-lang-toggle" role="radiogroup" aria-label="Language">
        <a href={locale === 'de' ? currentPath : dePath} class={`lang-btn-mobile ${locale === 'de' ? 'active' : ''}`} aria-label="Deutsch" data-lang-choice="de">DE</a>
        <span class="lang-sep">|</span>
        <a href={locale === 'en' ? currentPath : enPath} class={`lang-btn-mobile ${locale === 'en' ? 'active' : ''}`} aria-label="English" data-lang-choice="en">EN</a>
        <a href="/admin" class="admin-link admin-link--mobile" aria-label={t(locale, 'navAdmin')} title={t(locale, 'navAdmin')}>
          <i data-lucide="lock" style="width:14px;height:14px;"></i>
        </a>
      </div>

      <div class="mobile-nav-item">
        <button class="mobile-nav-link" aria-expanded="false">
          <span>{t(locale, 'navClub')}</span>
          <svg class="mobile-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="mobile-subnav">
          <a href={l('/news/')} class="mobile-sublink">{t(locale, 'navNews')}</a>
          <a href={l('/club/ueber-uns')} class="mobile-sublink">{t(locale, 'navAbout')}</a>
          <a href={l('/club/vorstand')} class="mobile-sublink">{t(locale, 'navBoard')}</a>
          <a href={l('/club/kontakt')} class="mobile-sublink">{t(locale, 'navContact')}</a>
        </div>
      </div>

      <div class="mobile-nav-item">
        <button class="mobile-nav-link" aria-expanded="false">
          <span>{t(locale, 'navVolleyball')}</span>
          <svg class="mobile-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="mobile-subnav">
          <a href={l('/volleyball/')} class="mobile-sublink">{t(locale, 'navOverview')}</a>
          <div class="dropdown-group">
            <button class="dropdown-group-toggle" aria-expanded="false">
              <span>{t(locale, 'navWomen')}</span>
              <svg class="dropdown-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="dropdown-group-items">
              {vbWomen.map((tm) => (
                <a href={l(`/volleyball/${tm.slug}`)} class="mobile-sublink">{tm.displayName} — {getBadgeText(tm.league, tm.chipLabel)}</a>
              ))}
            </div>
          </div>
          <div class="dropdown-group">
            <button class="dropdown-group-toggle" aria-expanded="false">
              <span>{t(locale, 'navMen')}</span>
              <svg class="dropdown-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="dropdown-group-items">
              {vbMen.map((tm) => (
                <a href={l(`/volleyball/${tm.slug}`)} class="mobile-sublink">{tm.displayName} — {getBadgeText(tm.league, tm.chipLabel)}</a>
              ))}
            </div>
          </div>
          <div class="dropdown-group">
            <button class="dropdown-group-toggle" aria-expanded="false">
              <span>{t(locale, 'navYouth')}</span>
              <svg class="dropdown-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="dropdown-group-items">
              {vbYouth.map((tm) => (
                <a href={l(`/volleyball/${tm.slug}`)} class="mobile-sublink">{tm.displayName}</a>
              ))}
            </div>
          </div>
          <a href={l(locale === 'de' ? '/volleyball/reglemente' : '/volleyball/regulations')} class="mobile-sublink">{t(locale, 'navRegulations')}</a>
          <a href={l(locale === 'de' ? '/volleyball/spielplanung' : '/volleyball/scheduling')} class="mobile-sublink">{t(locale, 'navScheduling')}</a>
        </div>
      </div>

      <div class="mobile-nav-item">
        <button class="mobile-nav-link" aria-expanded="false">
          <span>{t(locale, 'navBasketball')}</span>
          <svg class="mobile-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="mobile-subnav">
          <a href={l('/basketball/')} class="mobile-sublink">{t(locale, 'navOverview')}</a>
          <div class="dropdown-group">
            <button class="dropdown-group-toggle" aria-expanded="false">
              <span>{t(locale, 'navWomen')}</span>
              <svg class="dropdown-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="dropdown-group-items">
              <a href={l('/basketball/lions')} class="mobile-sublink">Lions — 1. Liga</a>
              <a href={l('/basketball/rhinos')} class="mobile-sublink">Rhinos — 2. Liga</a>
            </div>
          </div>
          <div class="dropdown-group">
            <button class="dropdown-group-toggle" aria-expanded="false">
              <span>{t(locale, 'navMen')}</span>
              <svg class="dropdown-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="dropdown-group-items">
              <a href={l('/basketball/h1')} class="mobile-sublink">Herren 1 — 1. Liga</a>
              <a href={l('/basketball/h3')} class="mobile-sublink">Herren 3 — 3. Liga</a>
              <a href={l('/basketball/h4')} class="mobile-sublink">Herren 4 — 4. Liga</a>
            </div>
          </div>
          <div class="dropdown-group">
            <button class="dropdown-group-toggle" aria-expanded="false">
              <span>{t(locale, 'navYouth')}</span>
              <svg class="dropdown-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="dropdown-group-items">
              <a href={l('/basketball/teams/nachwuchs')} class="mobile-sublink">{t(locale, 'navAllYouthTeams')}</a>
            </div>
          </div>
          <a href={l(locale === 'de' ? '/basketball/spielplanung' : '/basketball/scheduling')} class="mobile-sublink">{t(locale, 'navScheduling')}</a>
        </div>
      </div>

      <div class="mobile-nav-item">
        <button class="mobile-nav-link" aria-expanded="false">
          <span>{t(locale, 'navMore')}</span>
          <svg class="mobile-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="mobile-subnav">
          <a href={l('/weiteres/kalender')} class="mobile-sublink">{t(locale, 'navCalendar')}</a>
          <a href={l('/weiteres/mitgliedschaft')} class="mobile-sublink">{t(locale, 'navMembership')}</a>
          <a href={l('/weiteres/schreiberkurse')} class="mobile-sublink">{t(locale, 'navScorerCourses')}</a>
          <a href={l('/weiteres/logos')} class="mobile-sublink">{t(locale, 'navLogos')}</a>
          <a href={l('/sponsoren/')} class="mobile-sublink">{t(locale, 'navSponsors')}</a>
          <a href={l('/weiteres/partner')} class="mobile-sublink">{t(locale, 'navPartner')}</a>
        </div>
      </div>
        <div class="mobile-nav-item" style="border-bottom: none; padding-top: 1rem;">
          <a href="https://wiedisync.kscw.ch" class="btn btn-gold w-full" target="_blank" rel="noopener" style="justify-content: center;">{t(locale, 'navLogin')}</a>
        </div>
    </div>
  </header>

  <script is:inline>
    // Persist the user's language choice so root visits to kscw.ch
    // honor it on subsequent loads (see src/pages/index.astro).
    document.querySelectorAll('[data-lang-choice]').forEach(function(el) {
      el.addEventListener('click', function() {
        try { localStorage.setItem('kscw-locale', el.dataset.langChoice); } catch (e) {}
      });
    });
  </script>
