---
import type { TeamData } from '../data/teams';
import { formatTrainings, getBadgeText } from '../data/teams';

interface Props {
  team: TeamData;
  locale: 'de' | 'en';
  /** Base path for sport links, e.g., "/volleyball" */
  basePath: string;
  /** i18n "more" label, e.g., "Mehr erfahren" (the → arrow is added here). */
  moreText: string;
  /** i18n key for the "more" label — enables client-side language swap. */
  moreTextKey?: string;
}

const { team, locale, basePath, moreText, moreTextKey } = Astro.props;

const href = team.linkOverride
  ? `${basePath}/${team.linkOverride}`
  : `${basePath}/${team.slug}`;

const hasPhoto = !!team.photoUrl;
const badgeText = getBadgeText(team.league, team.chipLabel);
// Render both languages and let CSS (data-lang-only) show the active one, so
// the German day abbreviations swap to English with the toggle (single-URL site).
const trainingTextDe = formatTrainings(team.trainings, 'de');
const trainingTextEn = formatTrainings(team.trainings, 'en');

const cardClass = hasPhoto
  ? 'card team-card team-card--photo tilt-3d'
  : 'card team-card card-accent tilt-3d';

const cardStyle = hasPhoto ? undefined : `--card-accent: ${team.chipBg};`;
const altText = locale === 'de' ? 'Teamfoto' : 'Team photo';
---
<a href={href} class={cardClass} style={cardStyle}>
  {hasPhoto && (
    <div class="team-card-bg">
      <img
        src={team.photoUrl!}
        alt={altText}
        data-i18n-alt="teamPhotoAlt"
        loading="lazy"
      />
    </div>
  )}
  <div class="card-body">
    <div class="team-card-header">
      <span class="chip" style={`background: ${team.chipBg}; color: ${team.chipText};`}>
        {team.chipLabel}
      </span>
      <h3>{team.displayName}</h3>
    </div>
    {badgeText && <span class="badge badge-blue">{badgeText}</span>}
    {trainingTextDe && <p class="team-card-meta mt-sm"><span data-lang-only="de">{trainingTextDe}</span><span data-lang-only="en">{trainingTextEn}</span></p>}
    <p class="team-card-meta mt-md" style="color: var(--kscw-blue); font-weight: 600;"><span data-i18n={moreTextKey}>{moreText}</span> &rarr;</p>
  </div>
</a>
