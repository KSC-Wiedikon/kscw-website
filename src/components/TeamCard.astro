---
import type { TeamData } from '../data/teams';
import { formatTrainings, getBadgeText } from '../data/teams';
import { youthAge } from '../lib/birthYears';
import BirthYears from './BirthYears.astro';
import { t } from '../lib/i18n';

interface Props {
  team: TeamData;
  locale: 'de' | 'en';
  /** Base path for sport links, e.g., "/volleyball" */
  basePath: string;
  /** i18n "more" label, e.g., "Mehr erfahren" (the → arrow is added here). */
  moreText: string;
  /** i18n key for the "more" label — enables client-side language swap. */
  moreTextKey?: string;
  /** Show the eligible-Jahrgänge line. Opt-in per page rather than derived from
   *  `team.category === 'youth'`, because basketball's youth cards here are
   *  teasers that link into /basketball/teams/nachwuchs — and that page can widen
   *  a card's range when the club runs no team one step down (see groupSpanTo()),
   *  which this component has no roster to work out. Two different ranges for the
   *  same team, one link apart, is worse than stating it in one place. */
  showBirthYears?: boolean;
}

const { team, locale, basePath, moreText, moreTextKey, showBirthYears } = Astro.props;

const birthYearsAge = showBirthYears ? youthAge(team.teamName ?? team.chipLabel) : null;

const href = team.linkOverride
  ? `${basePath}/${team.linkOverride}`
  : `${basePath}/${team.slug}`;

const hasPhoto = !!team.photoUrl;
const badgeText = getBadgeText(team.league, team.chipLabel);
// Render both languages and let CSS (data-lang-only) show the active one, so
// the German day abbreviations swap to English with the toggle (single-URL site).
const trainingTextDe = formatTrainings(team.trainings, 'de');
const trainingTextEn = formatTrainings(team.trainings, 'en');

const cardClass = hasPhoto
  ? 'card team-card team-card--photo tilt-3d'
  : 'card team-card card-accent tilt-3d';

const cardStyle = hasPhoto ? undefined : `--card-accent: ${team.chipBg};`;
// Was an inline de/en ternary, which meant the dictionary's own teamPhotoAlt — the
// value the client-side swap and the admin's text editor both act on — could drift
// away from what the build actually renders.
const altText = t(locale, 'teamPhotoAlt');
---
<a href={href} class={cardClass} style={cardStyle}>
  {hasPhoto && (
    <div class="team-card-bg">
      <img
        src={team.photoUrl!}
        alt={altText}
        data-i18n-alt="teamPhotoAlt"
        loading="lazy"
      />
    </div>
  )}
  <div class="card-body">
    <div class="team-card-header">
      <span class="chip" style={`background: ${team.chipBg}; color: ${team.chipText};`}>
        {team.chipLabel}
      </span>
      <h3>{team.displayName}</h3>
    </div>
    {badgeText && <span class="badge badge-blue">{badgeText}</span>}
    {birthYearsAge !== null && (
      <p class="team-card-meta mt-sm">
        <BirthYears sport={team.sport} age={birthYearsAge} />
      </p>
    )}
    {trainingTextDe && <p class="team-card-meta mt-sm"><span data-lang-only="de">{trainingTextDe}</span><span data-lang-only="en">{trainingTextEn}</span></p>}
    <p class="team-card-meta mt-md" style="color: var(--accent-text); font-weight: 600;"><span data-i18n={moreTextKey}>{moreText}</span> &rarr;</p>
  </div>
</a>
