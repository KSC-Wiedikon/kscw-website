---
// Renders the training + coach lines for one basketball youth card, sourced
// from Directus (coach M2M + hall_slots). Lists every weekly slot as weekday +
// time (hall name intentionally not shown). Weekday names carry a data-i18n key
// so the client language toggle localises them; times and coach names are
// language-neutral.
//
// Each slot carries its own end date as data-valid-until; public/js/youth-status.js
// prunes the line once that day passes, because nothing rebuilds the site on a
// date alone (the Directus auto-rebuild Flow only fires on content edits).
import { DEFAULT_WAITLIST_URL, type YouthTeamInfo } from '../lib/fetch/youthBasketball'
import { youthAge } from '../lib/birthYears'
import BirthYears from './BirthYears.astro'
// This component has no locale prop — like every page it renders the German build
// output, and the data-i18n keys let the client swap to English. The labels come
// from the dictionary rather than being written twice, so an admin edit reaches the
// build output too instead of only the browser.
import { t } from '../lib/i18n'

interface Props {
  code: string
  /** null when Directus was unreachable — renders the bare fallback card. */
  team: YouthTeamInfo | null
  /** Lowest age group this card's Jahrgänge cover — see groupSpanTo(). */
  spanTo?: number | null
}

const { code, team, spanTo } = Astro.props
const info: YouthTeamInfo = team ?? { coaches: [], slots: [] }

// Eligible Jahrgänge, read off the card's own age-group code. Every card here is
// a [DHM]U<n> group, so this is only null if a non-group code ever reached it.
const age = youthAge(code)

// Full team → show the club-wide waiting-list button.
//
// `open_for_players` is the SINGLE authority for open/full. teams.waitlist_url
// used to be both the link AND the "team is full" flag, and the flag won — so a
// coach who opened DU12 in wiedisync was silently overruled by a leftover URL on
// the row (found 2026-08-18: every team's URL turned out to be the same
// club-wide form anyway, so the column carried no information at all).
//
// `=== false` is deliberate: openForPlayers stays undefined when the status
// fetch failed, and an unknown status must not flip every card to "full".
//
// The href is now a compile-time constant instead of coach-written varchar(500),
// so the URL guard that audit 2026-08-08 finding 16 added here is gone together
// with the sink it protected — no Directus text reaches this attribute.
const isFull = info.openForPlayers === false

// Not full + actively recruiting → green "Open for players" badge plus a link
// into the contact form, prefilled to this exact team (sport + teamId). The
// /kscw/contact backend routes youth-team submissions to the youth contact.
const openForPlayers = info.openForPlayers === true
const contactHref = `/club/kontakt?sport=basketball${info.teamId ? `&teamId=${encodeURIComponent(info.teamId)}` : ''}`

// Female youth teams (D-codes: DU18/DU16/…) get the feminine German badge
// "Offen für neue Spielerinnen"; male (H) and mixed (M) keep "…Spieler". English
// is gender-neutral, so bbTeamOpenF resolves to the same "Open for players".
const openIsFemale = code.toUpperCase().startsWith('D')
const openKey = openIsFemale ? 'bbTeamOpenF' : 'bbTeamOpen'
const openText = openIsFemale ? 'Offen für neue Spielerinnen' : 'Offen für neue Spieler'

// Mixed teams (MU8/MU10) recruit girls and boys separately (teams.open_for_girls
// / open_for_boys, toggled per team in wiedisync). Taking only one of the two
// splits the card in half: the open side keeps the green badge + contact link,
// the other gets the gold "full" badge + waiting list.
//
// Only a one-sided choice splits it. Both flags on — or a coach who never
// touched the toggles, leaving both off — keeps the single generic row, so the
// card looks exactly as it does today until someone opts into the split.
const isMixed = code.toUpperCase().startsWith('M')
const openForGirls = info.openForGirls === true
const openForBoys = info.openForBoys === true
const splitByGender = isMixed && openForPlayers && openForGirls !== openForBoys

const openBadge = splitByGender
  ? openForGirls
    ? { key: 'bbTeamOpenGirls', text: 'Offen für neue Spielerinnen' }
    : { key: 'bbTeamOpenBoys', text: 'Offen für neue Spieler' }
  : { key: openKey, text: openText }

// The half the team is NOT taking. Always the club-wide waiting list: a team
// with a waitlist_url of its own never reaches here, since that already makes
// the whole card "full" (see openForPlayers above).
const closedBadge = splitByGender
  ? openForGirls
    ? { key: 'bbTeamFullBoys', text: 'Knaben: Team voll' }
    : { key: 'bbTeamFullGirls', text: 'Mädchen: Team voll' }
  : null

// 0 = Monday … 6 = Sunday (Directus hall_slots convention). Page builds in DE;
// the client toggle swaps these via weekdayLong<n> keys.
const DE_DAYS = ['Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag', 'Sonntag']
---
<div class="youth-meta" data-team-code={code} data-team-name={info.name}>
  {age !== null && <BirthYears sport="basketball" age={age} spanTo={spanTo} team={info.name} />}
  {info.slots.length > 0 && (
    <>
      <span class="youth-meta-label"><strong data-i18n="bbTrainingLabel">{t('de', 'bbTrainingLabel')}</strong></span>
      {info.slots.map(s => (
        <span class="youth-slot" data-valid-until={s.validUntil}>
          <span data-i18n={`weekdayLong${s.day}`}>{DE_DAYS[s.day] ?? ''}</span>{` ${s.start}–${s.end}`}
        </span>
      ))}
    </>
  )}
  {info.coaches.length > 0 && (
    <span><strong data-i18n="bbCoachLabel">{t('de', 'bbCoachLabel')}</strong> {info.coaches.join(', ')}</span>
  )}
  {isFull && (
    <div class="youth-waitlist">
      <span class="youth-full-badge" data-i18n="bbTeamFull">{t('de', 'bbTeamFull')}</span>
      <a
        class="btn btn-outline btn-sm youth-waitlist-btn"
        href={DEFAULT_WAITLIST_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-i18n="bbWaitlistLabel">{t('de', 'bbWaitlistLabel')}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  )}
  {openForPlayers && (
    <div class="youth-open">
      <span class="youth-open-badge" data-i18n={openBadge.key}>{openBadge.text}</span>
      <a class="btn btn-outline btn-sm youth-open-btn" href={contactHref}>
        <span data-i18n="bbTeamOpenCta">{t('de', 'bbTeamOpenCta')}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  )}
  {closedBadge && (
    <div class="youth-waitlist">
      <span class="youth-full-badge" data-i18n={closedBadge.key}>{closedBadge.text}</span>
      <a
        class="btn btn-outline btn-sm youth-waitlist-btn"
        href={DEFAULT_WAITLIST_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-i18n="bbWaitlistLabel">{t('de', 'bbWaitlistLabel')}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  )}
</div>

<style>
  .youth-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-md);
    font-size: var(--text-sm);
  }
  /* Direct-child only: styles the training/coach lines. Must NOT reach the
     nested badge/button spans inside .youth-open / .youth-waitlist — those are
     styled by the global rules below, and a descendant `span` selector here
     (scoped to a high-specificity `[cid] span[cid]`) would otherwise override
     their colour/display on the build-rendered fallback rows. */
  .youth-meta > span {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--text-secondary);
  }
  .youth-meta strong { color: var(--text-primary); }
  .youth-slot { padding-left: var(--space-md); }

</style>

<!-- Status-row styles are GLOBAL (unscoped) on purpose: the rows are rendered
     identically whether the build emits them OR public/js/youth-status.js injects
     them live in the browser. Astro scopes component <style> via a per-element
     `data-astro-cid-*` attribute that dynamically-created nodes can't carry, so
     scoped rules would leave JS-injected badges unstyled. Selectors stay under
     `.youth-meta` to keep specificity (and to win over the generic
     `.youth-meta span` colour/display rule above). -->
<style is:global>
  /* The Jahrgänge line is rendered by BirthYears.astro, so it carries THAT
     component's scope — the `.youth-meta > span` colour rule above cannot reach
     it, and it would otherwise sit on the card in the default body colour while
     the training and coach lines next to it are muted. Its layout lives in
     global.css; only the colour is set here, because the same line also renders on
     the blue team hero, where it has to inherit white instead. */
  .youth-meta .birth-years { color: var(--text-secondary); }
  .youth-meta .birth-years strong { color: var(--text-primary); }

  .youth-meta .youth-waitlist {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
    /* Matches the gold "Team voll" chip next to it. The brand gold only clears
       contrast on the dark surface (11:1 on --bg-light #1a2234); on the light
       theme it drops to ~1.6:1, so that one darkens to an amber that still
       reads as the same accent at 4.6:1. */
    --waitlist-accent: var(--kscw-gold);
  }
  .light .youth-meta .youth-waitlist { --waitlist-accent: #8a6a00; }
  .youth-meta .youth-full-badge {
    display: inline-flex;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--kscw-gold);
    color: var(--text-on-gold);
  }
  .youth-meta .youth-waitlist-btn {
    color: var(--waitlist-accent);
    text-transform: none;
    letter-spacing: 0;
    min-height: 0;
  }
  .youth-meta .youth-waitlist-btn span {
    display: inline;
    color: inherit;
  }

  /* Open-for-players row — green counterpart to the gold "Team voll" row. */
  .youth-meta .youth-open {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }
  .youth-meta .youth-open-badge {
    display: inline-flex;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--success);
    color: #ffffff;
  }
  .youth-meta .youth-open-btn {
    color: var(--success);
    text-transform: none;
    letter-spacing: 0;
    min-height: 0;
  }
  .youth-meta .youth-open-btn span {
    display: inline;
    color: inherit;
  }
</style>
