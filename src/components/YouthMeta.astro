---
// Renders the training + coach lines for one basketball youth card, sourced
// from Directus (coach M2M + hall_slots). Lists every weekly slot as weekday +
// time (hall name intentionally not shown). Weekday names carry a data-i18n key
// so the client language toggle localises them; times and coach names are
// language-neutral.
import type { YouthBasketball } from '../lib/fetch/youthBasketball'

interface Props {
  code: string
  data: YouthBasketball
}

const { code, data } = Astro.props
const info = data[code] ?? { coaches: [], slots: [] }

// Full team → show a waiting-list button. A custom label (from Directus) is
// rendered verbatim; an empty label falls back to the i18n "Warteliste" key so
// the client toggle can localise it. labelKey is undefined for custom labels,
// which Astro omits, leaving the literal text untouched by the language switch.
const waitlistUrl = info.waitlistUrl?.trim()
const customLabel = info.waitlistLabel?.trim()
const waitlistLabel = customLabel || 'Warteliste'
const waitlistLabelKey = customLabel ? undefined : 'bbWaitlistLabel'

// Not full + actively recruiting → green "Open for players" badge plus a link
// into the contact form, prefilled to this exact team (sport + teamId). The
// /kscw/contact backend routes youth-team submissions to the youth contact.
const openForPlayers = !waitlistUrl && info.openForPlayers === true
const contactHref = `/club/kontakt?sport=basketball${info.teamId ? `&teamId=${encodeURIComponent(info.teamId)}` : ''}`

// 0 = Monday … 6 = Sunday (Directus hall_slots convention). Page builds in DE;
// the client toggle swaps these via weekdayLong<n> keys.
const DE_DAYS = ['Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag', 'Sonntag']
---
<div class="youth-meta">
  {info.slots.length > 0 && (
    <>
      <span class="youth-meta-label"><strong data-i18n="bbTrainingLabel">Training:</strong></span>
      {info.slots.map(s => (
        <span class="youth-slot">
          <span data-i18n={`weekdayLong${s.day}`}>{DE_DAYS[s.day] ?? ''}</span>{` ${s.start}–${s.end}`}
        </span>
      ))}
    </>
  )}
  {info.coaches.length > 0 && (
    <span><strong data-i18n="bbCoachLabel">Coach:</strong> {info.coaches.join(', ')}</span>
  )}
  {waitlistUrl && (
    <div class="youth-waitlist">
      <span class="youth-full-badge" data-i18n="bbTeamFull">Team voll</span>
      <a
        class="btn btn-outline btn-sm youth-waitlist-btn"
        href={waitlistUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-i18n={waitlistLabelKey}>{waitlistLabel}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  )}
  {openForPlayers && (
    <div class="youth-open">
      <span class="youth-open-badge" data-i18n="bbTeamOpen">Offen für neue Spieler</span>
      <a class="btn btn-outline btn-sm youth-open-btn" href={contactHref}>
        <span data-i18n="bbTeamOpenCta">Kontakt aufnehmen</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  )}
</div>

<style>
  .youth-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-md);
    font-size: var(--text-sm);
  }
  .youth-meta span {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--text-secondary);
  }
  .youth-meta strong { color: var(--text-primary); }
  .youth-slot { padding-left: var(--space-md); }

  /* Full-team waiting-list row. Rules are scoped under .youth-meta so they
     win against the generic `.youth-meta span` colour/display above. */
  .youth-meta .youth-waitlist {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }
  .youth-meta .youth-full-badge {
    display: inline-flex;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--kscw-gold);
    color: var(--text-on-gold);
  }
  .youth-meta .youth-waitlist-btn {
    color: var(--kscw-blue);
    text-transform: none;
    letter-spacing: 0;
    min-height: 0;
  }
  .youth-meta .youth-waitlist-btn span {
    display: inline;
    color: inherit;
  }

  /* Open-for-players row — green counterpart to the gold "Team voll" row. */
  .youth-meta .youth-open {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }
  .youth-meta .youth-open-badge {
    display: inline-flex;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--success);
    color: #ffffff;
  }
  .youth-meta .youth-open-btn {
    color: var(--success);
    text-transform: none;
    letter-spacing: 0;
    min-height: 0;
  }
  .youth-meta .youth-open-btn span {
    display: inline;
    color: inherit;
  }
</style>
