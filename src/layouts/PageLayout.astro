---
import BaseLayout from './BaseLayout.astro';
import type { Locale } from '../lib/i18n';

interface Props {
  title: string;
  titleKey?: string;
  description?: string;
  descriptionKey?: string;
  locale?: Locale;
  pageTitle: string;
  /** i18n key for the H1 — enables client-side language swap. */
  pageTitleKey?: string;
  pageSubtitle?: string;
  /** i18n key for the subtitle — enables client-side language swap. */
  pageSubtitleKey?: string;
  /** Render a twinkling sparkles canvas behind the page-header. */
  sparklesHero?: boolean;
  /** Override default sparkle color (CSS rgba string, alpha must be 1). */
  sparkleColor?: string;
}

const {
  title,
  titleKey,
  description,
  descriptionKey,
  locale = 'de',
  pageTitle,
  pageTitleKey,
  pageSubtitle,
  pageSubtitleKey,
  sparklesHero = false,
  sparkleColor,
} = Astro.props;
---
<BaseLayout title={title} titleKey={titleKey} description={description} descriptionKey={descriptionKey} locale={locale}>
  <section class="page-header">
    {sparklesHero && (
      <canvas
        class="sparkles-canvas"
        data-color={sparkleColor ?? 'rgba(255, 220, 130, 1)'}
        aria-hidden="true"
      ></canvas>
    )}
    <div class="container">
      <h1 data-i18n={pageTitleKey}>{pageTitle}</h1>
      {pageSubtitle && <p class="page-subtitle" data-i18n={pageSubtitleKey}>{pageSubtitle}</p>}
    </div>
  </section>
  <slot />
</BaseLayout>
