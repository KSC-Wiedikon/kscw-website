  <script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js" integrity="sha384-utBUCeG4SYaCm4m7GQZYr8Hy8Fpy3V4KGjBZaf4WTKOcwhCYpt/0PfeEe3HNlwx8" crossorigin="anonymous"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/dompurify@3.2.4/dist/purify.min.js" integrity="sha384-eEu5CTj3qGvu9PdJuS+YlkNi7d2XxQROAFYOr59zgObtlcux1ae1Il3u7jvdCSWu" crossorigin="anonymous"></script>
  <script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js" integrity="sha384-weMABwrltA6jWR8DDe9Jp5blk+tZQh7ugpCsF3JwSA53WZM9/14PjS5LAJNHNjAI" crossorigin="anonymous"></script>
  <!-- Shared with the public registration form, so a federation is spelled the
       same whichever of the two produced the Acknowledgment form. -->
  <script is:inline src="/js/federations.js"></script>
  <script is:inline>
  (function() {
    'use strict';

    var DIRECTUS_URL = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')
      ? 'https://directus-dev.kscw.ch' : 'https://directus.kscw.ch';
    var AUTH_KEY = 'kscw_admin_auth';
    var TURNSTILE_SITE_KEY = '0x4AAAAAACoYmx3xiDfRbmv9';
    var app = document.getElementById('admin-app');
    var currentTab = 'news';
    var adminAccess = { isSuperuser: false, sections: [] };
    var SECTION_ORDER = ['news','events','registrations','sponsors','scorer_courses','mixed_turnier','site_text'];
    var _scorerCourses = null; // cached scorer_courses rows for the inline registrations view
    var _scorerSaveChains = {}; // per-signup save serialization (sub_key -> Promise)
    // Seitentexte: { groups, defaults: { de, en }, overrides: { key: { de, en } } }
    var _siteText = null;
    var _siteTextGroupId = null; // selected page ('' = every page at once)
    var _siteTextQuery = '';
    /**
     * The admin's single language choice. It selects the UI chrome (through
     * t() below) *and* the language you type content in — news titles are
     * stored as `title` (German) plus `title_en`, and this decides which of
     * the two the primary field edits.
     *
     * It was hardcoded 'en' until 2026-08-08, which had two consequences: a
     * German-speaking club volunteer got an English admin, and the 188 German
     * strings in the dictionary below were dead code that a parity test kept
     * alive. Now: a stored choice wins, else the browser's language, else
     * English — the same fallback order the public site uses.
     */
    var ADMIN_LANG_KEY = 'kscw_admin_lang';
    function readAdminLang() {
      try {
        var stored = localStorage.getItem(ADMIN_LANG_KEY);
        if (stored === 'de' || stored === 'en') return stored;
      } catch (e) { /* private mode — fall through to the browser's language */ }
      return (navigator.language || '').toLowerCase().indexOf('de') === 0 ? 'de' : 'en';
    }
    var adminLang = readAdminLang();
    var quillInstance = null;
    var turnstileWidgetId = null;
    var turnstileToken = '';

    // ── Directus auth token management ───────────────────────
    function storeAuth(result) {
      sessionStorage.setItem(AUTH_KEY, JSON.stringify({
        access_token: result.access_token,
        refresh_token: result.refresh_token,
        expires_at: Date.now() + result.expires,
      }));
    }
    function getAuth() {
      var raw = sessionStorage.getItem(AUTH_KEY);
      if (!raw) return null;
      try { return JSON.parse(raw); } catch(e) { return null; }
    }
    async function getValidToken() {
      var auth = getAuth();
      if (!auth) return null;
      if (auth.expires_at - Date.now() < 30000) {
        var res = await fetch(DIRECTUS_URL + '/auth/refresh', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ refresh_token: auth.refresh_token, mode: 'json' }),
        });
        if (!res.ok) { sessionStorage.removeItem(AUTH_KEY); return null; }
        var data = await res.json();
        storeAuth(data.data);
        return data.data.access_token;
      }
      return auth.access_token;
    }
    // Section data goes through the gated endpoint. /users/me,
    // items/teams, /files and /assets stay direct (see spec).
    async function wadmin(section, subpath, opts) {
      var token = await getValidToken();
      if (!token) { return Promise.reject(new Error('Not authenticated')); }
      var o = opts || {};
      var headers = Object.assign({}, o.headers || {}, { 'Authorization': 'Bearer ' + token });
      return fetch(DIRECTUS_URL + '/kscw/wadmin/' + section + '/' + subpath, Object.assign({}, o, { headers: headers }));
    }
    // Mutates module-scope adminAccess AND returns it; callers MUST await before reading adminAccess.
    // A transient /me failure must NOT downgrade an already-good access (server still
    // re-authorizes every data call); first load keeps the fail-closed empty default.
    function failClosedAccess() {
      if (!adminAccess.isSuperuser && adminAccess.sections.length === 0) return adminAccess;
      return adminAccess; // keep last-known-good on transient failure
    }
    async function loadAccess() {
      var token = await getValidToken();
      if (!token) { return failClosedAccess(); }
      try {
        var res = await fetch(DIRECTUS_URL + '/kscw/wadmin/me', {
          headers: { 'Authorization': 'Bearer ' + token },
        });
        if (!res.ok) { return failClosedAccess(); }
        var j = await res.json();
        adminAccess = {
          isSuperuser: !!j.isSuperuser,
          sections: Array.isArray(j.sections) ? j.sections : [],
        };
      } catch (e) {
        return failClosedAccess();
      }
      return adminAccess;
    }

    // ── URL ↔ tab state (deep-linkable /admin/?tab=…&course=…) ──
    function adminUrl(tab, params) {
      var qs = new URLSearchParams();
      if (tab) qs.set('tab', tab);
      if (params) Object.keys(params).forEach(function(k) {
        if (params[k] != null && params[k] !== '') qs.set(k, params[k]);
      });
      var s = qs.toString();
      return '/admin/' + (s ? '?' + s : '');
    }
    function pushAdminUrl(tab, params) {
      try { history.pushState({ tab: tab }, '', adminUrl(tab, params)); } catch (e) {}
    }
    function replaceAdminUrl(tab, params) {
      try { history.replaceState({ tab: tab }, '', adminUrl(tab, params)); } catch (e) {}
    }
    // Which sections this user may actually see (superuser sees all + the grid).
    function visibleTabs() {
      var v = SECTION_ORDER.filter(function(s) {
        return adminAccess.isSuperuser || adminAccess.sections.indexOf(s) !== -1;
      });
      return v;
    }
    // Resolve the requested tab against what the user is allowed to see.
    function resolveTab(tab) {
      var visible = visibleTabs();
      if (tab === 'admin' && adminAccess.isSuperuser) return 'admin';
      if (tab === 'teams' && adminAccess.isSuperuser) return 'teams';
      if (tab && visible.indexOf(tab) !== -1) return tab;
      return visible.length ? visible[0] : '';
    }
    // Back/forward navigation: re-sync the dashboard from the URL without a
    // full re-render (keeps scroll + avoids re-binding). loadItems() re-reads
    // the `course` param for the scorer tab, so course deep-links round-trip.
    function syncTabFromUrl() {
      if (!document.querySelector('.admin-shell')) return; // not on the dashboard
      var params = new URLSearchParams(location.search);
      currentTab = resolveTab(params.get('tab'));
      document.querySelectorAll('.admin-tab').forEach(function(el) {
        el.classList.toggle('active', el.getAttribute('data-tab') === currentTab);
      });
      syncFab();
      loadItems();
    }

