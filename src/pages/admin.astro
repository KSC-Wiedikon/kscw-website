---
import '../styles/global.css';
import { allTeamDefs } from '../data/teams';
import { volleyballTeams, basketballTeams } from '../data/team-routes';

/**
 * The two hand-maintained team tables, handed to the dashboard so the "Teams" tab
 * can show them against live Directus without anyone opening the source.
 *
 * They are the only part of this site nothing keeps in step with reality, and they
 * are read ONLY when a build cannot reach Directus — so a wrong row costs nothing
 * on a good day and is invisible on a bad one. DU23-2 was retired at the June 2026
 * rollover and sat in both tables until 18.08.2026, when a build that fell back
 * during a Directus restart rebuilt /volleyball/du23-2.
 */
const teamTable = {
  defs: allTeamDefs.map((d) => ({
    slug: d.slug, sport: d.sport, label: d.chipLabel, directusId: d.directusId,
    team_id: d.team_id ?? null, teamName: d.teamName ?? null,
    hasDetailPage: d.hasDetailPage,
  })),
  routes: [...volleyballTeams, ...basketballTeams].map((r) => ({
    slug: r.slug, sport: r.sport, directusId: r.directusId,
  })),
};
// Carried on a data- attribute rather than a <script> island, so no raw-HTML sink
// is needed at all: Astro escapes attribute values, and the allow-list guarded by
// tests/unit/no-i18n-html.test.ts stays at the two pages that genuinely cannot be
// expressed any other way. JSON.parse on the other side is the only decoding step.
const teamTableJson = JSON.stringify(teamTable);
