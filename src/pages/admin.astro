    // read goes through it and the bytes reach the browser as a blob.
    function scoresheetResponse(id) {
      return wadmin('scorer_courses', 'assets/' + encodeURIComponent(id), {});
    }

    // Anything opened or saved from the menu is a PDF, whatever the participant's phone
    // produced — the same conversion the SVRZ zip does, so what you read here is what
    // SVRZ receives. The STORED file is untouched: it is the evidence of what they
    // submitted, and rewriting it in place would be editing that.
    //
    // Returns { blob, ext } — ext so a download can be named honestly even in the
    // fallback below, rather than calling a JPEG .pdf.
    async function scoresheetAsPdf(id) {
      var res = await scoresheetResponse(id);
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var type = res.headers.get('content-type') || '';
      var bytes = new Uint8Array(await res.arrayBuffer());
      if (/pdf/i.test(type)) return { blob: new Blob([bytes], { type: 'application/pdf' }), ext: '.pdf' };
      try {
        return { blob: new Blob([await imageBytesToPdf(bytes, type)], { type: 'application/pdf' }), ext: '.pdf' };
      } catch (e) {
        // Undecodable — a legacy HEIC from before the upload rules, say. Hand back the
        // original: seeing the sheet in the wrong format beats not seeing it at all.
        var ext = /png/i.test(type) ? '.png' : (/jpe?g/i.test(type) ? '.jpg'
          : (/avif/i.test(type) ? '.avif' : (/heic|heif/i.test(type) ? '.heic' : '')));
