        + '<font><b/><sz val="12"/><color theme="1"/><name val="Open Sans"/><family val="2"/></font>'
        + '<font><sz val="11"/><color theme="1"/><name val="Open Sans Light"/><family val="2"/></font>'
        + '<font><b/><sz val="24"/><color theme="1"/><name val="Open Sans"/><family val="2"/></font>'
        + '<font><i/><sz val="9"/><color theme="1"/><name val="Open Sans"/><family val="2"/></font>'
        + '</fonts>'
        + '<fills count="4">'
        + '<fill><patternFill patternType="none"/></fill>'
        + '<fill><patternFill patternType="gray125"/></fill>'
        + '<fill><patternFill patternType="solid"><fgColor rgb="FFB6B6B6"/><bgColor indexed="64"/></patternFill></fill>'
        + '<fill><patternFill patternType="solid"><fgColor rgb="FFF2F2F2"/><bgColor indexed="64"/></patternFill></fill>'
        + '</fills>'
