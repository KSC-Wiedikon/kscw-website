        }[item.bb_situation] || '—') + '</div></div>' : '') +

        (item.id_upload_front ? '<div class="admin-field"><label>ID front</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.id_upload_front) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +
        (item.id_upload_back ? '<div class="admin-field"><label>ID back</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.id_upload_back) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +
        (item.bb_doc_lizenz ? '<div class="admin-field"><label>License application (PDF)</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.bb_doc_lizenz) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +
        (item.bb_doc_freibrief ? '<div class="admin-field"><label>Release letter / Freibrief (PDF)</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.bb_doc_freibrief) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +
        (item.bb_doc_selfdecl ? '<div class="admin-field"><label>Self Declaration (PDF)</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.bb_doc_selfdecl) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +
        (item.bb_doc_natdecl ? '<div class="admin-field"><label>National Team Decl. (PDF)</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.bb_doc_natdecl) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +
        (item.bb_doc_u18parents ? '<div class="admin-field"><label>Parental consent U18 (PDF)</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.bb_doc_u18parents) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +
        (item.bb_doc_schoolcert ? '<div class="admin-field"><label>School certificate (PDF)</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.bb_doc_schoolcert) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +

        // Flag a basketball registration missing any document its licensing
        // situation requires (Freibrief for a Swiss-club transfer, the FIBA
        // documents for foreign/minor players, …). Mirrors bbRequiredDocs() in
        // the backend (wiedisync bb-docs.js) — keep the two in sync. School
        // certificate stays optional and is never flagged.
        ((function () {
          if (item.membership_type !== 'basketball') return '';
          var nat = (item.nationalitaet_code || '').toUpperCase();
          var foreign = nat && nat !== 'CH';
          var sit = item.bb_situation;
          var SITS = ['neu', 'transfer_ch', 'transfer_intl', 'rueckkehr'];
          var minor = false;
          var mm = (item.geburtsdatum || '').substring(0, 10).match(/^(\d{4})-(\d{2})-(\d{2})$/);
          if (mm) {
            var now = new Date();
            var ssy = (now.getUTCMonth() + 1) >= 7 ? now.getUTCFullYear() : now.getUTCFullYear() - 1;
            var age = ssy - (+mm[1]);
            if (9 < (+mm[2]) || (9 === (+mm[2]) && 1 < (+mm[3]))) age--;
            minor = age < 18;
          }
          var req = ['id_upload_front', 'id_upload_back', 'bb_doc_lizenz'];
          if (SITS.indexOf(sit) === -1) { if (foreign) req.push('bb_doc_selfdecl', 'bb_doc_natdecl'); }
          else if (sit === 'transfer_ch') { req.push('bb_doc_freibrief'); }
          else if (sit === 'transfer_intl' || sit === 'rueckkehr') { req.push('bb_doc_selfdecl'); if (minor) req.push('bb_doc_natdecl', 'bb_doc_u18parents'); }
          else { if (foreign) req.push('bb_doc_selfdecl'); if (foreign && minor) req.push('bb_doc_natdecl'); }
          var missing = req.filter(function (k) { return !item[k]; });
          if (!missing.length) return '';
          return '<div class="admin-field" style="grid-column:1/-1"><span style="color:#dc2626;font-weight:700">⚠ Missing required documents for this licence situation: ' + missing.join(', ') + '</span></div>';
        })()) +

        '<div class="admin-modal-footer">' +
        '<button type="button" class="admin-btn" id="modal-cancel">' + t('cancel') + '</button>' +

        ((item.id_upload_front || item.id_upload_back) ?
          '<button type="button" id="reg-download-files" class="admin-btn admin-btn-sm">' + t('registrationsDownloadFiles') + '</button>' : '') +

        (item.membership_type === 'basketball' ?
          '<button type="button" id="reg-gen-pdf" class="admin-btn admin-btn-sm">' + t('registrationsGeneratePDF') + '</button>' +
          '<button type="button" id="reg-gen-fiba" class="admin-btn admin-btn-sm">' + t('registrationsGenerateFIBA') + '</button>' : '') +

        (item.status === 'pending' ?
          '<button type="button" id="reg-reject" class="admin-btn admin-btn-danger">' + t('registrationsReject') + '</button>' +
          '<button type="button" id="reg-approve" class="admin-btn admin-btn-primary">' + t('registrationsApprove') + '</button>' : '') +

        '<button type="submit" class="admin-btn admin-btn-primary" id="modal-save">' + t('save') + '</button>' +
        '</div></form></div>';

      modal.innerHTML = html;
      modal.style.display = 'flex';

      document.getElementById('modal-close').addEventListener('click', closeModal);
      document.getElementById('modal-cancel').addEventListener('click', closeModal);
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
      });

      document.getElementById('modal-form').addEventListener('submit', function(e) {
        e.preventDefault();
        saveRegistration(item.id);
      });

      var approveBtn = document.getElementById('reg-approve');
      if (approveBtn) {
        approveBtn.addEventListener('click', function() {
          updateRegistrationStatus(item.id, 'approved');
        });
      }

      var rejectBtn = document.getElementById('reg-reject');
      if (rejectBtn) {
        rejectBtn.addEventListener('click', function() {
          if (confirm(t('registrationsConfirmReject'))) {
            updateRegistrationStatus(item.id, 'rejected');
          }
        });
      }

      var dlBtn = document.getElementById('reg-download-files');
      if (dlBtn) {
        dlBtn.addEventListener('click', function() {
          downloadRegistrationFiles(item);
        });
      }

      var pdfBtn = document.getElementById('reg-gen-pdf');
      if (pdfBtn) {
        pdfBtn.addEventListener('click', function() {
          generateLizenzantrag(item);
        });
      }
      var fibaBtn = document.getElementById('reg-gen-fiba');
      if (fibaBtn) {
        fibaBtn.addEventListener('click', function() {
          generateFIBAPDFs(item);
        });
      }
    }

    async function saveRegistration(id) {
      var saveBtn = document.getElementById('modal-save');
      saveBtn.disabled = true;
      saveBtn.textContent = t('saving');

      var payload = {
        vorname: document.getElementById('f-reg-vorname').value.trim(),
        nachname: document.getElementById('f-reg-nachname').value.trim(),
        email: document.getElementById('f-reg-email').value.trim(),
        telefon_mobil: document.getElementById('f-reg-telefon').value.trim(),
        adresse: document.getElementById('f-reg-adresse').value.trim(),
        plz: document.getElementById('f-reg-plz').value.trim(),
        ort: document.getElementById('f-reg-ort').value.trim(),
        geburtsdatum: document.getElementById('f-reg-dob').value.trim(),
        nationalitaet: document.getElementById('f-reg-nation').value.trim(),
        geschlecht: document.getElementById('f-reg-gender').value.trim(),
        team: document.getElementById('f-reg-team').value.trim(),
        beitragskategorie: document.getElementById('f-reg-fee').value.trim(),
        ahv_nummer: document.getElementById('f-reg-ahv').value.trim(),
        kantonsschule: document.getElementById('f-reg-ks').value.trim(),
        rolle: document.getElementById('f-reg-rolle').value.trim(),
        lizenz: document.getElementById('f-reg-lizenz').value.trim(),
        schiedsrichter_stufe: document.getElementById('f-reg-refstufe').value.trim(),
        bemerkungen: document.getElementById('f-reg-bemerkungen').value.trim(),
      };

      try {
        var res = await wadmin('registrations', 'items/registrations/' + id, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        closeModal();
        loadItems();
      } catch(err) {
        alert(t('saveError') + err.message);
        saveBtn.disabled = false;
        saveBtn.textContent = t('save');
      }
    }

    async function updateRegistrationStatus(id, status) {
      try {
        var token = await getValidToken();
        var payload = { status: status };
        if (status === 'approved') {
          payload.approved_at = new Date().toISOString();
          var userRes = await fetch(DIRECTUS_URL + '/users/me?fields=first_name,last_name', {
            headers: { 'Authorization': 'Bearer ' + token },
          });
          var user = (await userRes.json()).data;
          payload.approved_by = user.first_name + ' ' + user.last_name;
        }

        var res = await wadmin('registrations', 'items/registrations/' + id, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);

        if (status === 'rejected') {
          var itemRes = await wadmin('registrations', 'items/registrations/' + id, {});
          var itemData = (await itemRes.json()).data;

          if (itemData.id_upload_front) {
            await fetch(DIRECTUS_URL + '/files/' + itemData.id_upload_front, {
              method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token },
            });
          }
          if (itemData.id_upload_back) {
            await fetch(DIRECTUS_URL + '/files/' + itemData.id_upload_back, {
              method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token },
            });
          }

          await wadmin('registrations', 'items/registrations/' + id, { method: 'DELETE' });
        }

        closeModal();
        loadItems();
      } catch(err) {
        alert(t('saveError') + err.message);
      }
    }

    async function downloadRegistrationFiles(item) {
      try {
        var token = await getValidToken();
        var files = [];
        if (item.id_upload_front) files.push({ id: item.id_upload_front, name: 'ID_front' });
        if (item.id_upload_back) files.push({ id: item.id_upload_back, name: 'ID_back' });

        for (var i = 0; i < files.length; i++) {
          var res = await fetch(DIRECTUS_URL + '/assets/' + files[i].id, {
            headers: { 'Authorization': 'Bearer ' + token },
          });
          var blob = await res.blob();
          var url = URL.createObjectURL(blob);
          var a = document.createElement('a');
          a.href = url;
          a.download = item.nachname + '_' + item.vorname + '_' + files[i].name;
          a.click();
          URL.revokeObjectURL(url);

          await fetch(DIRECTUS_URL + '/files/' + files[i].id, {
            method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token },
          });
        }

        await wadmin('registrations', 'items/registrations/' + item.id, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id_upload_front: null, id_upload_back: null }),
        });

        closeModal();
        loadItems();
      } catch(err) {
        alert(t('saveError') + (err.message || err));
      }
    }

