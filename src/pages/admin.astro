          info.appendChild(thumb);
        } else {
          var placeholder = document.createElement('div');
          placeholder.style.cssText = 'width:40px;height:40px;border-radius:var(--radius-sm);background:rgba(255,255,255,0.06);flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:10px;';
          placeholder.textContent = '—';
          info.appendChild(placeholder);
        }

        var textCol = document.createElement('div');
        var h3 = document.createElement('h3');
        h3.className = 'admin-list-title';
        h3.textContent = sp.name;
        textCol.appendChild(h3);

        var meta = document.createElement('div');
        meta.className = 'admin-list-meta';

        var orderBadge = document.createElement('span');
        orderBadge.className = 'admin-badge';
        orderBadge.textContent = '#' + (sp.sort_order || 0);
        meta.appendChild(orderBadge);

        var activeBadge = document.createElement('span');
        activeBadge.className = sp.active ? 'admin-badge admin-badge-green' : 'admin-badge admin-badge-gray';
        activeBadge.textContent = sp.active ? t('sponsorActive_badge') : t('sponsorInactive_badge');
        meta.appendChild(activeBadge);

        if (sp.team_page_only) {
          var tpoBadge = document.createElement('span');
          tpoBadge.className = 'admin-badge admin-badge-gray';
          tpoBadge.textContent = t('sponsorTeamPageOnly');
          meta.appendChild(tpoBadge);
        }

        if (sp.website_url) {
          var urlSpan = document.createElement('span');
          urlSpan.style.cssText = 'color:var(--text-muted);font-size:var(--text-xs);';
          urlSpan.textContent = sp.website_url.replace(/^https?:\/\//, '').replace(/\/$/, '');
          meta.appendChild(urlSpan);
        }

        textCol.appendChild(meta);
        info.appendChild(textCol);
        row.appendChild(info);

        // Actions
        var actions = document.createElement('div');
        actions.className = 'admin-list-actions';

        var editBtn = document.createElement('button');
        editBtn.className = 'admin-btn admin-btn-sm';
        editBtn.textContent = t('edit');
        editBtn.addEventListener('click', function() {
          openModal(sp);
        });
        actions.appendChild(editBtn);

        var deleteBtn = document.createElement('button');
        deleteBtn.className = 'admin-btn admin-btn-sm admin-btn-danger';
        deleteBtn.textContent = t('delete');
        deleteBtn.addEventListener('click', function() {
          confirmModal(t('sponsorConfirmDelete'), { danger: true, confirmLabel: t('delete') }).then(function(ok) {
            if (!ok) return;
            wadmin('sponsors', 'items/sponsors/' + sp.id, { method: 'DELETE' })
              .then(function(res) {
                if (!res.ok) throw new Error('HTTP ' + res.status);
                loadItems();
              }).catch(function(err) { alert(t('deleteError') + err.message); });
          });
        });
        actions.appendChild(deleteBtn);

        row.appendChild(actions);
        list.appendChild(row);
      });

      content.appendChild(list);
    }

    function renderScorerCoursesList(items) {
      var content = document.getElementById('admin-content');
      if (!content) return;
      content.textContent = '';
      var fab = document.getElementById('fab-btn');
      if (fab) fab.style.display = ''; // course creation available on the list view

      if (!items.length) {
        var emptyDiv = document.createElement('div');
        emptyDiv.className = 'admin-empty';
        emptyDiv.textContent = t('scorerCoursesNoEntries');
        content.appendChild(emptyDiv);
        return;
      }

      var modeKeyMap = { in_person: 'scModeInPerson', recorded: 'scModeRecorded', both: 'scModeBoth' };

      // Courses are separate events on different days, but all their DE/EN
      // form signups go into one combined table (Lang column distinguishes).
      var allSources = [];
      items.forEach(function(sc) {
        if (sc.form_slug_en) allSources.push({ slug: sc.form_slug_en, lang: 'EN' });
        if (sc.form_slug_de) allSources.push({ slug: sc.form_slug_de, lang: 'DE' });
      });
      if (allSources.length) {
        var bar = document.createElement('div');
        bar.style.cssText = 'display:flex;justify-content:flex-end;margin-bottom:var(--space-md);';
        var allBtn = document.createElement('button');
        allBtn.className = 'admin-btn admin-btn-sm admin-btn-primary';
        allBtn.textContent = t('scAllSignups');
        allBtn.addEventListener('click', function() {
          pushAdminUrl('scorer_courses', { course: 'all' });
          openScorerCourseInline('all');
        });
        bar.appendChild(allBtn);
        content.appendChild(bar);
      }

      var list = document.createElement('div');
      list.className = 'admin-list';

      items.forEach(function(sc) {
        var row = document.createElement('div');
        row.className = 'admin-list-item';

        var info = document.createElement('div');
        info.className = 'admin-list-info';

        var textCol = document.createElement('div');
        var h3 = document.createElement('h3');
        h3.className = 'admin-list-title';
        h3.textContent = sc.title_en || sc.title_de || sc.slug_id || '(?)';
        textCol.appendChild(h3);

        var meta = document.createElement('div');
        meta.className = 'admin-list-meta';

        var dateBadge = document.createElement('span');
        dateBadge.className = 'admin-badge';
        dateBadge.style.cssText = 'text-align:center;line-height:1.35;border-radius:var(--radius-md);';
        if (sc.date_iso) {
          dateBadge.appendChild(document.createTextNode(isoToSwissDate(sc.date_iso)));
          if (sc.time) {
            dateBadge.appendChild(document.createElement('br'));
            dateBadge.appendChild(document.createTextNode(String(sc.time).substring(0, 5)));
          }
        } else {
          dateBadge.textContent = 'TBA';
        }
        meta.appendChild(dateBadge);

        var modeBadge = document.createElement('span');
        modeBadge.className = 'admin-badge admin-badge-gray';
        modeBadge.textContent = t(modeKeyMap[sc.mode] || 'scModeInPerson');
        meta.appendChild(modeBadge);

        var activeBadge = document.createElement('span');
        activeBadge.className = sc.active ? 'admin-badge admin-badge-green' : 'admin-badge admin-badge-gray';
        activeBadge.textContent = sc.active ? t('scActive_badge') : t('scInactive_badge');
        meta.appendChild(activeBadge);

        var slugSpan = document.createElement('span');
        slugSpan.style.cssText = 'color:var(--text-muted);font-size:var(--text-xs);';
        slugSpan.textContent = 'DE: ' + (sc.form_slug_de || '—') + '  EN: ' + (sc.form_slug_en || '—');
        meta.appendChild(slugSpan);

        textCol.appendChild(meta);
        info.appendChild(textCol);
        row.appendChild(info);

        var actions = document.createElement('div');
        actions.className = 'admin-list-actions';

        var scSources = [];
        if (sc.form_slug_en) scSources.push({ slug: sc.form_slug_en, lang: 'EN' });
        if (sc.form_slug_de) scSources.push({ slug: sc.form_slug_de, lang: 'DE' });
        if (scSources.length) {
          var respBtn = document.createElement('button');
          respBtn.className = 'admin-btn admin-btn-sm';
          respBtn.textContent = t('scRegistrations');
          respBtn.addEventListener('click', (function(id) {
            return function() {
              pushAdminUrl('scorer_courses', { course: id });
              openScorerCourseInline(id);
            };
          })(String(sc.id)));
          actions.appendChild(respBtn);
        }

        var editBtn = document.createElement('button');
        editBtn.className = 'admin-btn admin-btn-sm';
        editBtn.textContent = t('edit');
        editBtn.addEventListener('click', function() { openModal(sc); });
        actions.appendChild(editBtn);

        var deleteBtn = document.createElement('button');
        deleteBtn.className = 'admin-btn admin-btn-sm admin-btn-danger';
        deleteBtn.textContent = t('delete');
        deleteBtn.addEventListener('click', function() {
          confirmModal(t('scorerCoursesConfirmDelete'), { danger: true, confirmLabel: t('delete') }).then(function(ok) {
            if (!ok) return;
            wadmin('scorer_courses', 'items/scorer_courses/' + sc.id, { method: 'DELETE' })
              .then(function(res) {
                if (!res.ok) throw new Error('HTTP ' + res.status);
                loadItems();
              }).catch(function(err) { alert(t('deleteError') + err.message); });
          });
        });
        actions.appendChild(deleteBtn);

        row.appendChild(actions);
        list.appendChild(row);
      });

      content.appendChild(list);
    }

    // ── Scorer registrations (inline, editable) ───────────────
    // Resolve a ?course=<id|all> param to its OpnForm sources and render the
    // inline registrations view. Falls back to the list on a stale/unknown id.
    function openScorerCourseInline(courseParam) {
      var courses = _scorerCourses || [];
      if (String(courseParam) === 'all') {
        var all = [];
        courses.forEach(function(sc) {
          if (sc.form_slug_en) all.push({ slug: sc.form_slug_en, lang: 'EN' });
          if (sc.form_slug_de) all.push({ slug: sc.form_slug_de, lang: 'DE' });
        });
        if (!all.length) { renderScorerCoursesList(courses); return; }
        renderScorerRegistrations(all, t('scAllSignups'), 'all');
        return;
      }
      var sc = null;
      for (var i = 0; i < courses.length; i++) {
        if (String(courses[i].id) === String(courseParam)) { sc = courses[i]; break; }
      }
      if (!sc) { renderScorerCoursesList(courses); return; }
      var sources = [];
      if (sc.form_slug_en) sources.push({ slug: sc.form_slug_en, lang: 'EN' });
      if (sc.form_slug_de) sources.push({ slug: sc.form_slug_de, lang: 'DE' });
      renderScorerRegistrations(sources, (sc.title_en || sc.title_de || sc.slug_id || ''), String(sc.id));
    }

    function setScorerStatus(el, kind) {
      if (!el) return;
      if (kind === 'saving') { el.textContent = t('scSaving'); el.style.color = 'var(--text-muted)'; }
      else if (kind === 'saved') { el.textContent = '✓ ' + t('scSaved'); el.style.color = '#16a34a'; }
      else { el.textContent = '✕ ' + t('scSaveFailed'); el.style.color = '#dc2626'; }
    }

    // Upsert one tracking field for a signup. Serialized per sub_key so a fast
    // second edit cannot race the create (the POST is what mints the row id;
    // a following edit then PATCHes it). A failed op sets the status but does
    // not block later edits. The DB's unique sub_key is the final backstop.
    function saveScorerField(rowMeta, field, value, statusEl) {
      var st = rowMeta.state;
      st[field] = value;
      setScorerStatus(statusEl, 'saving');
      var run = function() {
        if (st.id != null) {
          var body = {}; body[field] = value;
          return wadmin('scorer_courses', 'items/scorer_course_attendance/' + st.id, {
            method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
          }).then(function(res) { if (!res.ok) throw new Error('HTTP ' + res.status); });
        }
        var create = { sub_key: rowMeta.key, form_slug: rowMeta.slug, submission_id: String(rowMeta.id) };
        create[field] = value;
        return wadmin('scorer_courses', 'items/scorer_course_attendance', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(create),
        }).then(function(res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        }).then(function(j) { if (j && j.data && j.data.id != null) st.id = j.data.id; });
      };
      var chain = (_scorerSaveChains[rowMeta.key] || Promise.resolve())
        .then(run)
        .then(function() { setScorerStatus(statusEl, 'saved'); },
              function() { setScorerStatus(statusEl, 'error'); });
      _scorerSaveChains[rowMeta.key] = chain;
    }

    // One staff correction to one OpnForm answer. Stored as a JSON document in
    // scorer_course_attendance.field_overrides and serialized through the same
    // per-row chain as every other cell, so two quick edits cannot race and lose
    // one another (each rewrites the WHOLE document, so a stale read would drop
    // the other field's correction).
    //
    // ⚠ TEXT, not an object: wadmin's assertScalarBody rejects a top-level object
    // in the body for section-scoped Website Admins — and scorer_courses is run by
    // exactly those. Sending the parsed object would 400 for the people this is for.
    //
    // Setting a value back to the participant's original DELETES the key rather
    // than storing an identical copy, so "corrected" always means "differs from
    // what they filed" and the revert affordance disappears on its own.
    function saveScorerOverride(rowMeta, fieldId, value, statusEl) {
      var row = rowMeta.row;
      var orig = (row.orig || {})[fieldId];
      var ovr = row.overrides || (row.overrides = {});
      var same = String(value == null ? '' : value) === String(orig == null ? '' : orig);
      if (same) delete ovr[fieldId]; else ovr[fieldId] = value;
      row.data[fieldId] = same ? orig : value;
      var keys = Object.keys(ovr);
      saveScorerField(rowMeta, 'field_overrides', keys.length ? JSON.stringify(ovr) : null, statusEl);
    }

    // "Prüfung bestanden" → the participant gets a confirmation mail. The recipient is
    // resolved SERVER-side from the OpnForm submission (wadmin.js); we deliberately do
    // not pass an address, so this route cannot be used to aim KSCW's sender anywhere.
    //
    // Queued behind the same per-row chain as the save, so the mail cannot overtake the
    // exam_passed write and report a state the DB does not have yet. A failure here is
    // surfaced but never reverts the tick: the exam IS passed, only the mail failed, and
    // silently unticking would lose the admin's work.
    // ── toasts ──────────────────────────────────────────────────
    // "E-Mail gesendet an …" used to land in the row's status span: a few pixels of grey
    // text in a wide table, gone on the next re-render, and easy to miss entirely — which
    // is poor for the one action here that reaches a real person. A toast puts it where
    // the eye goes and does not have to fight the table for room.
    var _toastHost = null;
    function showToast(message, kind) {
      if (!_toastHost) {
        _toastHost = document.createElement('div');
        // Above the modal layer: a mail is usually sent from behind a confirm, and a
        // confirmation nobody sees is not a confirmation.
        _toastHost.style.cssText = 'position:fixed;right:1rem;bottom:1rem;'
          + 'z-index:calc(var(--z-modal) + 2);display:flex;flex-direction:column-reverse;'
          + 'gap:0.5rem;align-items:flex-end;pointer-events:none;';
        document.body.appendChild(_toastHost);
      }
      var colour = kind === 'error' ? '#dc2626' : '#16a34a';
      var el = document.createElement('div');
      el.style.cssText = 'pointer-events:auto;cursor:pointer;max-width:380px;'
        + 'padding:0.65rem 0.9rem;border-radius:var(--radius-sm);'
        + 'background:var(--bg-elevated,#1c1c1e);border:1px solid var(--border);'
        + 'border-left:3px solid ' + colour + ';color:var(--text-primary);'
        + 'font-size:var(--text-sm);box-shadow:0 8px 24px rgba(0,0,0,0.45);'
        + 'opacity:0;transform:translateY(6px);transition:opacity .18s ease,transform .18s ease;';
      // textContent, never markup: the message carries an address typed into a public form.
      el.textContent = message;
      _toastHost.appendChild(el);
      // Next frame, or the transition has nothing to animate from.
      requestAnimationFrame(function() { el.style.opacity = '1'; el.style.transform = 'none'; });
      var gone = false;
      function dismiss() {
        if (gone) return;
        gone = true;
        el.style.opacity = '0';
        el.style.transform = 'translateY(6px)';
        setTimeout(function() { el.remove(); }, 200);
      }
      el.addEventListener('click', dismiss);
      // A failure needs longer than a success: it has to be read, not just noticed.
      setTimeout(dismiss, kind === 'error' ? 9000 : 5000);
    }

    // `note` is the optional line the admin typed in the confirm modal. It travels in the
    // body and is escaped server-side before it reaches the mail HTML.
    function sendExamResultMail(rowMeta, result, note) {
      var run = function() {
        return wadmin('scorer_courses',
          'opnform/forms/' + encodeURIComponent(rowMeta.slug)
            + '/submissions/' + encodeURIComponent(rowMeta.id) + '/exam-result-email',
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ result: result, note: note || '' }),
          }
        ).then(function(res) {
          return res.json().catch(function() { return {}; }).then(function(body) {
            if (!res.ok) throw new Error(body.error || ('HTTP ' + res.status));
            // The address comes back from the server, which resolved it from the signup —
            // showing it is how you confirm the mail went where you meant.
            showToast('✉ ' + t('scExamResultMailSent') + ' ' + (body.to || ''), 'success');
          });
        });
      };
      var chain = (_scorerSaveChains[rowMeta.key] || Promise.resolve())
        .then(run)
        .catch(function() {
          // The result IS recorded — only the mail failed. Say exactly that, so nobody
          // re-clicks trying to fix a record that was never broken.
          showToast('✕ ' + t('scExamResultMailFailed'), 'error');
        });
      _scorerSaveChains[rowMeta.key] = chain;
    }

    // Address fields are matched by the form's field NAME, which makes these patterns a
    // live dependency on wording OpnForm owns and this repo cannot see. Rename a field and
    // the column silently empties — no error, just blanks, and downstream a guessed town
    // that looks like data once it is in a spreadsheet cell.
    //
    // Every alternative below is a label that has actually been used, not a guess at one:
    //   strasse — "Strasse und Nummer" (DE), "Street and number" (EN)
    //   plz     — "PLZ" (DE), "ZIP Code" (EN)
    //   ort     — "Ort" (DE), "Place" (EN)   ← "Place" was missing, and every English
    //             signup fell through to a guessed Zürich while the person had typed one
    //   adresse — "Adresse" / "Address", the single free-text box used before the split.
    //             Pre-split submissions answer under the id it was renamed to, so this is
    //             only a fallback; see resolveAddress for how the two shapes are told apart.
    //
    // tests/unit/admin-address-fields.test.ts pins these against the real labels.
    var ADDR_PATTERNS = {
      strasse: /^(strasse|str\.|street)/i,
      plz: /^(plz|postleitzahl|postcode|zip)/i,
      ort: /^(ort|wohnort|stadt|city|town|place|locality)/i,
      adresse: /^(adresse|address)/i,
    };

    // Where a signup gave no town and the member records have none either, the SVRZ list
    // says Zürich. The club is a Zürich club and it is the likeliest answer — but it IS a
    // guess, and roughly 3 in 10 members live elsewhere, so it is only ever reached after
    // the form, the free-text parse and the member lookup have all come up empty.
    var SVRZ_FALLBACK_CITY = 'Zürich';

    // Mirrors normalizeLicence in scorer-exam.js — same rule, so a licence names its file
    // identically whether the participant typed it at upload or an admin typed it here.
    // The 4–10 bound rejects a stray digit or a mistyped phone number, either of which
    // would otherwise become a filename SVRZ cannot match to anyone.
    function licenceDigits(v) {
      var digits = String(v == null ? '' : v).replace(/\D/g, '');
      return (digits.length >= 4 && digits.length <= 10) ? digits : '';
    }

    // "0", "00000" and friends are how a participant with no licence yet answers a
    // number field they cannot leave blank — and how an admin records the same thing.
    // It is a STATEMENT of not being licensed, not a missing entry, and the two are
    // treated differently everywhere below: a blank cell still counts as data we are
    // waiting on, a zero does not.
    function isUnlicensed(v) {
      var digits = String(v == null ? '' : v).replace(/\D/g, '');
      return !!digits && /^0+$/.test(digits);
    }
    // What that gets written as on the SVRZ list, where "00000" would read like a
    // licence number to whoever transcribes it. German like the rest of the sheet,
    // and in the slash form on purpose: the signup never asks for gender, so the
    // list must not assert one.
    var SVRZ_NO_LICENCE = 'Noch nicht lizenziert/e';
    function svrzLicenceCell(v) {
      var s = String(v == null ? '' : v).trim();
      return isUnlicensed(s) ? SVRZ_NO_LICENCE : s;
    }

    // The SVRZ Teilnehmerliste is a German document and its own column reads
    // "Bestanden / Nicht bestanden", so these strings are literal, never translated.
    //
    // Undecided exports as EMPTY, and that is the whole reason exam_result exists: an
    // empty cell says "no verdict recorded", while "Nicht bestanden" tells SVRZ someone
    // sat the exam and failed it. Most rows are the former.
    function svrzResultLabel(r) {
      return r === 'passed' ? 'Bestanden' : (r === 'failed' ? 'Nicht bestanden' : '');
    }
    // The CSV is the admin's own export, so it follows the admin's UI language.
    function examResultLabel(r) {
      return r === 'passed' ? t('scExamResultPassed') : (r === 'failed' ? t('scExamResultFailed') : '');
    }

    // Yes/No pill. The unselected pill stays an outline so the selected answer is the only
    // filled thing in the cell — at a glance the column reads as one answer per row.
    function examBtnCss(active, color) {
      return 'min-width:38px;padding:0.2rem 0.5rem;margin:0 0.1rem;cursor:pointer;'
        + 'font-size:var(--text-xs);font-weight:700;border-radius:var(--radius-sm);'
        + 'border:1px solid ' + (active ? color : 'var(--border)') + ';'
        + 'background:' + (active ? color : 'transparent') + ';'
        + 'color:' + (active ? '#fff' : 'var(--text-muted)') + ';';
    }

    // Inline editable registrations table for one course (or 'all' combined).
    // Compact row = first/last name + the KSCW-owned tracking toggles (present /
    // exam sent / exam passed), the SV-licence input (pre-filled from the form's
    // SVRZ answer when untracked) and delete; the ▸ arrow expands a detail row
    // with every remaining OpnForm answer plus the editable notes field. Tracking
    // lives in scorer_course_attendance, upserted per cell. A "Send email" control
    // toggles a select column (all checked) and opens the default mailer.
    function renderScorerRegistrations(sources, title, courseId) {
      var content = document.getElementById('admin-content');
      if (!content) return;
      var fab = document.getElementById('fab-btn');
      if (fab) fab.style.display = 'none'; // no course creation inside the detail view
      _scorerSaveChains = {}; // fresh save serialization per view

      var srcList = (sources || [])
        .map(function(s) { return { slug: normalizeFormSlug(s && s.slug != null ? s.slug : s), lang: (s && s.lang) || '' }; })
        .filter(function(s) { return !!s.slug; });
      var seenSlug = {};
      srcList = srcList.filter(function(s) { if (seenSlug[s.slug]) return false; seenSlug[s.slug] = 1; return true; });
      var multi = srcList.length > 1;

      content.textContent = '';

      var head = document.createElement('div');
      head.style.cssText = 'display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;margin-bottom:var(--space-md);';
      var backBtn = document.createElement('button');
      backBtn.className = 'admin-btn admin-btn-sm';
      backBtn.textContent = t('scBackToCourses');
      backBtn.addEventListener('click', function() {
        pushAdminUrl('scorer_courses');
        renderScorerCoursesList(_scorerCourses || []);
      });
      head.appendChild(backBtn);
      var h3 = document.createElement('h3');
      h3.className = 'admin-list-title';
      h3.style.cssText = 'margin:0;';
      h3.textContent = title || t('scRegistrations');
      head.appendChild(h3);
      content.appendChild(head);

      var summary = document.createElement('div');
      summary.style.cssText = 'font-size:var(--text-sm);color:var(--text-muted);margin-bottom:0.5rem;';
      summary.textContent = t('loading');
      content.appendChild(summary);

      var tableHost = document.createElement('div');
      content.appendChild(tableHost);

      if (!srcList.length) {
        summary.textContent = '';
        var none = document.createElement('div');
        none.className = 'admin-empty';
        none.textContent = t('scNoSignups');
        tableHost.appendChild(none);
        return;
      }

      Promise.all([
        Promise.all(srcList.map(function(src) {
          return wadmin('scorer_courses', 'opnform/forms/' + encodeURIComponent(src.slug) + '/submissions?per_page=100', {})
            .then(function(res) {
              if (!res.ok) return { src: src, error: 'HTTP ' + res.status };
              return res.json().then(function(p) { return { src: src, payload: p }; });
            }).catch(function(e) { return { src: src, error: (e && e.message) || 'error' }; });
        })),
        wadmin('scorer_courses', 'items/scorer_course_attendance?limit=-1', {})
          .then(function(res) { return res.ok ? res.json() : { data: [] }; })
          .catch(function() { return { data: [] }; }),
        // Postcode + town for signups that gave neither — most people read the form's
        // "Adresse" as "street". Keyed by slug then submission id. Fails soft: without it
        // the export falls back exactly as it did before, so a lookup outage costs
        // precision, not the export.
        Promise.all(srcList.map(function(src) {
          return wadmin('scorer_courses',
            'opnform/forms/' + encodeURIComponent(src.slug) + '/member-addresses', {})
            .then(function(res) { return res.ok ? res.json() : { data: {} }; })
            .then(function(j) { return { slug: src.slug, map: (j && j.data) || {} }; })
            .catch(function() { return { slug: src.slug, map: {} }; });
        })),
        // Current SV licence from the member register, for signups we can identify.
        // The licence box otherwise shows whatever the participant typed and never
        // learns that the club has since corrected it — which is how a box could read
        // "0000000" while the member record had held the real number for days.
        // Fails soft: no lookup just means no cross-check, exactly as before.
        Promise.all(srcList.map(function(src) {
          return wadmin('scorer_courses',
            'opnform/forms/' + encodeURIComponent(src.slug) + '/member-licences', {})
            .then(function(res) { return res.ok ? res.json() : { data: {} }; })
            .then(function(j) { return { slug: src.slug, map: (j && j.data) || {} }; })
            .catch(function() { return { slug: src.slug, map: {} }; });
        }))
      ]).then(function(bundle) {
        var results = bundle[0];
        var attRows = (bundle[1] && bundle[1].data) || [];
        var memberAddr = {};
        (bundle[2] || []).forEach(function(r) { memberAddr[r.slug] = r.map || {}; });
        var memberLic = {};
        (bundle[3] || []).forEach(function(r) { memberLic[r.slug] = r.map || {}; });

        var fields = [], byId = {}, mergedRows = [], errors = [];
        results.forEach(function(rr) {
          if (rr.error) { errors.push(rr.src.slug + ': ' + rr.error); return; }
          var p = rr.payload || {};
          (p.fields || []).forEach(function(f) {
            if (!f || typeof f.type !== 'string' || f.type.indexOf('nf-') === 0) return;
            if (!byId[f.id]) { byId[f.id] = f; fields.push(f); }
          });
          (p.data || []).forEach(function(r) {
            var d = (r && r.data) || r || {};
            mergedRows.push({
              data: d,
              id: (r && r.id != null) ? r.id : d.id,
              slug: rr.src.slug,
              lang: rr.src.lang,
            });
          });
        });
        var attByKey = {};
        attRows.forEach(function(a) { if (a && a.sub_key != null) attByKey[String(a.sub_key)] = a; });

        // ── staff corrections (scorer_course_attendance.field_overrides) ──
        //
        // Applied HERE, onto row.data, rather than at each place a value is read.
        // Everything downstream — the columns, the surname sort, the detail panel,
        // the SVRZ export, the address resolver, the email picker — then works on
        // corrected data without knowing overrides exist. Patching the half-dozen
        // readers instead is how one of them gets missed and the export quietly
        // ships the uncorrected answer.
        //
        // ⚠ The participant's own answers are NEVER destroyed: the untouched
        // payload is kept on row.orig so the detail panel can show what they
        // actually filed and offer to revert. OpnForm is never written to — an
        // update there re-fires the form's notification emails (see migration 332).
        function parseOverrides(a) {
          if (!a || !a.field_overrides) return {};
          try {
            var o = JSON.parse(a.field_overrides);
            return (o && typeof o === 'object' && !Array.isArray(o)) ? o : {};
          } catch (e) { return {}; } // corrupt JSON must not blank the whole table
        }
        mergedRows.forEach(function(r) {
          var a = attByKey[r.slug + ':' + r.id];
          var ovr = parseOverrides(a);
          r.orig = r.data;
          r.overrides = ovr;
          var keys = Object.keys(ovr);
          if (!keys.length) return;
          var copy = {};
          Object.keys(r.data).forEach(function(k) { copy[k] = r.data[k]; });
          keys.forEach(function(k) { copy[k] = ovr[k]; });
          r.data = copy;
        });

        var total = mergedRows.length;
        summary.textContent = total + ' ' + (total === 1 ? 'signup' : 'signups')
          + (multi ? ' (' + srcList.map(function(s) { return s.lang || s.slug; }).join(' + ') + ')' : '');

        if (errors.length) {
          var warn = document.createElement('div');
          warn.className = 'admin-empty';
          warn.style.cssText = 'color:#dc2626;margin-bottom:0.5rem;';
          warn.textContent = 'Could not load: ' + errors.join('; ');
          content.insertBefore(warn, tableHost);
        }

        // Identify well-known form fields across the DE+EN merged field sets so
        // the collapsed row can surface first/last name + SVRZ and gather emails.
        function idsWhere(pred) { return fields.filter(pred).map(function(f) { return f.id; }); }
        var firstNameIds = idsWhere(function(f) { return /vorname|first\s*name/i.test(String(f.name || '')); });
        var lastNameIds  = idsWhere(function(f) { return /nachname|last\s*name|surname|familienname/i.test(String(f.name || '')); });
        var svrzIds      = idsWhere(function(f) { return /svrz/i.test(String(f.name || '')); });
        var emailIds     = idsWhere(function(f) { return f.type === 'email' || /^e-?mail/i.test(String(f.name || '')); });
        // Only the SVRZ export reads these — they stay out of shownIds so the
        // detail panel keeps listing them like any other answer.
        var addressIds   = idsWhere(function(f) { return ADDR_PATTERNS.adresse.test(String(f.name || '')); });
        var strasseIds   = idsWhere(function(f) { return ADDR_PATTERNS.strasse.test(String(f.name || '')); });
        var plzIds       = idsWhere(function(f) { return ADDR_PATTERNS.plz.test(String(f.name || '')); });
        var ortIds       = idsWhere(function(f) { return ADDR_PATTERNS.ort.test(String(f.name || '')); });
        var phoneIds     = idsWhere(function(f) { return f.type === 'phone_number' || /natel|telefon|phone|handy|mobile/i.test(String(f.name || '')); });
        var dobIds       = idsWhere(function(f) { return /geburtsdatum|birth/i.test(String(f.name || '')); });
        var kscwIds      = idsWhere(function(f) { return /kscw/i.test(String(f.name || '')); });
        var clubIds      = idsWhere(function(f) { return /club/i.test(String(f.name || '')); });
        var shownIds = {}; // fields already surfaced as columns → excluded from the detail panel
        firstNameIds.concat(lastNameIds).concat(svrzIds).forEach(function(id) { shownIds[id] = 1; });
        function pickVal(d, ids) {
          for (var i = 0; i < ids.length; i++) { var v = d[ids[i]]; if (v != null && v !== '') return v; }
          return '';
        }

        // Sorted by surname. This list is worked against a paper Teilnehmerliste and read
        // out at a course, both of which go by surname; it was newest-signup-first, which
        // is the order they arrived in and no order at all when you are hunting for a
        // person. Sorted here rather than at fetch: the name lives in an OpnForm answer
        // keyed by field id, so only this side knows which id is the surname.
        //
        // de-CH collation, so Ä sorts with A rather than after Z, and `numeric` keeps a
        // "Meier 2" style suffix in human order. Runs after the id detection above —
        // sorting before it would have had nothing to sort on.
        var nameCollator = new Intl.Collator('de-CH', { sensitivity: 'base', numeric: true });
        mergedRows.sort(function(a, b) {
          var byLast = nameCollator.compare(
            String(pickVal(a.data, lastNameIds) || ''),
            String(pickVal(b.data, lastNameIds) || ''));
          if (byLast !== 0) return byLast;
          return nameCollator.compare(
            String(pickVal(a.data, firstNameIds) || ''),
            String(pickVal(b.data, firstNameIds) || ''));
        });

        // Email-selection state (populated as rows render).
        var selectCells = []; // th/td of the select column — shown only in email mode
        var selectBoxes = []; // { cb, email } for rows that carry an email
        var emailMode = false;
        var exportMetas = []; // one per rendered row, in table order

        // The KSCW tracking columns (present / exam / SV licence / notes) live in
        // scorer_course_attendance, not in the OpnForm answers — an export built
        // from the form payload alone silently drops all of them, and the SV
        // licence in particular is almost always admin-entered. So export exactly
        // what the row shows: the live inputs first, then the tracked value, then
        // the form's own SVRZ answer.
        function buildScorerExport() {
          var extraFields = fields.filter(function(f) { return !shownIds[f.id]; });
          var headers = [t('scColDate')]
            .concat(multi ? [t('scColLang')] : [])
            .concat([t('scColFirstName'), t('scColLastName'), t('scPresent'),
                     t('scExamPassed'), t('scSvLicense'), t('scNotes')])
            .concat(extraFields.map(function(f) { return f.name; }));
          var rows = exportMetas.map(function(m) {
            var d = m.row.data, st = m.state;
            return [isoToSwissDateTime(d.created_at)]
              .concat(multi ? [m.row.lang || ''] : [])
              .concat([
                String(pickVal(d, firstNameIds) || ''),
                String(pickVal(d, lastNameIds) || ''),
                !!st.present,
                examResultLabel(st.exam_result),
                m.svInp ? m.svInp.value.trim() : (st.sv_license || m.formSv || ''),
                m.noteInp ? m.noteInp.value : (st.notes || ''),
              ])
              .concat(extraFields.map(function(f) { return fmtAnswer(f, d[f.id]); }));
          });
          return { headers: headers, rows: rows };
        }

        // Each row's Kursdatum comes from the course behind its form, so the
        // combined ("all") view still dates every row correctly.
        var courseBySlug = {};
        (_scorerCourses || []).forEach(function(sc) {
          ['form_slug_de', 'form_slug_en'].forEach(function(k) {
            var slug = normalizeFormSlug(sc[k]);
            if (slug) courseBySlug[slug] = sc;
          });
        });
        // Row 5 names whoever ran the course, from the course's own Schreiberexperte
        // field. A course routinely has more than one expert, and the DE and EN halves
        // of one course are two records that can each name their own — so every
        // distinct name is listed. It previously took the name only when every source
        // agreed and printed NOTHING otherwise, which meant the ordinary case of
        // exporting the German and English signups together lost the line entirely.
        //
        // Separators are normalised ("A und B", "A; B" → "A, B") so one field's
        // punctuation does not decide how an official list reads.
        function svrzExpert() {
          var seen = {}, out = [];
          srcList.forEach(function(s) {
            var sc = courseBySlug[s.slug];
            String((sc && sc.scorer_expert) || '').split(/[,;&]|\bund\b/i).forEach(function(part) {
              var n = part.trim().replace(/\s+/g, ' ');
              // Keyed on the name's WORDS, not its spelling: the two records are typed
              // by hand and one reading "Claudia Postolka" against the other's "Postolka
              // Claudia" is one expert, not two. First spelling seen wins.
              var key = n.toLowerCase().split(' ').sort().join(' ');
              if (!n || seen[key]) return;
              seen[key] = 1;
              out.push(n);
            });
          });
          return out.join(', ');
        }
        // SVRZ needs a postcode and a town, and the form asked for neither: "Adresse" was
        // one free-text box, and 16 of 25 people read it as "street". This resolves the
        // best answer available, most-trustworthy first:
        //
        //   1. the split Strasse/PLZ/Ort fields, if the form has them — stated, not parsed
        //   2. a postcode parsed out of the old free-text answer — stated, just cramped
        //   3. the member record, matched by name server-side — the club's own data
        //   4. "Zürich" with no postcode — a guess, and known to be wrong ~30% of the time
        //      (only 485 of 691 members with an Ort live there; two of the seven this
        //      lookup resolves are in Wädenswil and Stallikon). Last resort by design:
        //      every step above exists to make this one rare.
        function resolveAddress(m) {
          var d = m.row.data;
          var plz = String(pickVal(d, plzIds) || '').trim();
          var ort = String(pickVal(d, ortIds) || '').trim();

          // ⚠ A FILLED PLZ/Ort is the discriminator, not the field's name. The DE form was
          // split by RENAMING "Adresse" to "Strasse und Nummer" — same field id — so every
          // pre-split submission still answers under what is now called the street field,
          // and some of those answers are a whole address ("Hadlaubstrasse 68, 8006
          // Zürich"). Trusting the name would file that entire string as the street and
          // leave PLZ blank, breaking the rows that parse correctly today. PLZ and Ort are
          // required on the split form, so their presence marks a post-split submission.
          if (plz || ort) {
            return { street: String(pickVal(d, strasseIds) || '').trim(), zip: plz, city: ort, guessed: false };
          }

          // Pre-split: one free-text box, whatever it is called now. Parse it.
          var parsed = splitSwissAddress(pickVal(d, strasseIds) || pickVal(d, addressIds));
          if (parsed.zip || parsed.city) return { street: parsed.street, zip: parsed.zip, city: parsed.city, guessed: false };

          var hit = (memberAddr[m.row.slug] || {})[String(m.row.id)];
          if (hit && (hit.plz || hit.ort)) {
            return { street: parsed.street, zip: String(hit.plz || ''), city: String(hit.ort || ''), guessed: false };
          }
          return { street: parsed.street, zip: '', city: SVRZ_FALLBACK_CITY, guessed: true };
        }

        function buildSvrzExport() {
          return exportMetas.map(function(m) {
            var d = m.row.data, st = m.state;
            var sc = courseBySlug[m.row.slug] || {};
            var addr = resolveAddress(m);
            // KSCW members answer Ja/Yes and never type a club; everyone else
            // names their own in "Club und team".
            var isKscw = /^(ja|yes)$/i.test(String(pickVal(d, kscwIds) || '').trim());
            return [
              isoToSwissDate(sc.date_iso),
              isoToSwissDate(m.examInp ? m.examInp.value : st.exam_date),
              svrzResultLabel(st.exam_result),
              isKscw ? 'KSC Wiedikon' : String(pickVal(d, clubIds) || '').trim(),
              svrzLicenceCell(m.svInp ? m.svInp.value : (st.sv_license || m.formSv || '')),
              String(pickVal(d, lastNameIds) || ''),
              String(pickVal(d, firstNameIds) || ''),
              addr.street,
              addr.zip,
              addr.city,
              String(pickVal(d, phoneIds) || ''),
              String(pickVal(d, emailIds) || ''),
              isoToSwissDate(pickVal(d, dobIds)),
            ];
          });
        }

        var controls = document.createElement('div');
        controls.style.cssText = 'display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.5rem;';
        content.insertBefore(controls, tableHost);

        if (total > 0) {
          var nameBase = multi ? 'combined' : srcList[0].slug;
          var xls = document.createElement('button');
          xls.className = 'admin-btn admin-btn-sm admin-btn-primary';
          xls.textContent = t('scExportXLSX');
          xls.addEventListener('click', function() {
            // A correction outranks the participant's own sheet: it exists precisely
            // because someone judged the original wrong, and SVRZ gets one sheet per
            // person. The original stays in Directus, just not in this zip.
            var refs = exportMetas.filter(function(m) {
              return m.state.exam_file || m.state.exam_file_corrected;
            }).map(function(m) {
              var d = m.row.data;
              var name = [String(pickVal(d, lastNameIds) || ''), String(pickVal(d, firstNameIds) || '')]
                .filter(Boolean).join(' ') || String(m.row.id);
              var rawSv = m.svInp ? m.svInp.value : (m.state.sv_license || m.formSv || '');
              return {
                id: m.state.exam_file_corrected || m.state.exam_file,
                // The licence number names the file; the person names the error message
                // when a fetch fails, where a number would tell you nothing.
                //
                // Digits only, mirroring normalizeLicence server-side: the participant
                // upload already normalizes "337 646" → "337646", but the admin field
                // takes whatever is typed. Without this the same licence yields two
                // different filenames depending on who entered it.
                //
                // A zero is not a number to name a file after — every unlicensed
                // participant would land on "schreiberpruefung_00000", telling them
                // apart by a "(2)" suffix. They go by name, like a blank does.
                licence: isUnlicensed(rawSv) ? '' : licenceDigits(rawSv),
                unlicensed: isUnlicensed(rawSv),
                label: name,
              };
            });
            // Two things worth knowing BEFORE this list goes to SVRZ, in one prompt rather
            // than two: a missing licence number, and a town we guessed. Both let you
            // through — it is your call, and a partial list still beats none — but neither
            // happens silently. A guessed Wohnort in particular is the kind of thing that
            // looks like data once it is sitting in a spreadsheet cell.
            // Only genuinely BLANK licences are worth stopping for. Someone who
            // answered "00000" has said they are not licensed yet — the list now
            // says so in words, so warning that their number is missing would be
            // asking for a number that does not exist.
            var noLicence = refs.filter(function(r) { return !r.licence && !r.unlicensed; });
            var guessed = exportMetas.filter(function(m) { return resolveAddress(m).guessed; })
              .map(function(m) {
                var d = m.row.data;
                return [String(pickVal(d, lastNameIds) || ''), String(pickVal(d, firstNameIds) || '')]
                  .filter(Boolean).join(' ') || String(m.row.id);
              });
            var warn = [];
            if (noLicence.length) {
              warn.push(t('scExportNoLicence')
                .split('{count}').join(String(noLicence.length))
                .split('{names}').join(noLicence.map(function(r) { return r.label; }).join('\n')));
            }
            if (guessed.length) {
              warn.push(t('scExportGuessedCity')
                .split('{count}').join(String(guessed.length))
                .split('{city}').join(SVRZ_FALLBACK_CITY)
                .split('{names}').join(guessed.join('\n')));
            }
            var go = warn.length
              ? confirmModal(warn.join('\n\n———\n\n') + '\n\n' + t('scExportAnyway'))
              : Promise.resolve(true);
            go.then(function(ok) {
              if (!ok) return;
              xls.disabled = true;
              return Promise.resolve(exportSvrzBundle(nameBase, buildSvrzExport(), svrzExpert(), refs))
                .catch(function() { alert(t('scScoresheetFetchFailed')); })
                .then(function() { xls.disabled = false; });
            });
          });
          controls.appendChild(xls);

          var exp = document.createElement('button');
          exp.className = 'admin-btn admin-btn-sm';
          exp.textContent = t('scExportTSV');
          exp.addEventListener('click', function() {
            var e = buildScorerExport();
            exportRowsTSV(nameBase, e.headers, e.rows);
          });
          controls.appendChild(exp);
        }

        if (!mergedRows.length) {
          var empty = document.createElement('div');
          empty.className = 'admin-empty';
          empty.textContent = t('scNoSignups');
          tableHost.appendChild(empty);
          return;
        }

        // Send-email flow: click once to enter select mode (all checked), click
        // again to open the default mailer with the selected addresses as "to".
        var emailBtn = null, cancelBtn = null, selectAllCb = null;
        function countSelected() { return selectBoxes.filter(function(b) { return b.cb.checked; }).length; }
        function updateEmailBtn() {
          if (!emailBtn) return;
          emailBtn.textContent = emailMode ? (t('scEmailCompose') + ' (' + countSelected() + ')') : t('scEmailBtn');
        }
        function setEmailMode(on) {
          emailMode = on;
          selectCells.forEach(function(c) { c.style.display = on ? '' : 'none'; });
          if (cancelBtn) cancelBtn.style.display = on ? '' : 'none';
          emailBtn.classList.toggle('admin-btn-primary', on);
          updateEmailBtn();
        }
        if (emailIds.length) {
          emailBtn = document.createElement('button');
          emailBtn.className = 'admin-btn admin-btn-sm';
          emailBtn.textContent = t('scEmailBtn');
          emailBtn.addEventListener('click', function() {
            if (!emailMode) { setEmailMode(true); return; }
            var emails = [], seen = {};
            selectBoxes.forEach(function(b) {
              if (!b.cb.checked) return;
              var e = String(b.email || '').trim();
              if (!e || e.indexOf('@') === -1 || seen[e.toLowerCase()]) return;
              seen[e.toLowerCase()] = 1; emails.push(e);
            });
            if (!emails.length) { alert(t('scEmailNone')); return; }
            window.location.href = 'mailto:' + emails.join(',');
          });
          controls.appendChild(emailBtn);
          cancelBtn = document.createElement('button');
          cancelBtn.className = 'admin-btn admin-btn-sm';
          cancelBtn.textContent = t('scEmailCancel');
          cancelBtn.style.display = 'none';
          cancelBtn.addEventListener('click', function() { setEmailMode(false); });
          controls.appendChild(cancelBtn);
        }

        var wrap = document.createElement('div');
        // On a phone the rows below stop being a table and become cards, so the
        // scroll box and its frame step aside there (see .admin-reg-wrap).
        wrap.className = 'admin-scroll-x admin-scroll-framed admin-reg-wrap';
        var table = document.createElement('table');
        table.className = 'admin-reg-table';
        table.style.cssText = 'width:100%;border-collapse:collapse;font-size:var(--text-sm);';
        var COLSPAN = 9; // select, arrow, first, last, present, examPassed, sheet, sv, actions
        var cellCss = 'padding:0.5rem 0.6rem;border-bottom:1px solid var(--border);';
        var headCss = 'text-align:left;padding:0.5rem 0.6rem;border-bottom:1px solid var(--border);background:rgba(255,255,255,0.04);font-weight:600;white-space:nowrap;';

        var thead = document.createElement('thead');
        var thRow = document.createElement('tr');
        function makeTh(label, extraCss) {
          var th = document.createElement('th');
          if (typeof label === 'string') th.textContent = label; else if (label) th.appendChild(label);
          th.style.cssText = headCss + (extraCss || '');
          return th;
        }
        selectAllCb = document.createElement('input');
        selectAllCb.type = 'checkbox';
        selectAllCb.checked = true;
        selectAllCb.style.cssText = 'width:16px;height:16px;cursor:pointer;';
        selectAllCb.addEventListener('change', function() {
          selectBoxes.forEach(function(b) { if (!b.cb.disabled) b.cb.checked = selectAllCb.checked; });
          updateEmailBtn();
        });
        var selTh = makeTh(selectAllCb, 'text-align:center;display:none;');
        selectCells.push(selTh);
        thRow.appendChild(selTh);
        thRow.appendChild(makeTh('', 'width:1.5rem;'));
        // Surname first — it is the sort key and what you scan down.
        thRow.appendChild(makeTh(t('scColLastName')));
        thRow.appendChild(makeTh(t('scColFirstName')));
        thRow.appendChild(makeTh(t('scPresent'), 'text-align:center;'));
        thRow.appendChild(makeTh(t('scExamPassed'), 'text-align:center;'));
        thRow.appendChild(makeTh(t('scExamUploaded'), 'text-align:center;'));
        thRow.appendChild(makeTh(t('scSvLicense')));
        thRow.appendChild(makeTh(''));
        thead.appendChild(thRow);
        table.appendChild(thead);
        var tbody = document.createElement('tbody');

        mergedRows.forEach(function(row) {
          var d = row.data;
          var key = row.slug + ':' + String(row.id);
          var srv = attByKey[key] || {};
          var state = {
            id: (srv.id != null ? srv.id : null),
            present: !!srv.present,
            // '' = nobody has decided yet, and that is NOT the same as failed. Falling back
            // to the legacy exam_passed covers any row written before the split (the
            // backfill handles the rest); a bare `false` there stays undecided on purpose.
            exam_result: srv.exam_result || (srv.exam_passed ? 'passed' : ''),
            exam_date: srv.exam_date || '',
            exam_file: srv.exam_file || '',
            exam_file_corrected: srv.exam_file_corrected || '',
            exam_file_corrected_by: srv.exam_file_corrected_by || '',
            exam_file_corrected_on: srv.exam_file_corrected_on || '',
            sv_license: srv.sv_license || '',
            notes: srv.notes || '',
          };
          var rowMeta = { slug: row.slug, id: row.id, key: key, state: state };

          var tr = document.createElement('tr');
          tr.className = 'reg-row';
          var detailTr = document.createElement('tr');
          detailTr.className = 'reg-detail-row';
          detailTr.style.display = 'none';
          function toggleDetail() {
            var open = detailTr.style.display === 'none';
            detailTr.style.display = open ? '' : 'none';
            arrowTd.textContent = open ? '▾' : '▸';
          }

          // select checkbox (email mode only)
          var rowEmail = String(pickVal(d, emailIds) || '').trim();
          var selTd = document.createElement('td');
          selTd.className = 'reg-c-sel';
          selTd.setAttribute('data-label', t('scColSelect'));
          selTd.style.cssText = cellCss + 'text-align:center;display:none;';
          var selCb = document.createElement('input');
          selCb.type = 'checkbox';
          selCb.checked = !!rowEmail;
          selCb.disabled = !rowEmail;
          selCb.style.cssText = 'width:16px;height:16px;cursor:pointer;';
          selCb.addEventListener('change', updateEmailBtn);
          selTd.appendChild(selCb);
          if (rowEmail) selectBoxes.push({ cb: selCb, email: rowEmail });
          selectCells.push(selTd);
          tr.appendChild(selTd);

          // expand/collapse arrow
          var arrowTd = document.createElement('td');
          arrowTd.className = 'reg-c-arrow';
          arrowTd.style.cssText = cellCss + 'text-align:center;cursor:pointer;color:var(--text-muted);user-select:none;';
          arrowTd.textContent = '▸';
          arrowTd.title = t('scDetails');
          arrowTd.addEventListener('click', toggleDetail);
          tr.appendChild(arrowTd);

          // Last / first name (also clickable to expand). Surname leads: it is what the
          // table is sorted by, and a sorted column you have to read past is wasted.
          var lnV = pickVal(d, lastNameIds);
          var lnTd = document.createElement('td');
          lnTd.className = 'reg-c-last';
          lnTd.style.cssText = cellCss + 'cursor:pointer;';
          lnTd.textContent = (lnV == null || lnV === '') ? '—' : String(lnV);
          lnTd.addEventListener('click', toggleDetail);
          tr.appendChild(lnTd);

          var fnV = pickVal(d, firstNameIds);
          var fnTd = document.createElement('td');
          fnTd.className = 'reg-c-first';
          fnTd.style.cssText = cellCss + 'cursor:pointer;';
          fnTd.textContent = (fnV == null || fnV === '') ? '—' : String(fnV);
          fnTd.addEventListener('click', toggleDetail);
          tr.appendChild(fnTd);

          var statusEl = document.createElement('span');
          statusEl.style.cssText = 'font-size:var(--text-xs);color:var(--text-muted);margin-left:0.4rem;';

          var presentTd = document.createElement('td');
          presentTd.className = 'reg-c-cell';
          presentTd.setAttribute('data-label', t('scPresent'));
          presentTd.style.cssText = cellCss + 'text-align:center;';
          var presentCb = document.createElement('input');
          presentCb.type = 'checkbox';
          presentCb.checked = !!state.present;
          presentCb.style.cssText = 'width:18px;height:18px;cursor:pointer;';
          presentCb.addEventListener('change', function() {
            saveScorerField(rowMeta, 'present', presentCb.checked, statusEl);
          });
          presentTd.appendChild(presentCb);
          tr.appendChild(presentTd);

          // Exam result — Yes / No, not a checkbox. A checkbox has two states and the
          // question has three: passed, failed, and nobody has looked yet. The third is
          // the common one, and it must not read as a fail on the SVRZ list.
          //
          // Both answers email the participant, so both confirm first, and the confirm
          // carries an optional note. Clicking the answer already showing clears it back
          // to undecided — the way to undo a mis-click without inventing a third button.
          var resultTd = document.createElement('td');
          resultTd.className = 'reg-c-cell';
          resultTd.setAttribute('data-label', t('scExamPassed'));
          resultTd.style.cssText = cellCss + 'text-align:center;white-space:nowrap;';
          var yesBtn = document.createElement('button');
          var noBtn = document.createElement('button');
          function paintResult() {
            var r = state.exam_result;
            yesBtn.style.cssText = examBtnCss(r === 'passed', '#16a34a');
            noBtn.style.cssText = examBtnCss(r === 'failed', '#dc2626');
            yesBtn.setAttribute('aria-pressed', String(r === 'passed'));
            noBtn.setAttribute('aria-pressed', String(r === 'failed'));
            yesBtn.title = r === 'passed' ? t('scExamClearHint') : t('scExamYesHint');
            noBtn.title = r === 'failed' ? t('scExamClearHint') : t('scExamNoHint');
          }
          function answerExam(answer) {
            // Clicking the current answer again means "I got that wrong" → undecided.
            // Silent: no mail, because the outcome is now nothing, and there is no such
            // mail to send. The mistaken one is already out; only a human can fix that.
            if (state.exam_result === answer) {
              state.exam_result = '';
              paintResult();
              saveScorerField(rowMeta, 'exam_result', null, statusEl);
              return;
            }
            var who = [String(fnV || ''), String(lnV || '')].filter(Boolean).join(' ') || t('scScorerRow');
            // No scoresheet on a pass is the usual sign of a click on the wrong row. On a
            // fail it is unremarkable — not sitting the exam is a reason there is no sheet.
            var msg = (answer === 'passed'
              ? (state.exam_file ? t('scExamPassedConfirm') : t('scExamPassedNoSheet'))
              : t('scExamFailedConfirm')).split('{name}').join(who);
            confirmModalWithNote(msg, {
              danger: answer === 'failed',
              noteField: { label: t('scExamNoteLabel'), placeholder: t('scExamNotePlaceholder') },
            }).then(function(r) {
              if (!r.ok) return;
              state.exam_result = answer;
              paintResult();
              saveScorerField(rowMeta, 'exam_result', answer, statusEl);
              sendExamResultMail(rowMeta, answer, r.note);
            });
          }
          [[yesBtn, 'passed', t('scExamYes')], [noBtn, 'failed', t('scExamNo')]].forEach(function(spec) {
            spec[0].type = 'button';
            spec[0].textContent = spec[2];
            spec[0].addEventListener('click', function() { answerExam(spec[1]); });
            resultTd.appendChild(spec[0]);
          });
          paintResult();
          tr.appendChild(resultTd);

          // Scoresheet — a Matchblatt icon whose colour IS the state: grey nothing, green
          // a sheet, blue a sheet plus a correction. Always a live button, including grey:
          // sheets also arrive by email or on paper, and the cell is where an admin puts
          // one. It opens a menu rather than the file, since once a correction can exist
          // "open" is no longer one unambiguous action.
          var sheetTd = document.createElement('td');
          sheetTd.className = 'reg-c-cell';
          sheetTd.setAttribute('data-label', t('scExamUploaded'));
          sheetTd.style.cssText = cellCss + 'text-align:center;';
          var sheetBtn = document.createElement('button');
          sheetBtn.type = 'button';
          // Static literal, not user data — the row's own values go in via textContent.
          sheetBtn.innerHTML = SHEET_ICON;
          function paintSheet() {
            var corrected = !!state.exam_file_corrected;
            var have = !!state.exam_file;
            sheetBtn.style.cssText = 'background:none;border:none;padding:0.15rem;cursor:pointer;'
              + 'line-height:0;color:' + (corrected ? SHEET_BLUE : (have ? SHEET_GREEN : SHEET_GREY)) + ';';
            var label = corrected
              ? t('scScoresheetCorrectedBy').split('{who}').join(state.exam_file_corrected_by || '?')
              : (have ? t('scScoresheetOpen') : t('scScoresheetMissing'));
            sheetBtn.title = label;
            // The colour carries the meaning, and a screen reader gets none of it.
            sheetBtn.setAttribute('aria-label', label);
          }
          paintSheet();
          sheetBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            // Same name the SVRZ zip uses, falling back to the person when no licence
            // has been entered — so a sheet saved here and the same sheet out of the
            // zip are recognisably the same file.
            openSheetMenu(sheetBtn, rowMeta, state, paintSheet, statusEl, function() {
              var rawSv = svInp ? svInp.value : (state.sv_license || formSv || '');
              var lic = isUnlicensed(rawSv) ? '' : licenceDigits(rawSv);
              var who = [String(lnV || ''), String(fnV || '')].filter(Boolean).join(' ');
              return 'schreiberpruefung_' + safeFileName(lic || who, String(rowMeta.id));
            });
          });
          sheetTd.appendChild(sheetBtn);
          tr.appendChild(sheetTd);

          // SV licence — pre-fill from the form's SVRZ answer when no tracked value yet
          var svTd = document.createElement('td');
          svTd.className = 'reg-c-cell reg-c-sv';
          svTd.setAttribute('data-label', t('scSvLicense'));
          svTd.style.cssText = cellCss;
          var svInp = document.createElement('input');
          svInp.type = 'text';
          var formSv = String(pickVal(d, svrzIds) || '').trim();
          svInp.value = state.sv_license || formSv;
          svInp.placeholder = t('scSvLicense');
          svInp.style.cssText = 'width:110px;padding:0.25rem 0.4rem;font-size:var(--text-sm);background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text-primary);';
          if (!state.sv_license && formSv) svInp.title = t('scSvFromForm');
          svInp.addEventListener('change', function() {
            saveScorerField(rowMeta, 'sv_license', svInp.value.trim(), statusEl);
          });
          svTd.appendChild(svInp);

          // ── cross-check against the member register ──
          //
          // The box above is the participant's own answer until somebody overtypes it,
          // so a licence the club corrected in wiedisync never reaches this screen. When
          // the register knows this person and disagrees, say so and offer the register's
          // value in one click — rather than leaving two numbers to be reconciled by eye
          // across two systems.
          //
          // ⚠ Only ever a SUGGESTION. Most course participants are from other clubs and
          // have no member row at all, and for them the form is the only source there is;
          // silently overwriting would be wrong for the majority of the table.
          var lic = (memberLic[row.slug] || {})[String(row.id)];
          if (lic && lic.licence && licenceDigits(lic.licence) !== licenceDigits(svInp.value)) {
            var fix = document.createElement('button');
            fix.type = 'button';
            fix.className = 'admin-btn admin-btn-sm';
            fix.style.cssText = 'margin-top:0.25rem;font-size:var(--text-xs);padding:0.1rem 0.35rem;';
            fix.textContent = t('scSvUseMember').split('{value}').join(String(lic.licence));
            fix.title = t('scSvMemberDiffers').split('{value}').join(String(lic.licence));
            fix.addEventListener('click', function() {
              svInp.value = String(lic.licence);
              saveScorerField(rowMeta, 'sv_license', svInp.value, statusEl);
              fix.remove();
            });
            svTd.appendChild(fix);
          }
          tr.appendChild(svTd);

          // actions (delete + save status)
          var actTd = document.createElement('td');
          actTd.className = 'reg-c-act';
          actTd.style.cssText = cellCss + 'white-space:nowrap;';
          if (row.id != null) {
            var delBtn = document.createElement('button');
            delBtn.className = 'admin-btn admin-btn-sm admin-btn-danger';
            delBtn.textContent = t('delete');
            delBtn.addEventListener('click', function() {
              confirmModal(t('confirmDelete'), { danger: true, confirmLabel: t('delete') }).then(function(ok) {
                if (!ok) return;
                delBtn.disabled = true;
                wadmin('scorer_courses', 'opnform/forms/' + encodeURIComponent(row.slug) + '/submissions/' + encodeURIComponent(row.id), { method: 'DELETE' })
                  .then(function(res) {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    openScorerCourseInline(courseId); // refresh
                  }).catch(function(err) {
                    delBtn.disabled = false;
                    alert(t('deleteError') + (err && err.message ? err.message : 'unknown'));
                  });
              });
            });
            actTd.appendChild(delBtn);
          }
          actTd.appendChild(statusEl);
          tr.appendChild(actTd);

          tbody.appendChild(tr);

          // ── collapsed detail row: every remaining form answer + KSCW notes ──
          var detailTd = document.createElement('td');
          detailTd.colSpan = COLSPAN;
          detailTd.style.cssText = 'padding:0.5rem 0.9rem 0.85rem 2.1rem;border-bottom:1px solid var(--border);background:rgba(255,255,255,0.02);';
          var dl = document.createElement('div');
          dl.style.cssText = 'display:flex;flex-direction:column;gap:0.3rem;margin-bottom:0.6rem;';
          // Read-only facts about the signup itself — not answers, so not editable.
          function addDetail(label, value) {
            if (value == null || value === '') return;
            var item = document.createElement('div');
            item.style.cssText = 'font-size:var(--text-sm);';
            var lab = document.createElement('span');
            lab.style.cssText = 'color:var(--text-muted);margin-right:0.35rem;';
            lab.textContent = label + ':';
            var val = document.createElement('span');
            val.textContent = value;
            item.appendChild(lab); item.appendChild(val);
            dl.appendChild(item);
          }
          addDetail(t('scColDate'), isoToSwissDateTime(d.created_at));
          if (multi) addDetail(t('scColLang'), row.lang || '');

          // ── every form answer, editable ──
          //
          // Corrections are stored against the attendance row, never pushed back to
          // OpnForm: an update there re-runs StoreFormSubmissionJob, which dispatches
          // FormSubmitted, which is what sends the form's notification emails — so
          // fixing a typo would re-mail the participant and scorer@volleyball.kscw.ch
          // every single time.
          //
          // EVERY field is listed, including the ones already shown as columns
          // (surname, first name, SVRZ): "edit all info" has to mean all of it, and
          // a name typo is the most likely thing to need fixing. The column re-renders
          // from row.data on the next open, and the surname sort follows.
          function addEditable(f) {
            var wrap = document.createElement('div');
            wrap.style.cssText = 'display:flex;align-items:center;gap:0.5rem;font-size:var(--text-sm);flex-wrap:wrap;';
            var lab = document.createElement('span');
            lab.style.cssText = 'color:var(--text-muted);min-width:150px;';
            lab.textContent = f.name + ':';
            var cur = d[f.id];
            var curStr = (cur == null) ? '' : (Array.isArray(cur) ? cur.join(', ') : String(cur));
            var inp;
            if (f.type === 'select' && Array.isArray(f.options) && f.options.length) {
              // Pick from the same list the participant saw. A hand-typed
              // "Teilnahme" is a value the SVRZ export cannot read back.
              inp = document.createElement('select');
              var opts = f.options.slice();
              // Keep whatever is on file selectable even if the form's options
              // have since changed — otherwise opening the row would silently
              // re-point their answer to the first option in the list.
              if (curStr && opts.indexOf(curStr) === -1) opts.unshift(curStr);
              opts.unshift('');
              opts.forEach(function(o) {
                var op = document.createElement('option');
                op.value = o; op.textContent = o || '—';
                if (o === curStr) op.selected = true;
                inp.appendChild(op);
              });
              // Native <option> inherits the select's background, so the dark
              // dropdown needs an explicit solid colour or it renders white.
              inp.style.cssText = 'flex:1;min-width:200px;max-width:420px;padding:0.25rem 0.4rem;font-size:var(--text-sm);background:#1c1c1e;border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text-primary);';
            } else {
              inp = document.createElement('input');
              inp.type = (f.type === 'date' ? 'date' : f.type === 'email' ? 'email' : 'text');
              // A date answer arrives as an ISO timestamp; <input type=date> needs Y-M-D
              // or it silently renders empty — which reads as "they left it blank".
              inp.value = (inp.type === 'date' && curStr) ? curStr.substring(0, 10) : curStr;
              inp.style.cssText = 'flex:1;min-width:200px;max-width:420px;padding:0.25rem 0.4rem;font-size:var(--text-sm);background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text-primary);';
            }
            var origVal = (row.orig || {})[f.id];
            var badge = document.createElement('span');
            badge.style.cssText = 'font-size:var(--text-xs);color:var(--kscw-gold,#b8860b);cursor:pointer;';
            function paintBadge() {
              var edited = Object.prototype.hasOwnProperty.call(row.overrides || {}, f.id);
              badge.textContent = edited ? t('scEdited') : '';
              badge.title = edited
                ? t('scEditedOrig').split('{value}').join((origVal == null || origVal === '') ? '—' : String(origVal))
                : '';
            }
            paintBadge();
            // Click the badge to put the participant's own answer back.
            badge.addEventListener('click', function() {
              if (!Object.prototype.hasOwnProperty.call(row.overrides || {}, f.id)) return;
              var o = (origVal == null) ? '' : (Array.isArray(origVal) ? origVal.join(', ') : String(origVal));
              inp.value = (inp.tagName === 'INPUT' && inp.type === 'date' && o) ? o.substring(0, 10) : o;
              saveScorerOverride(rowMeta, f.id, inp.value, statusEl);
              paintBadge();
            });
            inp.addEventListener('change', function() {
              saveScorerOverride(rowMeta, f.id, inp.value.trim(), statusEl);
              paintBadge();
            });
            wrap.appendChild(lab); wrap.appendChild(inp); wrap.appendChild(badge);
            dl.appendChild(wrap);
          }
          fields.forEach(function(f) {
            // Dividers and other layout blocks are not answers.
            if (!f || /^nf-/.test(String(f.type || '')) || /divider/i.test(String(f.name || ''))) return;
            addEditable(f);
          });
          detailTd.appendChild(dl);

          // Prüfungsdatum — normally stamped by the participant's upload, but kept
          // editable: paper exams and re-sits never pass through the upload page.
          var examWrap = document.createElement('label');
          examWrap.style.cssText = 'display:flex;align-items:center;gap:0.5rem;font-size:var(--text-sm);color:var(--text-muted);margin-bottom:0.5rem;';
          var examLbl = document.createElement('span');
          examLbl.textContent = t('scExamDate') + ':';
          var examInp = document.createElement('input');
          examInp.type = 'date';
          examInp.value = (state.exam_date || '').substring(0, 10);
          examInp.style.cssText = 'padding:0.25rem 0.4rem;font-size:var(--text-sm);background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text-primary);';
          examInp.addEventListener('change', function() {
            saveScorerField(rowMeta, 'exam_date', examInp.value || null, statusEl);
          });
          examWrap.appendChild(examLbl); examWrap.appendChild(examInp);
          detailTd.appendChild(examWrap);

          var noteWrap = document.createElement('label');
          noteWrap.style.cssText = 'display:flex;align-items:center;gap:0.5rem;font-size:var(--text-sm);color:var(--text-muted);';
          var noteLbl = document.createElement('span');
          noteLbl.textContent = t('scNotes') + ':';
          var noteInp = document.createElement('input');
          noteInp.type = 'text';
          noteInp.value = state.notes;
          noteInp.placeholder = t('scNotes');
          noteInp.style.cssText = 'flex:1;max-width:420px;padding:0.25rem 0.4rem;font-size:var(--text-sm);background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text-primary);';
          noteInp.addEventListener('change', function() {
            saveScorerField(rowMeta, 'notes', noteInp.value, statusEl);
          });
          noteWrap.appendChild(noteLbl); noteWrap.appendChild(noteInp);
          detailTd.appendChild(noteWrap);
          detailTr.appendChild(detailTd);
          tbody.appendChild(detailTr);

          exportMetas.push({ row: row, state: state, formSv: formSv, svInp: svInp, noteInp: noteInp, examInp: examInp });
        });

        table.appendChild(tbody);
        wrap.appendChild(table);
        tableHost.appendChild(wrap);

        // Legend — the Matchblatt icon's colour is the only thing carrying its state, and
        // a colour nobody can decode is decoration. Sits under the table, out of the way
        // of the rows but on the same screen as the thing it explains.
        var legend = document.createElement('div');
        legend.style.cssText = 'display:flex;gap:1.2rem;flex-wrap:wrap;align-items:center;'
          + 'margin-top:0.6rem;font-size:var(--text-xs);color:var(--text-muted);';
        [[SHEET_GREY, t('scLegendNone')], [SHEET_GREEN, t('scLegendUploaded')], [SHEET_BLUE, t('scLegendCorrected')]]
          .forEach(function(spec) {
            var e = document.createElement('span');
            e.style.cssText = 'display:inline-flex;align-items:center;gap:0.35rem;';
            var ic = document.createElement('span');
            ic.style.cssText = 'line-height:0;color:' + spec[0] + ';';
            ic.innerHTML = SHEET_ICON; // static literal
            var tx = document.createElement('span');
            tx.textContent = spec[1];
            e.appendChild(ic); e.appendChild(tx);
            legend.appendChild(e);
          });
        tableHost.appendChild(legend);
      }).catch(function(err) {
        summary.textContent = '';
        var errDiv = document.createElement('div');
        errDiv.className = 'admin-empty';
        errDiv.textContent = t('loadError') + (err && err.message ? err.message : 'unknown');
        tableHost.appendChild(errDiv);
      });
    }

    // ── Modal (Create / Edit) ─────────────────────────────────
    function openModal(item) {
      var modal = document.getElementById('admin-modal');
      var isEdit = !!item;
      var isNews = currentTab === 'news';
      var isScorerCourse = currentTab === 'scorer_courses';
      var modalTitle = isEdit ? t('edit') : t('newItem');

      // Build form HTML (all values escaped)
      var formHtml = '<div class="admin-modal-content">' +
        '<div class="admin-modal-header">' +
          '<h2>' + escapeHtml(modalTitle) + '</h2>' +
          '<button class="admin-modal-close" id="modal-close">&times;</button>' +
        '</div>' +
        '<form id="modal-form" class="admin-modal-body">';

      if (currentTab === 'sponsors') {
        // Sponsors form
        formHtml += fieldInput('name', t('sponsorName'), item ? item.name : '', true);
        formHtml += fieldFile('logo', t('sponsorLogo'));
        if (item && item.logo) {
          formHtml += '<div class="admin-field"><img src="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.logo + '?width=200&quality=80') + '" style="max-height:80px;border-radius:var(--radius-md);background:rgba(255,255,255,0.08);padding:4px;"></div>';
        }
        formHtml += fieldInput('website_url', t('sponsorWebsite'), item ? (item.website_url || '') : '');
        formHtml += fieldNumber('sort_order', t('sponsorSortOrder'), item ? item.sort_order : '');
        formHtml += fieldCheckbox('active', t('sponsorActive'), item ? item.active !== false : true, { toggle: true });
        formHtml += fieldCheckbox('team_page_only', t('sponsorTeamPageOnly'), item ? !!item.team_page_only : false, { toggle: true });
      } else if (currentTab === 'scorer_courses') {
        // Scorer-course form
        formHtml += fieldInput('slug_id', t('scSlugId'), item ? (item.slug_id || '') : '', { required: true, placeholder: '2026-07-08-en' });
        formHtml += fieldInput('title_de', t('scTitleDe'), item ? (item.title_de || '') : '', true);
        formHtml += fieldInput('title_en', t('scTitleEn'), item ? (item.title_en || '') : '', true);
        formHtml += fieldDate('date_iso', t('scDateIso'), item ? ((item.date_iso || '').substring(0, 10)) : '');
        formHtml += fieldInput('time', t('scTime'), item ? (item.time || '') : '', { placeholder: '19:30' });
        // Fills the SVRZ Teilnehmerliste header — nothing public reads it.
        formHtml += fieldInput('scorer_expert', t('scScorerExpert'), item ? (item.scorer_expert || '') : '');
        var scModes = [
          { v: 'in_person', l: t('scModeInPerson') },
          { v: 'recorded', l: t('scModeRecorded') },
          { v: 'both', l: t('scModeBoth') },
        ];
        var scModeSel = item ? item.mode : 'in_person';
        var scModeHtml = '<div class="admin-field"><label for="f-mode">' + escapeHtml(t('scMode')) + '</label><select name="mode" id="f-mode">';
        scModes.forEach(function(m) {
          scModeHtml += '<option value="' + escapeAttr(m.v) + '"' + (m.v === scModeSel ? ' selected' : '') + '>' + escapeHtml(m.l) + '</option>';
        });
        scModeHtml += '</select></div>';
        formHtml += scModeHtml;
        // New courses prefill the usual venue/host; saved value is literal —
        // clearing a field hides that line on the public card.
        formHtml += fieldInput('location', t('scLocation'), item ? (item.location || '') : 'Sportanlage Irchel (Theory Room), Winterthurerstrasse 190, 8057 Zürich');
        formHtml += fieldInput('host_note', t('scHostNote'), item ? (item.host_note || '') : 'Hosted by VBC Spada, Powered by KSC Wiedikon');
        formHtml += fieldNumber('duration_hours', t('scDurationHours'), item ? item.duration_hours : 4, { step: '0.5' });
        formHtml += fieldInput('form_slug_de', t('scFormSlugDe'), item ? (item.form_slug_de || '') : '', { placeholder: 'scorer-2026-07-08-de' });
        formHtml += fieldInput('form_slug_en', t('scFormSlugEn'), item ? (item.form_slug_en || '') : '', { placeholder: 'scorer-2026-07-08-en' });
        // Entered as Zurich wall-clock; stored as a UTC instant. Saving mirrors it
        // onto each linked OpnForm's closes_at — the card lock alone is cosmetic,
        // OpnForm is what turns a late submission away. #sc-closes-drift is filled
        // in after render once the live form values come back.
        formHtml += fieldDateTime('registration_closes', t('scRegistrationCloses'),
          item ? isoToZurichInput(item.registration_closes) : '',
          { note: t('scRegistrationClosesHint') });
        formHtml += '<div class="admin-field" id="sc-closes-drift" style="display:none;"></div>';
        formHtml += fieldNumber('sort', t('scSort'), item ? item.sort : 0);
        formHtml += fieldCheckbox('active', t('scActive'), item ? item.active !== false : true, { toggle: true });
      } else {
      // Title with silent auto-translation
      var titleVal = item ? (adminLang === 'en' && item.title_en ? item.title_en : item.title) : '';
      var otherVal = item ? (adminLang === 'de' ? (item.title_en || '') : item.title) : '';
      formHtml += fieldInput('title', t('title'), titleVal, true);

      if (isNews) {
        formHtml += '<input type="hidden" name="title_en" value="' + escapeAttr(otherVal) + '">';
        formHtml += '<input type="hidden" name="slug" value="' + escapeAttr(item ? item.slug : '') + '">';
        formHtml += fieldTextarea('excerpt', t('excerpt'), item ? item.excerpt : '');
        formHtml += '<div class="admin-field"><label>' + t('content') + '</label><div id="quill-editor" style="min-height:200px;"></div></div>';
        formHtml += fieldSelect('category', t('category'), ['club', 'volleyball', 'basketball'], item ? item.category : 'club');
        formHtml += fieldFile('image', t('image'));
        if (item && item.image) {
          formHtml += '<div class="admin-field"><img src="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.image + '?width=200&quality=80') + '" style="max-height:100px;border-radius:var(--radius-md);"></div>';
        }
        formHtml += fieldDate('published_at', t('publishDate'), item ? (item.published_at || '').substring(0, 10) : new Date().toISOString().substring(0, 10));
        formHtml += fieldCheckbox('is_published', t('isPublished'), item ? item.is_published : true, { toggle: true });
      } else {
        // Events form
        formHtml += fieldSelect('event_type', t('type'), ['verein', 'social', 'meeting', 'tournament', 'other'], item ? item.event_type : 'verein');
        formHtml += fieldDate('start_date', t('startDate'), item ? (item.start_date || '').substring(0, 10) : '');
        formHtml += fieldDate('end_date', t('endDate'), item ? (item.end_date || '').substring(0, 10) : '');
        formHtml += fieldCheckbox('all_day', t('allDay'), item ? item.all_day : true);
        formHtml += fieldInput('location', t('location'), item ? (item.location || '') : '');
        formHtml += fieldInput('signup_url', 'Signup link (OpnForm)', item ? (item.signup_url || '') : '', { placeholder: 'https://forms.kscw.ch/forms/...' });
        formHtml += '<div class="admin-field"><label>' + t('description') + '</label><div id="quill-editor" style="min-height:150px;"></div></div>';

        // Participation section
        var hasParticipation = item && (item.respond_by || (item.teams && item.teams.length) || item.max_players || item.min_players || item.require_note_if_absent || (item.required_participants && item.required_participants.length));
        formHtml += fieldCheckbox('participation_required', t('participationRequired'), !!hasParticipation);
        formHtml += '<div id="participation-fields" style="' + (hasParticipation ? '' : 'display:none;') + '">';
        formHtml += fieldDate('respond_by', t('respondBy'), item ? (item.respond_by || '').substring(0, 10) : '');

        // Teams selector (placeholder — filled dynamically)
        formHtml += '<div class="admin-field">' +
          '<label>' + t('teams') + '</label>' +
          '<div class="admin-team-presets" id="team-presets"></div>' +
          '<div class="admin-multiselect-tags" id="teams-tags"></div>' +
          '<div id="teams-dropdown" class="admin-multiselect-dropdown" style="display:none;"></div>' +
          '<input type="hidden" name="teams" value="' + escapeAttr(item && item.teams ? JSON.stringify(item.teams) : '[]') + '">' +
        '</div>';

        formHtml += fieldNumber('min_players', t('minParticipants'), item ? item.min_players : '');
        formHtml += fieldNumber('max_players', t('maxParticipants'), item ? item.max_players : '');
        formHtml += fieldCheckbox('require_note_if_absent', t('requireNoteIfAbsent'), item ? !!item.require_note_if_absent : false, { toggle: true });

        // Required participants (multi-search select — filled dynamically)
        formHtml += '<div class="admin-field">' +
          '<label>' + t('requiredParticipants') + '</label>' +
          '<input type="text" id="member-search" placeholder="' + t('search') + '" autocomplete="off">' +
          '<div class="admin-multiselect-tags" id="members-tags"></div>' +
          '<div id="members-dropdown" class="admin-multiselect-dropdown" style="display:none;"></div>' +
          '<input type="hidden" name="required_participants" value="' + escapeAttr(item && item.required_participants ? JSON.stringify(item.required_participants) : '[]') + '">' +
        '</div>';

        formHtml += '</div>'; // close participation-fields
      }
      } // close news/events else branch

      formHtml += '<div class="admin-modal-footer">' +
          '<button type="button" class="admin-btn" id="modal-cancel">' + t('cancel') + '</button>' +
          '<button type="submit" class="admin-btn admin-btn-primary" id="modal-save">' + t('save') + '</button>' +
        '</div>' +
        '</form>' +
      '</div>';

      // Form HTML is built from escaped values (escapeHtml/escapeAttr) — safe to set directly.
      // DOMPurify strips form attributes (name, type, value) which breaks form submission.
      // User-generated content (Quill editor) is sanitized separately on save.
      modal.innerHTML = formHtml;
      modal.style.display = 'flex';

      // Show what each linked OpnForm currently closes at. The course field is the
      // source of truth and saving overwrites the forms, so this is purely a heads-up
      // for the case where someone edited the deadline in OpnForm directly — better a
      // visible disagreement than two writers silently racing.
      if (isScorerCourse && item) {
        renderClosesDrift(item);
      }

      // Initialize Quill (not used for sponsors)
      quillInstance = null;
      var editorEl = currentTab !== 'sponsors' ? document.getElementById('quill-editor') : null;
      if (editorEl) {
        quillInstance = new Quill(editorEl, {
          theme: 'snow',
          modules: {
            toolbar: [
              [{ header: [2, 3, false] }],
              ['bold', 'italic', 'underline'],
              [{ align: [] }],
              [{ list: 'ordered' }, { list: 'bullet' }],
              ['link', 'image'],
              ['clean']
            ]
          }
        });
        var bodyContent = isNews ? (item ? item.body : '') : (item ? item.description : '');
        if (bodyContent) {
          quillInstance.clipboard.dangerouslyPasteHTML(DOMPurify.sanitize(bodyContent));
        }
      }

      // Auto-generate slug + silent auto-translate title (news only, skip for sponsors)
      if (isNews && currentTab !== 'sponsors') {
        var titleInput = document.querySelector('#modal-form [name="title"]');
        var slugInput = document.querySelector('#modal-form [name="slug"]');
        var titleEnInput = document.querySelector('#modal-form [name="title_en"]');
        var translateTimer = null;

        function generateSlug(text) {
          return text.toLowerCase()
            .replace(/[äÄ]/g, 'ae').replace(/[öÖ]/g, 'oe').replace(/[üÜ]/g, 'ue').replace(/[ß]/g, 'ss')
            .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        }

        function autoTranslate(text) {
          if (!text || text.length < 3) { titleEnInput.value = ''; return; }
          var tgtLang = adminLang === 'de' ? 'en' : 'de';
          // WEB-SEC-5 / WEB-ADM-6 (info, accepted): the admin-typed news/event
          // title is sent to api.mymemory.translated.net (third party) for
          // auto-translation. This is a conscious choice — titles are published
          // publicly anyway, so there is no confidential data leaving the admin.
          fetch('https://api.mymemory.translated.net/get?q=' + encodeURIComponent(text) + '&langpair=' + adminLang + '|' + tgtLang)
            .then(function(r) { return r.json(); })
            .then(function(data) {
              var translated = data.responseData && data.responseData.translatedText;
              if (translated) {
                if (translated === translated.toUpperCase() && text !== text.toUpperCase()) {
                  translated = translated.charAt(0).toUpperCase() + translated.slice(1).toLowerCase();
                }
                titleEnInput.value = translated;
              }
            })
            .catch(function() { /* silent fail */ });
        }

        if (titleInput) {
          titleInput.addEventListener('input', function() {
            if (!isEdit && slugInput) {
              slugInput.value = generateSlug(this.value);
            }
            clearTimeout(translateTimer);
            translateTimer = setTimeout(function() {
              autoTranslate(titleInput.value.trim());
            }, 600);
          });
        }

        // Translate on load if editing and no translation exists yet
        if (isEdit && titleInput && titleInput.value && !titleEnInput.value) {
          autoTranslate(titleInput.value.trim());
        }
      }

      // ── Participation toggle (events only) ───────────────────
      if (!isNews && !isScorerCourse && currentTab !== 'sponsors') {
        var partCheck = document.querySelector('[name="participation_required"]');
        var partFields = document.getElementById('participation-fields');
        if (partCheck && partFields) {
          partCheck.addEventListener('change', function() {
            partFields.style.display = this.checked ? '' : 'none';
          });
        }
        initTeamsSelector(item);
        initMembersSelector(item);
      }

      // Close handlers
      document.getElementById('modal-close').addEventListener('click', closeModal);
      document.getElementById('modal-cancel').addEventListener('click', closeModal);
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
      });

      // Submit handler
      document.getElementById('modal-form').addEventListener('submit', function(e) {
        e.preventDefault();
        saveItem(item);
      });
    }

    function closeModal() {
      var modal = document.getElementById('admin-modal');
      modal.style.display = 'none';
      modal.textContent = '';
      quillInstance = null;
    }

    // ── Confirm dialog ─────────────────────────────────────────
    // Promise-based stand-in for window.confirm — resolves true on confirm,
    // false on cancel, Escape or a backdrop click.
    //
    // Builds its own overlay instead of reusing the shared #admin-modal: half
    // the callers confirm from inside an already-open modal (the responses
    // table), and rendering into that container would tear down the very table
    // the caller returns to on cancel.
    //
    // opts: { title, confirmLabel, cancelLabel, danger }
    // Resolves { ok, note }. Prefer confirmModal (plain boolean) unless you need the note
    // — see the wrapper below for why the two return shapes stay separate.
    function buildConfirm(message, opts) {
      var o = opts || {};
      return new Promise(function(resolve) {
        var overlay = document.createElement('div');
        overlay.className = 'admin-modal-overlay admin-confirm-overlay';
        overlay.style.display = 'flex';

        var content = document.createElement('div');
        content.className = 'admin-modal-content admin-confirm-content';

        var header = document.createElement('div');
        header.className = 'admin-modal-header';
        var heading = document.createElement('h2');
        heading.textContent = o.title || t('confirmTitle');
        header.appendChild(heading);

        var body = document.createElement('div');
        body.className = 'admin-modal-body';
        // A message can carry a participant name straight from a public OpnForm
        // submission, so it is set as text, never as markup. pre-wrap preserves
        // the blank line these strings use to separate question from consequence.
        body.style.whiteSpace = 'pre-wrap';
        body.textContent = message == null ? '' : String(message);

        // Optional note — written in the same breath as the decision, and sent with the
        // mail the decision triggers. Server-side escaped before it reaches the HTML
        // (wadmin.js): admin-authored is not the same as safe.
        var noteInp = null;
        if (o.noteField) {
          var noteWrap = document.createElement('div');
          noteWrap.style.cssText = 'margin-top:1rem;white-space:normal;';
          var noteLbl = document.createElement('label');
          noteLbl.textContent = o.noteField.label || '';
          noteLbl.style.cssText = 'display:block;margin-bottom:0.35rem;font-size:var(--text-sm);color:var(--text-muted);';
          noteInp = document.createElement('textarea');
          noteInp.rows = 4;
          noteInp.placeholder = o.noteField.placeholder || '';
          noteInp.style.cssText = 'width:100%;padding:0.5rem;font:inherit;font-size:var(--text-sm);'
            + 'background:rgba(255,255,255,0.04);border:1px solid var(--border);'
            + 'border-radius:var(--radius-sm);color:var(--text-primary);resize:vertical;';
          noteLbl.setAttribute('for', 'admin-confirm-note');
          noteInp.id = 'admin-confirm-note';
          noteWrap.appendChild(noteLbl);
          noteWrap.appendChild(noteInp);
          body.appendChild(noteWrap);
        }

        var footer = document.createElement('div');
        footer.className = 'admin-modal-footer';
        var cancelBtn = document.createElement('button');
        cancelBtn.type = 'button';
        cancelBtn.className = 'admin-btn';
        cancelBtn.textContent = o.cancelLabel || t('cancel');
        var okBtn = document.createElement('button');
        okBtn.type = 'button';
        okBtn.className = 'admin-btn ' + (o.danger ? 'admin-btn-danger' : 'admin-btn-primary');
        okBtn.textContent = o.confirmLabel || t('confirmOk');
        footer.appendChild(cancelBtn);
        footer.appendChild(okBtn);

        content.appendChild(header);
        content.appendChild(body);
        content.appendChild(footer);
        overlay.appendChild(content);
        document.body.appendChild(overlay);

        var lastFocus = document.activeElement;
        var settled = false;
        function finish(result) {
          if (settled) return;
          settled = true;
          document.removeEventListener('keydown', onKey);
          // Read the note BEFORE the overlay leaves the DOM, or it reads back empty.
          var note = noteInp ? noteInp.value.trim() : '';
          overlay.remove();
          if (lastFocus && lastFocus.focus) lastFocus.focus();
          resolve({ ok: result, note: result ? note : '' });
        }
        function onKey(e) {
          if (e.key === 'Escape') { e.preventDefault(); finish(false); }
          // Enter confirms — except inside the note, where it has to mean "new line".
          // Without this, typing a second sentence sends the mail instead.
          else if (e.key === 'Enter' && e.target !== noteInp) { e.preventDefault(); finish(true); }
        }
        document.addEventListener('keydown', onKey);
        cancelBtn.addEventListener('click', function() { finish(false); });
        okBtn.addEventListener('click', function() { finish(true); });
        overlay.addEventListener('click', function(e) { if (e.target === overlay) finish(false); });
        okBtn.focus();
      });
    }

    // The two shapes stay separate on purpose. If confirmModal returned { ok, note }, every
    // existing `.then(function(ok) { if (!ok) return; })` would keep working — an object is
    // always truthy — and would silently treat Cancel as Confirm. A boolean caller gets a
    // boolean.
    function confirmModal(message, opts) {
      return buildConfirm(message, opts).then(function(r) { return r.ok; });
    }
    function confirmModalWithNote(message, opts) {
      return buildConfirm(message, opts);
    }

    // ── OpnForm responses (admin) ──────────────────────────────
    // `sources` is either a bare slug string (single form, e.g. events) or
    // an array of { slug, lang } (e.g. a scorer course's DE+EN form pair).
    // DE/EN duplicate forms share field IDs, so rows merge cleanly by id;
    // a Lang column is shown only when more than one source is present.
    function openResponsesModal(sources, eventTitle) {
      var srcList = (Array.isArray(sources) ? sources : [{ slug: sources, lang: '' }])
        .map(function(s) { return { slug: normalizeFormSlug(s && s.slug != null ? s.slug : s), lang: (s && s.lang) || '' }; })
        .filter(function(s) { return !!s.slug; });
      // de-dupe by slug
      var seenSlug = {};
      srcList = srcList.filter(function(s) { if (seenSlug[s.slug]) return false; seenSlug[s.slug] = 1; return true; });
      var multi = srcList.length > 1;

      var modal = document.getElementById('admin-modal');
      modal.textContent = '';
      var content = document.createElement('div');
      content.className = 'admin-modal-content';
      content.style.maxWidth = '90vw';
      var hdr = document.createElement('div');
      hdr.className = 'admin-modal-header';
      var h2 = document.createElement('h2');
      h2.textContent = 'Signups — ' + (eventTitle || '');
      hdr.appendChild(h2);
      var closeBtn = document.createElement('button');
      closeBtn.className = 'admin-modal-close';
      closeBtn.textContent = '×';
      closeBtn.addEventListener('click', closeModal);
      hdr.appendChild(closeBtn);
      content.appendChild(hdr);
      var body = document.createElement('div');
      body.id = 'resp-body';
      body.style.cssText = 'padding:1rem;min-height:120px;overflow-y:auto;flex:1 1 auto;';
      var loading = document.createElement('div');
      loading.className = 'admin-empty';
      loading.textContent = 'Loading…';
      body.appendChild(loading);
      content.appendChild(body);
      modal.appendChild(content);
      modal.style.display = 'flex';

      if (!srcList.length) {
        body.textContent = '';
        var none = document.createElement('div');
        none.className = 'admin-empty';
        none.textContent = 'No form linked.';
        body.appendChild(none);
        return;
      }

      Promise.all(srcList.map(function(src) {
        return wadmin('scorer_courses', 'opnform/forms/' + encodeURIComponent(src.slug) + '/submissions?per_page=100', {})
          .then(function(res) {
            if (!res.ok) return { src: src, error: 'HTTP ' + res.status };
            return res.json().then(function(p) { return { src: src, payload: p }; });
          }).catch(function(e) { return { src: src, error: (e && e.message) || 'error' }; });
      })).then(function(results) {
        body.textContent = '';

        // Unified field set keyed by id (DE/EN share ids); first label wins.
        var fields = [];
        var byId = {};
        var mergedRows = [];
        var errors = [];
        results.forEach(function(rr) {
          if (rr.error) { errors.push(rr.src.slug + ': ' + rr.error); return; }
          var p = rr.payload || {};
          (p.fields || []).forEach(function(f) {
            if (!f || typeof f.type !== 'string' || f.type.indexOf('nf-') === 0) return;
            if (!byId[f.id]) { byId[f.id] = f; fields.push(f); }
          });
          (p.data || []).forEach(function(r) {
            var d = (r && r.data) || r || {};
            mergedRows.push({
              data: d,
              id: (r && r.id != null) ? r.id : d.id,
              slug: rr.src.slug,
              lang: rr.src.lang,
            });
          });
        });
        mergedRows.sort(function(a, b) {
          return String(b.data.created_at || '').localeCompare(String(a.data.created_at || ''));
        });
        var total = mergedRows.length;

        var header = document.createElement('div');
        header.style.cssText = 'display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;gap:0.75rem;flex-wrap:wrap;';
        var summary = document.createElement('div');
        summary.style.cssText = 'font-size:var(--text-sm);color:var(--text-muted);';
        summary.textContent = total + ' response' + (total === 1 ? '' : 's')
          + (multi ? ' (' + srcList.map(function(s) { return s.lang || s.slug; }).join(' + ') + ')' : '');
        header.appendChild(summary);
        if (total > 0) {
          var csvBtn = document.createElement('button');
          csvBtn.className = 'admin-btn admin-btn-sm admin-btn-primary';
          csvBtn.textContent = 'Export TSV';
          csvBtn.addEventListener('click', function() {
            exportResponsesCSV(multi ? 'combined' : srcList[0].slug, fields, mergedRows, multi);
          });
          header.appendChild(csvBtn);
        }
        body.appendChild(header);

        if (errors.length) {
          var warn = document.createElement('div');
          warn.className = 'admin-empty';
          warn.style.cssText = 'color:#dc2626;margin-bottom:0.5rem;';
          warn.textContent = 'Could not load: ' + errors.join('; ');
          body.appendChild(warn);
        }

        if (!mergedRows.length) {
          if (!errors.length) {
            var empty = document.createElement('div');
            empty.className = 'admin-empty';
            empty.textContent = 'No signups yet.';
            body.appendChild(empty);
          }
          return;
        }

        var tableWrap = document.createElement('div');
        tableWrap.className = 'admin-scroll-x admin-scroll-framed';
        var table = document.createElement('table');
        table.style.cssText = 'width:100%;border-collapse:collapse;font-size:var(--text-sm);';
        var thead = document.createElement('thead');
        var thRow = document.createElement('tr');
        var headLabels = ['Date'].concat(multi ? ['Lang'] : []).concat(fields.map(function(f) { return f.name; }));
        headLabels.forEach(function(label) {
          var th = document.createElement('th');
          th.textContent = label;
          th.style.cssText = 'text-align:left;padding:0.5rem 0.75rem;border-bottom:1px solid var(--border);background:rgba(255,255,255,0.04);font-weight:600;white-space:nowrap;';
          thRow.appendChild(th);
        });
        var thAct = document.createElement('th');
        thAct.style.cssText = 'padding:0.5rem 0.75rem;border-bottom:1px solid var(--border);background:rgba(255,255,255,0.04);';
        thRow.appendChild(thAct);
        thead.appendChild(thRow);
        table.appendChild(thead);
        var tbody = document.createElement('tbody');
        mergedRows.forEach(function(row) {
          var d = row.data;
          var tr = document.createElement('tr');
          var dateTd = document.createElement('td');
          dateTd.textContent = isoToSwissDateTime(d.created_at);
          dateTd.style.cssText = 'padding:0.5rem 0.75rem;border-bottom:1px solid var(--border);color:var(--text-muted);white-space:nowrap;';
          tr.appendChild(dateTd);
          if (multi) {
            var langTd = document.createElement('td');
            langTd.textContent = row.lang || '';
            langTd.style.cssText = 'padding:0.5rem 0.75rem;border-bottom:1px solid var(--border);font-weight:600;white-space:nowrap;';
            tr.appendChild(langTd);
          }
          fields.forEach(function(f) {
            var td = document.createElement('td');
            var v = d[f.id];
            td.textContent = (v == null || v === '') ? '—' : fmtAnswer(f, v);
            td.style.cssText = 'padding:0.5rem 0.75rem;border-bottom:1px solid var(--border);';
            tr.appendChild(td);
          });
          var actTd = document.createElement('td');
          actTd.style.cssText = 'padding:0.5rem 0.75rem;border-bottom:1px solid var(--border);white-space:nowrap;';
          if (row.id != null) {
            var delBtn = document.createElement('button');
            delBtn.className = 'admin-btn admin-btn-sm admin-btn-danger';
            delBtn.textContent = t('delete');
            delBtn.addEventListener('click', function() {
              confirmModal(t('confirmDelete'), { danger: true, confirmLabel: t('delete') }).then(function(ok) {
                if (!ok) return;
                delBtn.disabled = true;
                wadmin('scorer_courses', 'opnform/forms/' + encodeURIComponent(row.slug) + '/submissions/' + encodeURIComponent(row.id), { method: 'DELETE' })
                  .then(function(res) {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    openResponsesModal(sources, eventTitle); // refresh
                  }).catch(function(err) {
                    delBtn.disabled = false;
                    alert(t('deleteError') + (err && err.message ? err.message : 'unknown'));
                  });
              });
            });
            actTd.appendChild(delBtn);
          }
          tr.appendChild(actTd);
          tbody.appendChild(tr);
        });
        table.appendChild(tbody);
        tableWrap.appendChild(table);
        body.appendChild(tableWrap);
      }).catch(function(err) {
        body.textContent = '';
        var errDiv = document.createElement('div');
        errDiv.className = 'admin-empty';
        errDiv.textContent = 'Error loading: ' + (err && err.message ? err.message : 'unknown');
        body.appendChild(errDiv);
      });
    }

    // Tab-separated, not comma: free-text answers (address, notes) contain
    // commas that would otherwise spill into the next column on import.
    // Tabs/newlines inside a value are flattened to spaces so one field
    // can never break the row/column grid.
    function tsvEscape(val) {
      return String(val == null ? '' : val).replace(/[\t\r\n]+/g, ' ').trim();
    }
    function downloadBlob(blob, filename) {
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.style.display = 'none';
      document.body.appendChild(a);
      a.click();
      // The object URL has to outlive the click. Revoking it on the same tick
      // races the browser writing the file and truncates the result — worse the
      // larger it is, and this helper carries the SVRZ bundle (every scoresheet
      // in one zip) as well as individual scoresheet PDFs. Same reason
      // openScoresheet() holds its URL for a minute.
      setTimeout(function() {
        try { document.body.removeChild(a); } catch(e) {}
        URL.revokeObjectURL(url);
      }, 60000);
    }
    // headers: string[]; rows: (string|boolean)[][] — booleans render as Ja/Nein.
    function exportRowsTSV(nameBase, headers, rows) {
      var lines = [headers.map(tsvEscape).join('\t')];
      rows.forEach(function(r) {
        lines.push(r.map(function(v) {
          return tsvEscape(typeof v === 'boolean' ? (v ? t('scYes') : t('scNo')) : v);
        }).join('\t'));
      });
      // Leading BOM: Excel/Numbers otherwise read the UTF-8 as latin-1 (Dürig → DÃ¼rig).
      var blob = new Blob(['﻿' + lines.join('\r\n')], { type: 'text/tab-separated-values;charset=utf-8;' });
      downloadBlob(blob, 'anmeldungen-' + nameBase + '.tsv');
    }
    function exportResponsesCSV(nameBase, fields, rows, withLang) {
      var headers = ['date_iso'].concat(withLang ? ['lang'] : []).concat(fields.map(function(f) { return f.name; }));
      exportRowsTSV(nameBase, headers, rows.map(function(r) {
        var d = (r && r.data) || r || {};
        return [d.created_at || ''].concat(withLang ? [r.lang || ''] : []).concat(fields.map(function(f) {
          return fmtAnswer(f, d[f.id]);
