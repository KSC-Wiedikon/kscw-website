    // ── Admin Dashboard ───────────────────────────────────────
    async function renderAdmin() {
      await loadAccess();

      if (!adminAccess.isSuperuser && adminAccess.sections.length === 0) {
        var shell = document.createElement('div');
        shell.className = 'admin-shell';
        var empty = document.createElement('div');
        empty.className = 'admin-empty';
        empty.textContent = 'No sections assigned — ask a superuser to grant access.';
        shell.appendChild(empty);
        app.replaceChildren(shell);
        return;
      }

      var TAB_LABELS = {
        news: 'News', events: 'Events',
        registrations: t('registrations'), sponsors: t('sponsors'),
        scorer_courses: t('scorerCourses'), mixed_turnier: t('mixedTurnier'),
      };
      var visibleSections = SECTION_ORDER.filter(function(s) {
        return adminAccess.isSuperuser || adminAccess.sections.indexOf(s) !== -1;
      });
      if (visibleSections.indexOf(currentTab) === -1) {
        currentTab = visibleSections.length ? visibleSections[0] : '';
      }
      var tabsHtml = visibleSections.map(function(s) {
        return '<button class="admin-tab' + (currentTab === s ? ' active' : '') +
          '" data-tab="' + s + '">' + escapeHtml(TAB_LABELS[s]) + '</button>';
      }).join('');

      setAppContent(
        '<div class="admin-shell">' +
          '<header class="admin-header">' +
            '<div class="admin-header-inner">' +
              '<a href="/" class="admin-logo">' +
                '<img src="/images/kscw_trio.png" alt="" style="height:32px;">' +
                '<span style="line-height:1.1;font-size:0.85em;">Website<br>Admin</span>' +
              '</a>' +
              '<div class="admin-header-actions">' +
                '<button class="admin-btn admin-btn-ghost" id="logout-btn">' + t('logout') + '</button>' +
              '</div>' +
            '</div>' +
          '</header>' +
          '<div class="admin-tabs">' + tabsHtml +
          (adminAccess.isSuperuser ? '<button class="admin-tab' + (currentTab === 'admin' ? ' active' : '') + '" data-tab="admin">Admin</button>' : '') +
          '</div>' +
          '<div class="admin-content" id="admin-content"></div>' +
          '<button class="admin-fab" id="fab-btn" title="' + t('create') + '">+</button>' +
        '</div>'
      );

      // Modal container
      var modalDiv = document.createElement('div');
      modalDiv.id = 'admin-modal';
      modalDiv.className = 'admin-modal-overlay';
      modalDiv.style.display = 'none';
      app.appendChild(modalDiv);

      document.getElementById('logout-btn').addEventListener('click', function() {
        sessionStorage.removeItem(AUTH_KEY);
        render();
      });

      document.querySelectorAll('.admin-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
          currentTab = this.getAttribute('data-tab');
          document.querySelectorAll('.admin-tab').forEach(function(t) { t.classList.remove('active'); });
          this.classList.add('active');
          // Hide FAB for registrations (no manual creation)
          document.getElementById('fab-btn').style.display = (currentTab === 'registrations' || currentTab === 'mixed_turnier') ? 'none' : '';
          loadItems();
        });
      });

      document.getElementById('fab-btn').addEventListener('click', function() {
        openModal(null);
      });

      loadItems();
    }

    // ── Load Items ────────────────────────────────────────────
    function loadItems() {
      var content = document.getElementById('admin-content');
      content.textContent = '';
      var loadingDiv = document.createElement('div');
      loadingDiv.className = 'admin-loading';
      loadingDiv.textContent = t('loading');
      content.appendChild(loadingDiv);

      // ── Registrations tab ──
      if (currentTab === 'registrations') {
        var regStatusFilter = window._regStatusFilter || 'pending';
        wadmin('registrations', 'items/registrations'
            + '?filter[status][_eq]=' + regStatusFilter
            + '&sort=-submitted_at&limit=50', {})
          .then(function(r) { return r.json(); })
          .then(function(data) {
            renderRegistrationsList(data.data || [], regStatusFilter);
          })
          .catch(function(err) {
            content.textContent = '';
            var errDiv = document.createElement('div');
            errDiv.className = 'admin-error';
            errDiv.textContent = t('loadError') + err.message;
            content.appendChild(errDiv);
          });
        return;
      }

      // ── Mixed Turnier tab ── (combined: website signups + Wiedisync participations)
      if (currentTab === 'mixed_turnier') {
        Promise.all([
          wadmin('mixed_turnier', 'items/mixed_tournament_signups?sort=-date_created&limit=-1', {})
            .then(function(r) { return r.json(); }),
          wadmin('mixed_turnier', 'items/participations?filter[activity_type][_eq]=event&filter[activity_id][_eq]=5&fields=id,member,status,note,date_created&limit=-1', {})
            .then(function(r) { return r.json(); }),
          wadmin('mixed_turnier', 'items/members?fields=id,first_name,last_name,sex&limit=-1', {})
            .then(function(r) { return r.json(); })
        ]).then(function(results) {
            var signups = results[0].data || [];
            var participations = results[1].data || [];
            var members = results[2].data || [];
            renderMixedTurnierList(signups, participations, members);
          })
          .catch(function(err) {
            content.textContent = '';
            var errDiv = document.createElement('div');
            errDiv.className = 'admin-error';
            errDiv.textContent = t('loadError') + err.message;
            content.appendChild(errDiv);
          });
        return;
      }

      // ── Sponsors tab ──
      if (currentTab === 'sponsors') {
        wadmin('sponsors', 'items/sponsors?sort=sort_order&limit=-1', {})
          .then(function(r) { return r.json(); })
          .then(function(data) {
            renderSponsorsList(data.data || []);
          })
          .catch(function(err) {
            content.textContent = '';
            var errDiv = document.createElement('div');
            errDiv.className = 'admin-error';
            errDiv.textContent = t('loadError') + err.message;
            content.appendChild(errDiv);
          });
        return;
      }

      // ── Scorer courses tab ──
      if (currentTab === 'scorer_courses') {
        wadmin('scorer_courses', 'items/scorer_courses?sort=sort,date_iso&limit=-1', {})
          .then(function(r) { return r.json(); })
          .then(function(data) {
            renderScorerCoursesList(data.data || []);
          })
          .catch(function(err) {
            content.textContent = '';
            var errDiv = document.createElement('div');
            errDiv.className = 'admin-error';
            errDiv.textContent = t('loadError') + err.message;
            content.appendChild(errDiv);
          });
        return;
      }

      // ── Admin (section grant grid) tab — superuser only ──
      if (currentTab === 'admin' && adminAccess.isSuperuser) {
        var host = content;
        host.replaceChildren();
        var loading = document.createElement('div');
        loading.className = 'admin-grid-loading';
        loading.textContent = 'Loading…';
        host.appendChild(loading);
        getValidToken().then(function(token) {
          return fetch(DIRECTUS_URL + '/kscw/wadmin/admins', {
            headers: { 'Authorization': 'Bearer ' + token },
          });
        }).then(function(r) { return r.ok ? r.json() : { _loadError: true }; }).then(function(j) {
          var rows = (j && j.data) || [];
          host.replaceChildren();
          if (j && j._loadError) {
            var errDiv = document.createElement('div');
            errDiv.className = 'admin-empty';
            errDiv.textContent = 'Failed to load — try refreshing.';
            host.appendChild(errDiv);
            return;
          }
          if (!rows.length) {
            var em = document.createElement('div');
            em.className = 'admin-empty';
            em.textContent = 'No Website Admin users yet. (Users gain this role in the Phase C migration.)';
            host.appendChild(em);
            return;
          }
          var table = document.createElement('table');
          table.className = 'admin-grant-grid';
          var thead = document.createElement('tr');
          var th0 = document.createElement('th');
          th0.textContent = 'User';
          thead.appendChild(th0);
          SECTION_ORDER.forEach(function(s) {
            var th = document.createElement('th');
            th.textContent = s;
            thead.appendChild(th);
          });
          table.appendChild(thead);
          rows.forEach(function(u) {
            var tr = document.createElement('tr');
            var td0 = document.createElement('td');
            var nameDiv = document.createElement('div');
            nameDiv.textContent = u.name;
            var emailSmall = document.createElement('small');
            emailSmall.textContent = u.email;
            td0.appendChild(nameDiv);
            td0.appendChild(emailSmall);
            tr.appendChild(td0);
            SECTION_ORDER.forEach(function(s) {
              var td = document.createElement('td');
              var cb = document.createElement('input');
              cb.type = 'checkbox';
              cb.checked = u.sections.indexOf(s) !== -1;
              cb.setAttribute('data-uid', u.id);
              cb.setAttribute('data-sec', s);
              td.appendChild(cb);
              tr.appendChild(td);
            });
            table.appendChild(tr);
          });
          var status = document.createElement('div');
          status.className = 'admin-grant-status';
          status.id = 'grant-status';
          host.appendChild(table);
          host.appendChild(status);
          bindGrantGrid(host, rows);
        });
        return;
      }

      var collection = currentTab === 'news' ? 'news' : 'events';
      var sort = currentTab === 'news' ? '-published_at' : '-start_date';

      wadmin(collection, 'items/' + collection + '?sort=' + sort + '&limit=50', {})
        .then(function(res) { return res.json(); })
        .then(function(result) {
          var items = result.data || [];
          content.textContent = '';

          if (!items.length) {
            var emptyDiv = document.createElement('div');
            emptyDiv.className = 'admin-empty';
            emptyDiv.textContent = t('noEntries');
            content.appendChild(emptyDiv);
            return;
          }

          var list = document.createElement('div');
          list.className = 'admin-list';

          items.forEach(function(item) {
            var date = currentTab === 'news'
              ? (item.published_at || item.created || '').substring(0, 10)
              : (item.start_date || '').substring(0, 10);
            var title = item.title || t('noTitle');
            var category = currentTab === 'news' ? (item.category || '') : (item.event_type || '');

            var row = document.createElement('div');
            row.className = 'admin-list-item';

            // Info section
            var info = document.createElement('div');
            info.className = 'admin-list-info';

            var h3 = document.createElement('h3');
            h3.className = 'admin-list-title';
            h3.textContent = title;
            info.appendChild(h3);

            var meta = document.createElement('div');
            meta.className = 'admin-list-meta';
            var dateSpan = document.createElement('span');
            dateSpan.textContent = date;
            meta.appendChild(dateSpan);
            if (category) {
              var catBadge = document.createElement('span');
              catBadge.className = 'admin-badge';
              catBadge.textContent = category.charAt(0).toUpperCase() + category.slice(1);
              meta.appendChild(catBadge);
            }
            if (currentTab === 'news') {
              var statusBadge = document.createElement('span');
              statusBadge.className = item.is_published ? 'admin-badge admin-badge-green' : 'admin-badge admin-badge-gray';
              statusBadge.textContent = item.is_published ? t('published') : t('draft');
              meta.appendChild(statusBadge);
            }
            info.appendChild(meta);
            row.appendChild(info);

            // Actions
            var actions = document.createElement('div');
            actions.className = 'admin-list-actions';

            // Responses button (events only, when signup_url set)
            if (currentTab === 'events' && item.signup_url) {
              var slugMatch = String(item.signup_url).match(/\/forms\/([a-z0-9][a-z0-9-]{0,80})/i);
              if (slugMatch) {
                var respBtn = document.createElement('button');
                respBtn.className = 'admin-btn admin-btn-sm';
                respBtn.textContent = 'Signups';
                respBtn.addEventListener('click', (function(slug, eventTitle) {
                  return function() { openResponsesModal(slug, eventTitle); };
                })(slugMatch[1], title));
                actions.appendChild(respBtn);
              }
            }

            var editBtn = document.createElement('button');
            editBtn.className = 'admin-btn admin-btn-sm';
            editBtn.textContent = t('edit');
            editBtn.addEventListener('click', function() {
              wadmin(collection, 'items/' + collection + '/' + item.id, {})
                .then(function(res) { return res.json(); })
                .then(function(data) { openModal(data.data); });
            });
            actions.appendChild(editBtn);

            // Archive / Publish toggle (news only): one-click unpublish, reversible
            if (currentTab === 'news') {
              var willArchive = !!item.is_published;
              var archiveBtn = document.createElement('button');
              archiveBtn.className = 'admin-btn admin-btn-sm';
              archiveBtn.textContent = willArchive ? t('archive') : t('publish');
              archiveBtn.addEventListener('click', function() {
                if (!confirm(willArchive ? t('confirmArchive') : t('confirmPublish'))) return;
                archiveBtn.disabled = true;
                wadmin(collection, 'items/' + collection + '/' + item.id, {
                  method: 'PATCH',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ is_published: !willArchive }),
                })
                  .then(function(res) {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    loadItems();
                  })
                  .catch(function(err) {
                    archiveBtn.disabled = false;
                    alert(t('archiveError') + err.message);
                  });
              });
              actions.appendChild(archiveBtn);
            }

            var deleteBtn = document.createElement('button');
            deleteBtn.className = 'admin-btn admin-btn-sm admin-btn-danger';
            deleteBtn.textContent = t('delete');
            deleteBtn.addEventListener('click', function() {
              if (confirm(t('confirmDelete'))) {
                wadmin(collection, 'items/' + collection + '/' + item.id, { method: 'DELETE' })
                  .then(function(res) {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    loadItems();
                  }).catch(function(err) { alert(t('deleteError') + err.message); });
              }
            });
            actions.appendChild(deleteBtn);

            row.appendChild(actions);
            list.appendChild(row);
          });

          content.appendChild(list);
        })
        .catch(function(err) {
          content.textContent = '';
          var errDiv = document.createElement('div');
          errDiv.className = 'admin-error';
          errDiv.textContent = t('loadError') + err.message;
          content.appendChild(errDiv);
        });
    }

    // ── Registrations List ──────────────────────────────────────
    function renderRegistrationsList(items, statusFilter) {
      var listContainer = document.getElementById('admin-content');
      if (!listContainer) return;

      // Build filter buttons
      var filterDiv = document.createElement('div');
      filterDiv.style.cssText = 'display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;';

      ['pending', 'approved', 'rejected'].forEach(function(s) {
        var btn = document.createElement('button');
        btn.className = 'admin-btn admin-btn-sm' + (statusFilter === s ? ' active' : '');
        btn.textContent = t('registrations' + s.charAt(0).toUpperCase() + s.slice(1));
        btn.addEventListener('click', function() {
          window._regStatusFilter = s;
          loadItems();
        });
        filterDiv.appendChild(btn);
      });

      // CSV export button (only for approved, when there are items)
      if (statusFilter === 'approved' && items.length > 0) {
        var csvBtn = document.createElement('button');
        csvBtn.className = 'admin-btn admin-btn-sm';
        csvBtn.textContent = t('registrationsExportCSV');
        csvBtn.style.marginLeft = 'auto';
        csvBtn.addEventListener('click', function() { exportCSV(items); });
        filterDiv.appendChild(csvBtn);
      }

      listContainer.innerHTML = '';
      listContainer.appendChild(filterDiv);

      if (!items.length) {
        var empty = document.createElement('div');
        empty.className = 'admin-empty';
        empty.textContent = t('registrationsNoEntries');
        listContainer.appendChild(empty);
        return;
      }

      var list = document.createElement('div');
      list.className = 'admin-list';

      items.forEach(function(item) {
        var row = document.createElement('div');
        row.className = 'admin-list-item';

        var info = document.createElement('div');
        info.className = 'admin-list-info';

        var title = document.createElement('h3');
        title.className = 'admin-list-title';
        title.textContent = item.vorname + ' ' + item.nachname;

        var meta = document.createElement('div');
        meta.className = 'admin-list-meta';

        var typeBadge = document.createElement('span');
        typeBadge.className = 'admin-badge';
        typeBadge.textContent = item.membership_type;
        meta.appendChild(typeBadge);

        if (item.team) {
          var teamSpan = document.createElement('span');
          teamSpan.textContent = item.team;
          meta.appendChild(teamSpan);
        }

        var dateSpan = document.createElement('span');
        dateSpan.textContent = item.submitted_at ? item.submitted_at.substring(0, 10) : '';
        meta.appendChild(dateSpan);

        // Expiring warning (>75 days old)
        var ageMs = Date.now() - new Date(item.submitted_at).getTime();
        var ageDays = Math.floor(ageMs / 86400000);
        if (ageDays > 75) {
          var warn = document.createElement('span');
          warn.className = 'admin-badge admin-badge-danger';
          warn.textContent = t('registrationsExpiring');
          meta.appendChild(warn);
        }

        info.appendChild(title);
        info.appendChild(meta);
        row.appendChild(info);

        var actions = document.createElement('div');
        actions.className = 'admin-list-actions';

        var editBtn = document.createElement('button');
        editBtn.className = 'admin-btn admin-btn-sm';
        editBtn.textContent = t('edit');
        editBtn.addEventListener('click', function() {
          openRegistrationDetail(item);
        });
        actions.appendChild(editBtn);

        row.appendChild(actions);
        list.appendChild(row);
      });

      listContainer.appendChild(list);
    }

    // ── Mixed Turnier list ────────────────────────────────────────
    function renderMixedTurnierList(signups, participations, members) {
      var content = document.getElementById('admin-content');
      content.textContent = '';

      // Build member lookup: id → { first_name, last_name, sex }
      var memberMap = {};
      members.forEach(function(m) { memberMap[m.id] = m; });

      // Build combined list: start with signups, then add Wiedisync-only participations
      var signupMemberIds = {};
      var combined = [];

      // Add all website signups
      signups.forEach(function(s) {
        if (s.member_id) signupMemberIds[s.member_id] = true;
        combined.push({
          date: s.date_created ? s.date_created.substring(0, 10) : '',
          name: s.name || '',
          email: s.email || '',
          sex: s.sex || '',
          teams: s.teams || [],
          position_1: s.position_1 || '',
          position_2: s.position_2 || '',
          position_3: s.position_3 || '',
          is_member: !!s.is_member,
          notes: s.notes || '',
          source: 'website'
        });
      });

      // Add Wiedisync-only participations (members who responded in app, not via website)
      participations.forEach(function(p) {
        if (signupMemberIds[p.member]) return; // already in signups
        var m = memberMap[p.member] || {};
        var positions = (p.note || '').split(' > ').filter(Boolean);
        combined.push({
          date: p.date_created ? p.date_created.substring(0, 10) : '',
          name: ((m.first_name || '') + ' ' + (m.last_name || '')).trim() || 'Member #' + p.member,
          email: '',
          sex: m.sex || '',
          teams: [],
          position_1: positions[0] || '',
          position_2: positions[1] || '',
          position_3: positions[2] || '',
          is_member: true,
          notes: '',
          source: 'wiedisync'
        });
      });

      // Sort alphabetically by name (locale-aware, case-insensitive)
      combined.sort(function(a, b) {
        return (a.name || '').localeCompare(b.name || '', undefined, { sensitivity: 'base' });
      });

      // Summary
      var maleCount = combined.filter(function(i) { return i.sex === 'männlich' || i.sex === 'm'; }).length;
      var femaleCount = combined.filter(function(i) { return i.sex === 'weiblich' || i.sex === 'w' || i.sex === 'f'; }).length;
      var summaryDiv = document.createElement('div');
      summaryDiv.className = 'admin-summary-bar';
      summaryDiv.innerHTML = '<strong>' + combined.length + ' ' + t('mixedTurnierSignups') + '</strong>' +
        ' \u2014 ' + maleCount + 'M / ' + femaleCount + 'F' +
        ' <span style="margin-left:12px;font-size:0.8rem;color:var(--text-muted,#64748b);">(Website: ' + signups.length + ' / Wiedisync: ' + (combined.length - signups.length) + ')</span>';
      content.appendChild(summaryDiv);

      if (combined.length > 0) {
        var csvBtn = document.createElement('button');
        csvBtn.className = 'admin-btn admin-btn-sm';
        csvBtn.textContent = t('mixedTurnierExportCSV');
        csvBtn.style.marginBottom = '12px';
        csvBtn.addEventListener('click', function() { exportMixedTurnierCSV(combined); });
        content.appendChild(csvBtn);
      }

      if (!combined.length) {
        var empty = document.createElement('div');
        empty.className = 'admin-empty';
        empty.textContent = t('mixedTurnierNoEntries');
        content.appendChild(empty);
        return;
      }

      var table = document.createElement('table');
      table.className = 'admin-table';
      table.innerHTML = '<thead><tr>' +
        '<th>Date</th><th>Name</th><th>Email</th><th>Gender</th>' +
        '<th>Team</th><th>Pos 1</th><th>Pos 2</th><th>Pos 3</th>' +
        '<th>Source</th><th>Notes</th>' +
        '</tr></thead>';

      var tbody = document.createElement('tbody');
      var teamColors = {
        'H1': { bg: '#1e40af', text: '#fff' }, 'H2': { bg: '#2563eb', text: '#fff' },
        'H3': { bg: '#3b82f6', text: '#fff' }, 'Legends': { bg: '#1e3a5f', text: '#fff' },
        'D1': { bg: '#be123c', text: '#fff' }, 'D2': { bg: '#e11d48', text: '#fff' },
        'D3': { bg: '#f43f5e', text: '#1a1a2e' }, 'D4': { bg: '#fb7185', text: '#1a1a2e' },
        'DU23-1': { bg: '#fda4af', text: '#881337' }, 'DU23-2': { bg: '#fda4af', text: '#881337' },
        'HU23': { bg: '#60a5fa', text: '#1e3a8a' }, 'HU20': { bg: '#93c5fd', text: '#1e3a8a' },
      };

      combined.forEach(function(item) {
        var tr = document.createElement('tr');

        var teamsHtml = '';
        if (item.teams && item.teams.length) {
          item.teams.forEach(function(chip) {
            var c = teamColors[chip] || { bg: '#6b7280', text: '#fff' };
            teamsHtml += '<span style="display:inline-block;padding:2px 8px;border-radius:999px;font-size:0.75rem;font-weight:500;background:' + c.bg + ';color:' + c.text + ';margin-right:4px;">' + escapeHtml(chip) + '</span>';
          });
        }

        var sourceBadge = item.source === 'wiedisync'
          ? '<span style="display:inline-block;padding:2px 8px;border-radius:999px;font-size:0.7rem;font-weight:500;background:#4A55A2;color:#fff;">WS</span>'
          : '<span style="display:inline-block;padding:2px 8px;border-radius:999px;font-size:0.7rem;font-weight:500;background:var(--border,#2d3a52);color:var(--text-secondary,#94a3b8);">Web</span>';

        var notesHtml = '';
        if (item.notes) {
          notesHtml = '<button class="admin-btn-icon" onclick="window._showMtNote(this)" data-note="' + escapeAttr(item.notes) + '" title="Details">\uD83D\uDCAC</button>';
        }

        tr.innerHTML = '<td>' + escapeHtml(item.date) + '</td>' +
          '<td>' + escapeHtml(item.name) + '</td>' +
          '<td>' + escapeHtml(item.email) + '</td>' +
          '<td>' + escapeHtml(item.sex) + '</td>' +
          '<td>' + teamsHtml + '</td>' +
          '<td>' + escapeHtml(item.position_1) + '</td>' +
          '<td>' + escapeHtml(item.position_2) + '</td>' +
          '<td>' + escapeHtml(item.position_3) + '</td>' +
          '<td style="text-align:center;">' + sourceBadge + '</td>' +
          '<td>' + notesHtml + '</td>';
        tbody.appendChild(tr);
      });

      table.appendChild(tbody);
      content.appendChild(table);
    }

    function exportMixedTurnierCSV(items) {
      var BOM = '\uFEFF';
      var header = 'Datum;Name;Email;Geschlecht;Team;Position 1;Position 2;Position 3;Quelle;Bemerkungen\n';
      var rows = items.map(function(item) {
        return [
          item.date || '',
          item.name || '',
          item.email || '',
          item.sex || '',
          (item.teams || []).join(', '),
          item.position_1 || '',
          item.position_2 || '',
          item.position_3 || '',
          item.source === 'wiedisync' ? 'Wiedisync' : 'Website',
          (item.notes || '').replace(/[\r\n]+/g, ' '),
        ].map(csvSafe).join(';');
      }).join('\n');

      var blob = new Blob([BOM + header + rows], { type: 'text/csv;charset=utf-8;' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'mixed-turnier-anmeldungen.csv';
      a.click();
      URL.revokeObjectURL(url);
    }

    // Note modal for mixed turnier (speech bubble → full text)
    window._showMtNote = function(btn) {
      var text = btn.getAttribute('data-note') || '';
      var modal = document.getElementById('admin-modal');
      // WEB-ADM-3: the note is plain text filled by an UNauthenticated public
      // visitor. Escape ALL markup (no <a href>/<img src> phishing/beacon
      // injection into the admin DOM) — the pre-wrap container preserves the
      // line breaks, so escaping is fully sufficient here.
      var clean = escapeHtml(text);
      modal.innerHTML = '<div class="admin-modal-content">' +
        '<div class="admin-modal-header">' +
          '<h2>Notes</h2>' +
          '<button class="admin-modal-close" id="mt-note-close">&times;</button>' +
        '</div>' +
        '<div class="admin-modal-body" style="white-space:pre-wrap;">' + clean + '</div>' +
        '</div>';
      modal.style.display = 'flex';
      document.getElementById('mt-note-close').addEventListener('click', function() { modal.style.display = 'none'; });
      modal.addEventListener('click', function handler(e) {
        if (e.target === modal) { modal.style.display = 'none'; modal.removeEventListener('click', handler); }
      });
    };

