          // The tab has to load it before the URL dies; a blob URL revoked on the next
          // tick opens an empty window instead.
          setTimeout(function() { URL.revokeObjectURL(url); }, 60000);
        })
        .catch(function() { alert(t('scScoresheetFetchFailed')); });
    }

    // A blob URL carries no filename, so "save as" off the opened tab offers the blob's
    // uuid. This names the file the way the SVRZ zip does.
    function downloadScoresheet(id, nameBase) {
      return scoresheetAsPdf(id)
        .then(function(r) { downloadBlob(r.blob, nameBase + r.ext); })
        .catch(function() { alert(t('scScoresheetFetchFailed')); });
    }

    // Matchblatt icon (lucide "clipboard-list" geometry — the admin draws its icons as
    // inline SVG rather than running lucide's DOM pass, which would have to be re-run for
    // every table rebuild). currentColor, so the button's colour is the whole state.
    var SHEET_ICON = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"'
      + ' stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"'
      + ' aria-hidden="true" focusable="false">'
      + '<rect x="8" y="2" width="8" height="4" rx="1"/>'
      + '<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>'
      + '<path d="M9 12h6"/><path d="M9 16h6"/>'
      + '</svg>';
    var SHEET_GREY = 'var(--text-muted)';
    var SHEET_GREEN = '#16a34a';
    var SHEET_BLUE = '#3b82f6';

    // ── scoresheet menu ─────────────────────────────────────────
    // One menu at a time, closed by any click elsewhere. Registered once, not per row:
    // a listener per row would fire N times per click for no benefit.
    var _sheetMenu = null;
    function closeSheetMenu() {
      if (_sheetMenu) { _sheetMenu.remove(); _sheetMenu = null; }
    }
    document.addEventListener('click', closeSheetMenu);
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeSheetMenu(); });
    // The menu is position:fixed (see openSheetMenu), so it does not travel with the cell
    // it belongs to. Rather than track the anchor on every scroll, close it — capture
    // phase, because the scroll happens in the table wrapper, not on window.
    window.addEventListener('scroll', closeSheetMenu, true);
    window.addEventListener('resize', closeSheetMenu);

    // An admin-uploaded sheet is STORED as PDF, converted here rather than on the server.
    // Three things fall out of doing it at this end: the result mail can attach the
    // correction as a byte passthrough (Node has no canvas to convert an image with), the
    // SVRZ zip needs no second conversion path for it, and opening one always gives
    // something a browser will render. A PDF passes through untouched.
    async function correctionToPdfBlob(file) {
      var bytes = new Uint8Array(await file.arrayBuffer());
      // Sniff the bytes, not file.type — the picker's type comes from the extension, and
      // this decides whether we hand the bytes over unconverted.
      var isPdf = bytes.length > 4 && bytes[0] === 0x25 && bytes[1] === 0x50
        && bytes[2] === 0x44 && bytes[3] === 0x46;
      if (isPdf) return new Blob([bytes], { type: 'application/pdf' });
      return new Blob([await imageBytesToPdf(bytes, file.type || 'image/jpeg')], { type: 'application/pdf' });
    }

    // Admin uploads a sheet. `slot` is 'original' — the participant's own sheet, when it
    // reached us by email or on paper instead of the upload page — or 'corrected', an
    // admin's correction on top of one that already exists. The server enforces which is
    // allowed; this only asks.
    //
    // Bytes go up raw (octet-stream): the server sniffs the real type from the magic bytes
    // anyway, so a multipart wrapper would add a parser and a filename we would not trust.
    function uploadSheet(rowMeta, state, repaint, statusEl, slot) {
      var inp = document.createElement('input');
      inp.type = 'file';
      // Mirrors what sniffType accepts server-side. HEIC is absent on purpose: nothing
      // downstream can decode it (see scorer-exam.js).
      inp.accept = 'application/pdf,image/jpeg,image/png,image/avif,.pdf,.jpg,.jpeg,.png,.avif';
      inp.style.display = 'none';
      inp.addEventListener('change', function() {
        var file = inp.files && inp.files[0];
        inp.remove();
        if (!file) return;
        // The server enforces this too; checking here saves pushing 10 MB to be refused.
        if (file.size > 10 * 1024 * 1024) { alert(t('scCorrectionTooLarge')); return; }
        setScorerStatus(statusEl, 'saving');
        var run = function() {
          // Convert first: a failure here (an undecodable image) must not reach the
          // server, and it is the same failure the server would report as a bad type.
          return correctionToPdfBlob(file).catch(function() {
            throw new Error('415 unsupported');
          }).then(function(pdfBlob) {
            return wadmin('scorer_courses',
              'scoresheet/' + encodeURIComponent(rowMeta.slug) + '/' + encodeURIComponent(rowMeta.id)
                + '?slot=' + encodeURIComponent(slot),
              { method: 'POST', headers: { 'Content-Type': 'application/octet-stream' }, body: pdfBlob }
            );
          }).then(function(res) {
            return res.json().catch(function() { return {}; }).then(function(body) {
              if (!res.ok) throw new Error((body && body.error) || ('HTTP ' + res.status));
              var d = (body && body.data) || {};
              // Take what the SERVER stored rather than assuming — it is the only copy
              // that counts, and it is what the next reader will see.
              if (d.slot === 'original') {
                state.exam_file = d.id || '';
                if (d.exam_date) state.exam_date = d.exam_date;
              } else {
                state.exam_file_corrected = d.id || '';
                state.exam_file_corrected_by = d.by || '';
                state.exam_file_corrected_on = d.on || '';
              }
              repaint();
              setScorerStatus(statusEl, 'saved');
            });
          });
        };
        // Same chain as the field saves: a correction and a field write on one row must
        // not race each other.
        _scorerSaveChains[rowMeta.key] = (_scorerSaveChains[rowMeta.key] || Promise.resolve())
          .then(run)
          .catch(function(e) {
            setScorerStatus(statusEl, 'error');
            alert(t(e && /415/.test(String(e.message)) ? 'scCorrectionBadType' : 'scCorrectionFailed'));
          });
      });
      document.body.appendChild(inp);
      inp.click();
    }

    // nameBase() is a callback, not a string: the licence field is editable, so the name
    // must be read at click time or a number typed since the table rendered is missed.
    function openSheetMenu(anchor, rowMeta, state, repaint, statusEl, nameBase) {
      closeSheetMenu();
      var menu = document.createElement('div');
      // ⚠ position:fixed on <body>, NOT absolute in the cell. The table lives in an
      // overflow-x:auto wrapper, and a box that scrolls on one axis clips the other too
      // (CSS computes the "visible" axis to auto) — an absolutely-positioned menu is cut
      // off for every row near the bottom of the table, which is most of them.
      menu.style.cssText = 'position:fixed;z-index:calc(var(--z-modal) + 1);'
        + 'min-width:230px;text-align:left;background:var(--bg-elevated,#1c1c1e);'
        + 'border:1px solid var(--border);border-radius:var(--radius-sm);'
        + 'box-shadow:0 8px 24px rgba(0,0,0,0.45);padding:0.25rem 0;';
      menu.addEventListener('click', function(e) { e.stopPropagation(); });

      if (state.exam_file_corrected) {
        var hdr = document.createElement('div');
        var when = isoToZurichDate(state.exam_file_corrected_on);
        // textContent, not innerHTML: the name comes from a Directus user record.
        hdr.textContent = t('scScoresheetCorrectedBy').split('{who}').join(state.exam_file_corrected_by || '?')
          + (when ? ' · ' + when : '');
        hdr.style.cssText = 'padding:0.4rem 0.7rem;font-size:var(--text-xs);color:var(--text-muted);'
          + 'border-bottom:1px solid var(--border);margin-bottom:0.25rem;';
        menu.appendChild(hdr);
      }

      function item(label, fn) {
        var b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        b.style.cssText = 'display:block;width:100%;text-align:left;padding:0.45rem 0.7rem;'
          + 'background:none;border:none;color:var(--text-primary);font-size:var(--text-sm);cursor:pointer;';
        b.addEventListener('mouseenter', function() { b.style.background = 'rgba(255,255,255,0.06)'; });
        b.addEventListener('mouseleave', function() { b.style.background = 'none'; });
        b.addEventListener('click', function() { closeSheetMenu(); fn(); });
        menu.appendChild(b);
        return b;
      }

      // The participant's sheet stays reachable even once corrected — it is what they
      // actually submitted, and the correction is a claim on top of it, not a redaction.
      // Each sheet that exists gets both verbs; guessing which one you meant to save
      // would be wrong about half the time.
      if (state.exam_file) {
        item(t('scScoresheetShow'), function() { openScoresheet(state.exam_file); });
        item(t('scScoresheetDownload'), function() { downloadScoresheet(state.exam_file, nameBase()); });
      }
      if (state.exam_file_corrected) {
        item(t('scScoresheetShowCorrected'), function() { openScoresheet(state.exam_file_corrected); });
        item(t('scScoresheetDownloadCorrected'), function() {
          downloadScoresheet(state.exam_file_corrected, nameBase() + '_korrigiert');
        });
      }
      // With no sheet at all, the only sensible upload is the sheet itself — the one that
      // arrived by email or on paper. Offering "upload a correction" here too, as this
      // first did, invites a correction to nothing: there is no original to correct, and
      // the result would be a row whose only sheet is filed as somebody's amendment.
      if (!state.exam_file) {
        item(t('scScoresheetUploadOriginal'), function() {
          uploadSheet(rowMeta, state, repaint, statusEl, 'original');
        });
      }
      // A correction is only meaningful once there is something to correct.
      if (state.exam_file || state.exam_file_corrected) {
        item(state.exam_file_corrected ? t('scScoresheetReplaceCorrection') : t('scScoresheetUploadCorrection'),
          function() { uploadSheet(rowMeta, state, repaint, statusEl, 'corrected'); });
      }

      // Append before measuring — offsetHeight is 0 while it is out of the document.
      document.body.appendChild(menu);
      var r = anchor.getBoundingClientRect();
      var mh = menu.offsetHeight, mw = menu.offsetWidth;
      // Flip above the tick when there is no room below. The bottom rows are exactly
      // where a menu that only ever drops downward becomes unusable.
      var top = (r.bottom + mh + 8 <= window.innerHeight) ? r.bottom + 4 : Math.max(4, r.top - mh - 4);
      // Right-aligned to the tick, then pulled back inside the viewport.
      var left = Math.min(Math.max(4, r.right - mw), window.innerWidth - mw - 4);
      menu.style.top = top + 'px';
      menu.style.left = left + 'px';
      _sheetMenu = menu;
      var first = menu.querySelector('button');
      if (first) first.focus();
    }

    // ── image → PDF ─────────────────────────────────────────────
    // SVRZ gets a PDF per participant whatever the phone produced.
    //
    // Every image is re-encoded through a canvas to baseline RGB JPEG rather than having
    // its original bytes embedded. Embedding looks cheaper and is a trap: PDF's DCTDecode
    // does not do progressive JPEG, and grayscale or CMYK sources each need a different
    // /ColorSpace (CMYK additionally an inverted /Decode for Adobe-style files). That is
    // four fragile paths to produce a file that silently renders black in some readers.
    // One predictable path instead — a scoresheet is read by eye, so q=0.92 is nowhere
    // near the weak link.
    function pdfNum(n) { return String(Math.round(n * 100) / 100); }

    function buildImagePdf(jpeg, w, h) {
      // A4 in points, oriented to the image so a landscape photo is not letterboxed into
      // a portrait page at half size.
      var landscape = w > h;
      var pw = landscape ? 842 : 595, ph = landscape ? 595 : 842;
      var scale = Math.min(pw / w, ph / h);
      var dw = w * scale, dh = h * scale;
      var dx = (pw - dw) / 2, dy = (ph - dh) / 2;
      var enc = new TextEncoder();
      var parts = [], offsets = [], pos = 0;
      function push(bytes) { parts.push(bytes); pos += bytes.length; }
      function pushStr(s) { push(enc.encode(s)); }
      function obj(num, body, stream) {
        offsets[num] = pos;
        pushStr(num + ' 0 obj\n' + body + '\n');
        if (stream) { pushStr('stream\n'); push(stream); pushStr('\nendstream\n'); }
        pushStr('endobj\n');
      }

      pushStr('%PDF-1.4\n');
      // Binary marker: tells anything treating the file as text that it is not. Raw bytes,
      // because TextEncoder would turn \xFF into a two-byte UTF-8 sequence.
      push(new Uint8Array([0x25, 0xE2, 0xE3, 0xCF, 0xD3, 0x0A]));

      var content = enc.encode('q ' + pdfNum(dw) + ' 0 0 ' + pdfNum(dh) + ' '
        + pdfNum(dx) + ' ' + pdfNum(dy) + ' cm /Im0 Do Q\n');
      obj(1, '<< /Type /Catalog /Pages 2 0 R >>');
      obj(2, '<< /Type /Pages /Kids [3 0 R] /Count 1 >>');
      obj(3, '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ' + pw + ' ' + ph + ']'
        + ' /Resources << /XObject << /Im0 4 0 R >> >> /Contents 5 0 R >>');
      obj(4, '<< /Type /XObject /Subtype /Image /Width ' + w + ' /Height ' + h
        + ' /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length '
        + jpeg.length + ' >>', jpeg);
      obj(5, '<< /Length ' + content.length + ' >>', content);

      // xref entries are fixed-width 20 bytes — 10-digit offset, 5-digit generation,
      // type, then a 2-char EOL. Get the width wrong and the file is unreadable.
      var xrefPos = pos;
      var xref = 'xref\n0 6\n0000000000 65535 f \n';
      for (var i = 1; i <= 5; i++) {
        xref += ('0000000000' + offsets[i]).slice(-10) + ' 00000 n \n';
      }
      pushStr(xref);
      pushStr('trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n' + xrefPos + '\n%%EOF\n');

      var out = new Uint8Array(pos), at = 0;
      parts.forEach(function(p) { out.set(p, at); at += p.length; });
      return out;
    }

    async function imageBytesToPdf(bytes, type) {
      // imageOrientation must be explicit: a phone photo records its rotation in
      // EXIF rather than in the pixels, and decoders that ignore that hand back a
      // sideways bitmap — which is then baked into the PDF, since the canvas
      // re-encode drops EXIF entirely. Browsers have differed on the default.
      var bitmap = await createImageBitmap(new Blob([bytes], { type: type }), { imageOrientation: 'from-image' });
      var canvas = document.createElement('canvas');
      canvas.width = bitmap.width;
      canvas.height = bitmap.height;
      canvas.getContext('2d').drawImage(bitmap, 0, 0);
      bitmap.close();
      var blob = await new Promise(function(resolve) { canvas.toBlob(resolve, 'image/jpeg', 0.92); });
      if (!blob) throw new Error('encode failed');
      return buildImagePdf(new Uint8Array(await blob.arrayBuffer()), canvas.width, canvas.height);
    }

    // The Teilnehmerliste alone is only half of what SVRZ needs — the scoresheets
    // back it up. One download beats N: the list plus every uploaded sheet, zipped.
    // Sheets live behind the admin-only /assets route, so each needs the token.
    async function exportSvrzBundle(nameBase, rows, expert, sheetRefs) {
      if (!sheetRefs.length) { exportSvrzXLSX(nameBase, rows, expert); return; }
      var fetched = await Promise.all(sheetRefs.map(async function(ref) {
        try {
          var res = await scoresheetResponse(ref.id);
          if (!res.ok) return { ref: ref, error: 'HTTP ' + res.status };
          var buf = await res.arrayBuffer();
          return { ref: ref, bytes: new Uint8Array(buf), type: res.headers.get('content-type') || '' };
        } catch (e) { return { ref: ref, error: (e && e.message) || 'error' }; }
      }));

      var files = [{
        name: 'schreiberkurs-teilnehmerliste-' + nameBase + '.xlsx',
        bytes: new Uint8Array(await svrzWorkbookBlob(rows, expert).arrayBuffer()),
      }];
      var failed = [], unconverted = [], used = {};
      // Sequential on purpose: converting decodes every photo to a full bitmap, and a
      // course's worth of 10 MB images decoded at once is how a tab runs out of memory.
      for (var k = 0; k < fetched.length; k++) {
        var f = fetched[k];
        if (f.error) { failed.push(f.ref.label + ' (' + f.error + ')'); continue; }
        var bytes = f.bytes, ext = '.pdf';
        if (!/pdf/i.test(f.type)) {
          try {
            bytes = await imageBytesToPdf(f.bytes, f.type);
          } catch (e) {
            // Undecodable (a legacy HEIC predating the upload rules, say). Ship the
            // original rather than nothing, and say so — a sheet missing from an SVRZ
            // submission is worse than one in the wrong format.
            bytes = f.bytes;
            ext = /png/i.test(f.type) ? '.png' : (/jpe?g/i.test(f.type) ? '.jpg'
              : (/avif/i.test(f.type) ? '.avif' : (/heic|heif/i.test(f.type) ? '.heic' : '')));
            unconverted.push(f.ref.label);
          }
        }
        // The licence number is the name SVRZ can act on. Falling back to the participant
        // name keeps an un-numbered sheet identifiable — the export already warned about
        // the missing number before we got here.
        var base = f.ref.licence
          ? 'schreiberpruefung_' + safeFileName(f.ref.licence, f.ref.id)
          : 'schreiberpruefung_' + safeFileName(f.ref.label, f.ref.id);
        var name = base + ext;
        // Two participants can share a name — and, if a number was mistyped, a licence.
        // A colliding zip entry would silently shadow one of them.
        for (var i = 2; used[name.toLowerCase()]; i++) name = base + ' (' + i + ')' + ext;
        used[name.toLowerCase()] = 1;
        files.push({ name: 'spielblaetter/' + name, bytes: bytes });
      }
      downloadBlob(zipStore(files, 'application/zip'), 'schreiberkurs-' + nameBase + '.zip');
      // A missing sheet must not pass as a complete submission to SVRZ.
      if (failed.length) alert(t('scScoresheetFetchFailed') + '\n\n' + failed.join('\n'));
      if (unconverted.length) alert(t('scScoresheetNotConverted') + '\n\n' + unconverted.join('\n'));
    }

    // ── Upload file to Directus ─────────────────────────────
    async function uploadFile(token, file) {
      var fd = new FormData();
      fd.append('file', file);
      var res = await fetch(DIRECTUS_URL + '/files', {
        method: 'POST',
        headers: { 'Authorization': 'Bearer ' + token },
        body: fd,
      });
      if (!res.ok) throw new Error('File upload failed: ' + res.status);
      var data = await res.json();
      return data.data.id;
    }

    async function saveItem(existingItem) {
      var form = document.getElementById('modal-form');
      var saveBtn = document.getElementById('modal-save');
      saveBtn.disabled = true;
      saveBtn.textContent = t('saving');

      var isNews = currentTab === 'news';
      var isSponsor = currentTab === 'sponsors';
      var isScorerCourse = currentTab === 'scorer_courses';
      var collection = isScorerCourse ? 'scorer_courses' : (isSponsor ? 'sponsors' : (isNews ? 'news' : 'events'));
      var payload = {};

      try {
        var token = await getValidToken();

        if (isSponsor) {
          payload.name = form.querySelector('[name="name"]').value;
          payload.website_url = form.querySelector('[name="website_url"]').value || null;
          var sortVal = form.querySelector('[name="sort_order"]').value;
          payload.sort_order = sortVal ? Number(sortVal) : 0;
          payload.active = form.querySelector('[name="active"]').checked;
          payload.team_page_only = form.querySelector('[name="team_page_only"]').checked;

          var logoInput = form.querySelector('[name="logo"]');
          if (logoInput && logoInput.files.length > 0) {
            payload.logo = await uploadFile(token, logoInput.files[0]);
          }
        } else if (isScorerCourse) {
          payload.slug_id = form.querySelector('[name="slug_id"]').value.trim();
          payload.title_de = form.querySelector('[name="title_de"]').value.trim();
          payload.title_en = form.querySelector('[name="title_en"]').value.trim();
          payload.date_iso = form.querySelector('[name="date_iso"]').value || null;
          payload.scorer_expert = form.querySelector('[name="scorer_expert"]').value.trim() || null;
          payload.time = form.querySelector('[name="time"]').value.trim() || null;
          payload.mode = form.querySelector('[name="mode"]').value;
          payload.location = form.querySelector('[name="location"]').value.trim() || null;
          payload.host_note = form.querySelector('[name="host_note"]').value.trim() || null;
          var scDuration = form.querySelector('[name="duration_hours"]').value;
          payload.duration_hours = scDuration && Number(scDuration) > 0 ? Number(scDuration) : null;
          payload.form_slug_de = normalizeFormSlug(form.querySelector('[name="form_slug_de"]').value) || null;
          payload.form_slug_en = normalizeFormSlug(form.querySelector('[name="form_slug_en"]').value) || null;
          // datetime-local yields Zurich wall-clock; the column is a UTC instant.
          payload.registration_closes = zurichInputToISO(form.querySelector('[name="registration_closes"]').value);
          var scSortVal = form.querySelector('[name="sort"]').value;
          payload.sort = scSortVal ? Number(scSortVal) : 0;
          payload.active = form.querySelector('[name="active"]').checked;
        } else if (isNews) {
          var rawTitle = form.querySelector('[name="title"]').value;
          var translatedTitle = form.querySelector('[name="title_en"]').value;
          // Admin typed in adminLang, translation is the other language
          if (adminLang === 'en') {
            payload.title_en = rawTitle;                      // input is EN
            payload.title = translatedTitle || rawTitle;       // translation is DE
          } else {
            payload.title = rawTitle;                          // input is DE
            if (translatedTitle) payload.title_en = translatedTitle; // translation is EN
          }
          payload.slug = form.querySelector('[name="slug"]').value;
          payload.excerpt = form.querySelector('[name="excerpt"]').value;
          payload.body = quillInstance ? DOMPurify.sanitize(quillInstance.root.innerHTML) : '';
          payload.category = form.querySelector('[name="category"]').value;
          payload.published_at = form.querySelector('[name="published_at"]').value;
          payload.is_published = form.querySelector('[name="is_published"]').checked;

          var imageInput = form.querySelector('[name="image"]');
          if (imageInput && imageInput.files.length > 0) {
            payload.image = await uploadFile(token, imageInput.files[0]);
          }
        } else {
          payload.title = form.querySelector('[name="title"]').value;
          payload.event_type = form.querySelector('[name="event_type"]').value;
          payload.start_date = form.querySelector('[name="start_date"]').value;
          payload.end_date = form.querySelector('[name="end_date"]').value || form.querySelector('[name="start_date"]').value;
          payload.all_day = form.querySelector('[name="all_day"]').checked;
          payload.location = form.querySelector('[name="location"]').value;
          payload.description = quillInstance ? DOMPurify.sanitize(quillInstance.root.innerHTML) : '';

          var participationRequired = form.querySelector('[name="participation_required"]').checked;
          if (participationRequired) {
            payload.respond_by = form.querySelector('[name="respond_by"]').value || null;
            var teamsVal = form.querySelector('[name="teams"]').value;
            var teamsArr; try { teamsArr = JSON.parse(teamsVal || '[]'); } catch (_) { teamsArr = []; }
            payload.teams = teamsArr;
            var minP = form.querySelector('[name="min_players"]').value;
            var maxP = form.querySelector('[name="max_players"]').value;
            payload.min_players = minP ? Number(minP) : 0;
            payload.max_players = maxP ? Number(maxP) : 0;
            payload.require_note_if_absent = form.querySelector('[name="require_note_if_absent"]').checked;
            var reqParts; try { reqParts = JSON.parse(form.querySelector('[name="required_participants"]').value || '[]'); } catch (_) { reqParts = []; }
            payload.required_participants = reqParts;
          } else {
            // Clear participation fields
            payload.respond_by = null;
            payload.teams = [];
            payload.min_players = 0;
            payload.max_players = 0;
            payload.require_note_if_absent = false;
            payload.required_participants = [];
          }
        }

        var subpath = existingItem
          ? 'items/' + collection + '/' + existingItem.id
          : 'items/' + collection;
        var method = existingItem ? 'PATCH' : 'POST';

        var res = await wadmin(collection, subpath, {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          var errData = await res.json().catch(function() { return {}; });
          throw new Error(errData.errors ? errData.errors[0].message : 'HTTP ' + res.status);
        }

        // Mirror the deadline onto the linked OpnForms. Deliberately after the course
        // save and non-fatal: the course row is the source of truth and is already
        // stored, so a push failure is reported without pretending the save failed —
        // but it is reported, because until it lands the form still takes sign-ups.
        if (isScorerCourse) {
          var pushSlugs = courseFormSlugs(payload);
          if (pushSlugs.length) {
            var failed = await pushClosesToForms(pushSlugs, payload.registration_closes);
            if (failed.length) alert(t('scClosesPushFailed') + ' (' + failed.join(', ') + ')');
          }
        }

        closeModal();
        loadItems();
      } catch(err) {
        alert(t('saveError') + (err.message || err));
        saveBtn.disabled = false;
        saveBtn.textContent = t('save');
      }
    }

    // ── Form field helpers (all values escaped) ───────────────
    function fieldInput(name, label, value, opts) {
      var required = opts === true || (opts && opts.required);
      var placeholder = (opts && typeof opts === 'object' && opts.placeholder) ? opts.placeholder : '';
      return '<div class="admin-field">' +
        '<label for="f-' + name + '">' + escapeHtml(label) + '</label>' +
        '<input type="text" name="' + name + '" id="f-' + name + '" value="' + escapeAttr(value || '') + '"' +
          (placeholder ? ' placeholder="' + escapeAttr(placeholder) + '"' : '') +
          (required ? ' required' : '') + '>' +
      '</div>';
    }
    function fieldTextarea(name, label, value) {
      return '<div class="admin-field">' +
        '<label for="f-' + name + '">' + escapeHtml(label) + '</label>' +
        '<textarea name="' + name + '" id="f-' + name + '" rows="3">' + escapeHtml(value || '') + '</textarea>' +
      '</div>';
    }
    function fieldDate(name, label, value) {
      return '<div class="admin-field">' +
        '<label for="f-' + name + '">' + escapeHtml(label) + '</label>' +
        '<input type="date" name="' + name + '" id="f-' + name + '" value="' + escapeAttr(value || '') + '">' +
      '</div>';
    }
    // Value/return are Zurich wall-clock ('yyyy-mm-ddTHH:MM') — convert at the
    // payload boundary with zurichInputToISO/isoToZurichInput, not here.
    function fieldDateTime(name, label, value, opts) {
      var note = (opts && opts.note) ? opts.note : '';
      return '<div class="admin-field">' +
        '<label for="f-' + name + '">' + escapeHtml(label) + '</label>' +
        '<input type="datetime-local" name="' + name + '" id="f-' + name + '" value="' + escapeAttr(value || '') + '">' +
        (note ? '<small class="admin-hint">' + escapeHtml(note) + '</small>' : '') +
      '</div>';
    }
    function fieldSelect(name, label, options, selected) {
      var html = '<div class="admin-field"><label for="f-' + name + '">' + escapeHtml(label) + '</label><select name="' + name + '" id="f-' + name + '">';
      options.forEach(function(opt) {
        html += '<option value="' + escapeAttr(opt) + '"' + (opt === selected ? ' selected' : '') + '>' + escapeHtml(opt.charAt(0).toUpperCase() + opt.slice(1)) + '</option>';
      });
      html += '</select></div>';
      return html;
    }
    function fieldNumber(name, label, value, opts) {
      var step = (opts && opts.step) ? ' step="' + escapeAttr(opts.step) + '"' : '';
      return '<div class="admin-field">' +
        '<label for="f-' + name + '">' + escapeHtml(label) + '</label>' +
        '<input type="number" name="' + name + '" id="f-' + name + '" value="' + escapeAttr(value != null && value !== '' ? String(value) : '') + '" min="0"' + step + '>' +
      '</div>';
    }
    function fieldFile(name, label) {
      return '<div class="admin-field">' +
        '<label for="f-' + name + '">' + escapeHtml(label) + '</label>' +
        '<input type="file" name="' + name + '" id="f-' + name + '" accept="image/*">' +
      '</div>';
    }
    function fieldCheckbox(name, label, checked, opts) {
      opts = opts || {};
      if (opts.toggle) {
        return '<div class="admin-field admin-field-toggle">' +
          '<label class="admin-toggle-label">' + escapeHtml(label) +
          '<span class="admin-toggle">' +
            '<input type="checkbox" name="' + name + '"' + (checked ? ' checked' : '') + '>' +
            '<span class="admin-toggle-track"><span class="admin-toggle-thumb"></span></span>' +
          '</span></label>' +
        '</div>';
      }
      return '<div class="admin-field admin-field-check">' +
        '<label><input type="checkbox" name="' + name + '"' + (checked ? ' checked' : '') + '> ' + escapeHtml(label) + '</label>' +
      '</div>';
    }

    // ── Teams multi-select with presets ─────────────────────
    function initTeamsSelector(item) {
      var selectedTeams = (item && item.teams) ? item.teams.slice() : [];
      var hiddenInput = document.querySelector('[name="teams"]');
      var tagsContainer = document.getElementById('teams-tags');
      var presetsContainer = document.getElementById('team-presets');
      if (!hiddenInput || !tagsContainer || !presetsContainer) return;

      function syncHidden() {
        hiddenInput.value = JSON.stringify(selectedTeams);
      }

      function renderTags(teams) {
        tagsContainer.textContent = '';
        selectedTeams.forEach(function(tid) {
          var team = teams ? teams.find(function(t) { return t.id === tid; }) : null;
          var tag = document.createElement('span');
          tag.className = 'admin-tag';
          tag.textContent = team ? team.name : tid;
          var removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'admin-tag-remove';
          removeBtn.textContent = '\u00d7';
          removeBtn.addEventListener('click', function() {
            selectedTeams = selectedTeams.filter(function(id) { return id !== tid; });
            syncHidden();
            renderTags(teams);
          });
          tag.appendChild(removeBtn);
          tagsContainer.appendChild(tag);
        });
      }

      fetchTeams().then(function(teams) {
        // Preset buttons
        var presets = [
          { label: t('allTeams'), filter: function() { return teams; } },
          { label: 'Volleyball', filter: function() { return teams.filter(function(tt) { return tt.sport === 'volleyball'; }); } },
          { label: 'Basketball', filter: function() { return teams.filter(function(tt) { return tt.sport === 'basketball'; }); } }
        ];
        presets.forEach(function(p) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'admin-btn admin-btn-sm';
          btn.textContent = p.label;
          btn.addEventListener('click', function() {
            selectedTeams = p.filter().map(function(t) { return t.id; });
            syncHidden();
            renderTags(teams);
          });
          presetsContainer.appendChild(btn);
        });

        // Clear button
        var clearBtn = document.createElement('button');
        clearBtn.type = 'button';
        clearBtn.className = 'admin-btn admin-btn-sm admin-btn-danger';
        clearBtn.textContent = t('none');
        clearBtn.addEventListener('click', function() {
          selectedTeams = [];
          syncHidden();
          renderTags(teams);
        });
        presetsContainer.appendChild(clearBtn);

        // Individual team checkboxes
        var dropdown = document.getElementById('teams-dropdown');
        dropdown.style.display = '';
        dropdown.style.maxHeight = '200px';
        dropdown.style.overflowY = 'auto';
        teams.forEach(function(team) {
          var label = document.createElement('label');
          label.className = 'admin-dropdown-item';
          var cb = document.createElement('input');
          cb.type = 'checkbox';
          cb.checked = selectedTeams.includes(team.id);
          cb.addEventListener('change', function() {
            if (this.checked) {
              if (!selectedTeams.includes(team.id)) selectedTeams.push(team.id);
            } else {
              selectedTeams = selectedTeams.filter(function(id) { return id !== team.id; });
            }
            syncHidden();
            renderTags(teams);
          });
          var sportBadge = document.createElement('span');
          sportBadge.className = 'admin-badge';
          sportBadge.textContent = team.sport === 'volleyball' ? 'VB' : 'BB';
          sportBadge.style.marginLeft = '4px';
          label.appendChild(cb);
          var nameSpan = document.createElement('span');
          nameSpan.textContent = ' ' + team.name + ' ';
          label.appendChild(nameSpan);
          label.appendChild(sportBadge);
          dropdown.appendChild(label);
        });

        renderTags(teams);
      });
    }

    // ── Members multi-search select ──────────────────────────
    function initMembersSelector(item) {
      var selectedMembers = (item && item.required_participants) ? item.required_participants.slice() : [];
      var hiddenInput = document.querySelector('[name="required_participants"]');
      var tagsContainer = document.getElementById('members-tags');
      var searchInput = document.getElementById('member-search');
      var dropdown = document.getElementById('members-dropdown');
      if (!hiddenInput || !tagsContainer || !searchInput || !dropdown) return;

      var allMembers = [];

      function syncHidden() {
        hiddenInput.value = JSON.stringify(selectedMembers);
      }

      function memberName(m) {
        return (m.first_name || '') + ' ' + (m.last_name || '');
      }

      function renderTags() {
        tagsContainer.textContent = '';
        selectedMembers.forEach(function(mid) {
          var member = allMembers.find(function(m) { return m.id === mid; });
          var tag = document.createElement('span');
          tag.className = 'admin-tag';
          tag.textContent = member ? memberName(member).trim() : mid;
          var removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'admin-tag-remove';
          removeBtn.textContent = '\u00d7';
          removeBtn.addEventListener('click', function() {
            selectedMembers = selectedMembers.filter(function(id) { return id !== mid; });
            syncHidden();
            renderTags();
          });
          tag.appendChild(removeBtn);
          tagsContainer.appendChild(tag);
        });
      }

      function renderDropdown(query) {
        dropdown.textContent = '';
        if (!query) { dropdown.style.display = 'none'; return; }
        var q = query.toLowerCase();
        var matches = allMembers.filter(function(m) {
          if (selectedMembers.includes(m.id)) return false;
          var name = memberName(m).toLowerCase();
          var email = (m.email || '').toLowerCase();
          return name.indexOf(q) !== -1 || email.indexOf(q) !== -1;
        }).slice(0, 20);

        if (!matches.length) {
          dropdown.style.display = 'none';
          return;
        }

        dropdown.style.display = '';
        matches.forEach(function(m) {
          var option = document.createElement('div');
          option.className = 'admin-dropdown-option';
          var nameText = document.createElement('span');
          nameText.textContent = memberName(m).trim();
          option.appendChild(nameText);
          if (m.email) {
            var emailSpan = document.createElement('span');
            emailSpan.className = 'admin-dropdown-email';
            emailSpan.textContent = m.email;
            option.appendChild(emailSpan);
          }
          option.addEventListener('click', function() {
            selectedMembers.push(m.id);
            syncHidden();
            renderTags();
            searchInput.value = '';
            dropdown.style.display = 'none';
          });
          dropdown.appendChild(option);
        });
      }

      fetchMembers().then(function(members) {
        allMembers = members;
        renderTags();

        searchInput.addEventListener('input', function() {
          renderDropdown(this.value);
        });
        searchInput.addEventListener('focus', function() {
          if (this.value) renderDropdown(this.value);
        });
        // Close dropdown on outside click
        document.addEventListener('click', function(e) {
          if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.style.display = 'none';
          }
        });
      });
    }

    // ── Admin grant grid helpers ──────────────────────────────
    function bindGrantGrid(host, rows) {
      var byId = {};
      rows.forEach(function(u) { byId[u.id] = u.sections.slice(); });
      var timers = {};
      if (host._grantBound) host.removeEventListener('change', host._grantBound);
      var handler = function(e) {
        var cb = e.target;
        if (!cb || cb.type !== 'checkbox') return;
        var uid = cb.getAttribute('data-uid');
        var sec = cb.getAttribute('data-sec');
        var arr = byId[uid] || [];
        var i = arr.indexOf(sec);
        if (cb.checked && i === -1) arr.push(sec);
        if (!cb.checked && i !== -1) arr.splice(i, 1);
        byId[uid] = arr;
        clearTimeout(timers[uid]);
        timers[uid] = setTimeout(function() { saveGrant(uid, arr); }, 400);
      };
      host._grantBound = handler;
      host.addEventListener('change', handler);
    }
    async function saveGrant(uid, sections) {
      var status = document.getElementById('grant-status');
      if (status) status.textContent = 'Saving…';
      try {
        var token = await getValidToken();
        var res = await fetch(DIRECTUS_URL + '/kscw/wadmin/admins/' + encodeURIComponent(uid), {
          method: 'PATCH',
          headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
          body: JSON.stringify({ sections: sections }),
        });
        if (status) status.textContent = res.ok ? 'Saved' : 'Save failed';
      } catch (e) {
        if (status) status.textContent = 'Save failed';
      }
    }

    // ── Init ──────────────────────────────────────────────────
    render();
  })();
  </script>
</body>
</html>

<style is:global>
