    // ── SVRZ "Schreiberkurs Teilnehmerliste" export ──────────────
    // Column order, wording and layout are dictated by the RSK Swiss Volley
    // Region Zürich template — SVRZ reads these sheets by eye and transcribes
    // them, so the letterhead, the grey header band and the 13 fixed columns are
    // reproduced rather than restyled. Always German: it is SVRZ's form, not our
    // UI, so it does not follow the admin language.
    var SVRZ_HEADERS = ['Kursdatum', 'Prüfungsdatum', 'Prüfungsresultat', 'Vereinsname', 'Lizenz-Nr.',
      'Name', 'Vorname', 'Strasse', 'PLZ', 'Wohnort', 'Telefon', 'E-Mail', 'Geb. Datum'];
    var SVRZ_CENTERED = { 0: 1, 1: 1, 2: 1, 12: 1 }; // dates + result; the rest reads left

    // Columns are sized to what is in them rather than to the template's fixed
    // widths: those were cut for a paper form, and a long street or e-mail lands
    // in the cell clipped. Nobody re-opens this sheet to widen a column before
    // reading it, so a clipped address is simply a wrong address.
    //
    // An .xlsx stores widths, not layout — there is no text metric here and Excel
    // does not autofit on open, so the width is approximated per character. The
    // unit is one digit of the workbook's OWN normal font (Open Sans 12 below),
    // so the weights are simply each character measured against a digit; no
    // point-size correction belongs here. They lean generous — too wide costs a
    // little paper, too narrow hides data, and a reader without Open Sans
    // installed gets whatever Excel substitutes.
    var SVRZ_COL_MIN = 6, SVRZ_COL_MAX = 46;
    var CH_NARROW = /[.,;:'!|()\[\]iljItfr ]/; // ~half a digit in Open Sans
    var CH_WIDE = /[MWmw@%]/;
