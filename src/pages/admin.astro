        (item.bb_doc_lizenz ? '<div class="admin-field"><label>License application (PDF)</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.bb_doc_lizenz) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +
        (item.bb_doc_freibrief ? '<div class="admin-field"><label>Release letter / Freibrief (PDF)</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.bb_doc_freibrief) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +
        (item.bb_doc_selfdecl ? '<div class="admin-field"><label>Self Declaration (PDF)</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.bb_doc_selfdecl) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +
        (item.bb_doc_natdecl ? '<div class="admin-field"><label>National Team Decl. (PDF)</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.bb_doc_natdecl) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +
        (item.bb_doc_u18parents ? '<div class="admin-field"><label>Parental consent U18 (PDF)</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.bb_doc_u18parents) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +
        (item.bb_doc_schoolcert ? '<div class="admin-field"><label>School certificate (PDF)</label>' +
          '<a href="' + escapeAttr(DIRECTUS_URL + '/assets/' + item.bb_doc_schoolcert) + '" target="_blank" class="admin-btn admin-btn-sm">View</a></div>' : '') +

        // Flag a basketball registration missing any document its licensing
        // situation requires (Freibrief for a Swiss-club transfer, the FIBA
        // documents for foreign/minor players, …). Mirrors bbRequiredDocs() in
        // the backend (wiedisync bb-docs.js) — keep the two in sync. School
        // certificate stays optional and is never flagged.
        ((function () {
          if (item.membership_type !== 'basketball') return '';
          var nat = (item.nationalitaet_code || '').toUpperCase();
          var foreign = nat && nat !== 'CH';
          var sit = item.bb_situation;
          var SITS = ['neu', 'transfer_ch', 'transfer_intl', 'rueckkehr'];
          var minor = false;
          var mm = (item.geburtsdatum || '').substring(0, 10).match(/^(\d{4})-(\d{2})-(\d{2})$/);
          if (mm) {
            var now = new Date();
            var ssy = (now.getUTCMonth() + 1) >= 7 ? now.getUTCFullYear() : now.getUTCFullYear() - 1;
            var age = ssy - (+mm[1]);
            if (9 < (+mm[2]) || (9 === (+mm[2]) && 1 < (+mm[3]))) age--;
            minor = age < 18;
          }
          var req = ['id_upload_front', 'id_upload_back', 'bb_doc_lizenz'];
          if (SITS.indexOf(sit) === -1) { if (foreign) req.push('bb_doc_selfdecl', 'bb_doc_natdecl'); }
          else if (sit === 'transfer_ch') { req.push('bb_doc_freibrief'); }
          else if (sit === 'transfer_intl' || sit === 'rueckkehr') { req.push('bb_doc_selfdecl'); if (minor) req.push('bb_doc_natdecl', 'bb_doc_u18parents'); }
          else { if (foreign) req.push('bb_doc_selfdecl'); if (foreign && minor) req.push('bb_doc_natdecl'); }
          var missing = req.filter(function (k) { return !item[k]; });
          if (!missing.length) return '';
          return '<div class="admin-field" style="grid-column:1/-1"><span style="color:#dc2626;font-weight:700">⚠ Missing required documents for this licence situation: ' + missing.join(', ') + '</span></div>';
        })()) +

        '<div class="admin-modal-footer">' +
        '<button type="button" class="admin-btn" id="modal-cancel">' + t('cancel') + '</button>' +

        ((item.id_upload_front || item.id_upload_back) ?
          '<button type="button" id="reg-download-files" class="admin-btn admin-btn-sm">' + t('registrationsDownloadFiles') + '</button>' : '') +

        (item.membership_type === 'basketball' ?
          '<button type="button" id="reg-gen-pdf" class="admin-btn admin-btn-sm">' + t('registrationsGeneratePDF') + '</button>' +
          '<button type="button" id="reg-gen-fiba" class="admin-btn admin-btn-sm">' + t('registrationsGenerateFIBA') + '</button>' : '') +

        (item.status === 'pending' ?
          '<button type="button" id="reg-reject" class="admin-btn admin-btn-danger">' + t('registrationsReject') + '</button>' +
          '<button type="button" id="reg-approve" class="admin-btn admin-btn-primary">' + t('registrationsApprove') + '</button>' : '') +

        '<button type="submit" class="admin-btn admin-btn-primary" id="modal-save">' + t('save') + '</button>' +
        '</div></form></div>';

      modal.innerHTML = html;
      modal.style.display = 'flex';

      document.getElementById('modal-close').addEventListener('click', closeModal);
      document.getElementById('modal-cancel').addEventListener('click', closeModal);
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
      });

      document.getElementById('modal-form').addEventListener('submit', function(e) {
        e.preventDefault();
        saveRegistration(item.id);
      });

      var approveBtn = document.getElementById('reg-approve');
      if (approveBtn) {
        approveBtn.addEventListener('click', function() {
          updateRegistrationStatus(item.id, 'approved');
        });
      }

      var rejectBtn = document.getElementById('reg-reject');
      if (rejectBtn) {
        rejectBtn.addEventListener('click', function() {
          confirmModal(t('registrationsConfirmReject'), {
            danger: true,
            confirmLabel: t('registrationsReject'),
          }).then(function(ok) {
            if (ok) updateRegistrationStatus(item.id, 'rejected');
          });
        });
      }

      var dlBtn = document.getElementById('reg-download-files');
      if (dlBtn) {
        dlBtn.addEventListener('click', function() {
          downloadRegistrationFiles(item);
        });
      }

      var pdfBtn = document.getElementById('reg-gen-pdf');
      if (pdfBtn) {
        pdfBtn.addEventListener('click', function() {
          generateLizenzantrag(item);
        });
      }
      var fibaBtn = document.getElementById('reg-gen-fiba');
      if (fibaBtn) {
        fibaBtn.addEventListener('click', function() {
          generateFIBAPDFs(item);
        });
      }
    }

    async function saveRegistration(id) {
      var saveBtn = document.getElementById('modal-save');
      saveBtn.disabled = true;
      saveBtn.textContent = t('saving');

      var payload = {
        vorname: document.getElementById('f-reg-vorname').value.trim(),
        nachname: document.getElementById('f-reg-nachname').value.trim(),
        email: document.getElementById('f-reg-email').value.trim(),
        telefon_mobil: document.getElementById('f-reg-telefon').value.trim(),
        adresse: document.getElementById('f-reg-adresse').value.trim(),
        plz: document.getElementById('f-reg-plz').value.trim(),
        ort: document.getElementById('f-reg-ort').value.trim(),
        geburtsdatum: document.getElementById('f-reg-dob').value.trim(),
        nationalitaet: document.getElementById('f-reg-nation').value.trim(),
        geschlecht: document.getElementById('f-reg-gender').value.trim(),
        team: document.getElementById('f-reg-team').value.trim(),
        beitragskategorie: document.getElementById('f-reg-fee').value.trim(),
        ahv_nummer: document.getElementById('f-reg-ahv').value.trim(),
        kantonsschule: document.getElementById('f-reg-ks').value.trim(),
        rolle: document.getElementById('f-reg-rolle').value.trim(),
        lizenz: document.getElementById('f-reg-lizenz').value.trim(),
        schiedsrichter_stufe: document.getElementById('f-reg-refstufe').value.trim(),
        bemerkungen: document.getElementById('f-reg-bemerkungen').value.trim(),
      };

      try {
        var res = await wadmin('registrations', 'items/registrations/' + id, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        closeModal();
        loadItems();
      } catch(err) {
        alert(t('saveError') + err.message);
        saveBtn.disabled = false;
        saveBtn.textContent = t('save');
      }
    }

    async function updateRegistrationStatus(id, status) {
      try {
        var token = await getValidToken();
        var payload = { status: status };
        if (status === 'approved') {
          payload.approved_at = new Date().toISOString();
          var userRes = await fetch(DIRECTUS_URL + '/users/me?fields=first_name,last_name', {
            headers: { 'Authorization': 'Bearer ' + token },
          });
          var user = (await userRes.json()).data;
          payload.approved_by = user.first_name + ' ' + user.last_name;
        }

        var res = await wadmin('registrations', 'items/registrations/' + id, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);

        if (status === 'rejected') {
          var itemRes = await wadmin('registrations', 'items/registrations/' + id, {});
          var itemData = (await itemRes.json()).data;

          if (itemData.id_upload_front) {
            await fetch(DIRECTUS_URL + '/files/' + itemData.id_upload_front, {
              method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token },
            });
          }
          if (itemData.id_upload_back) {
            await fetch(DIRECTUS_URL + '/files/' + itemData.id_upload_back, {
              method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token },
            });
          }

          await wadmin('registrations', 'items/registrations/' + id, { method: 'DELETE' });
        }

        closeModal();
        loadItems();
      } catch(err) {
        alert(t('saveError') + err.message);
      }
    }

    // Identity documents are downloaded and then deleted from Directus — we keep
    // a copy no longer than we need it. That makes the delete irreversible, so
    // every byte is fetched and checked BEFORE anything is removed: a 401, an
    // expired token or an empty body must not cost the applicant their ID.
    // Previously the loop downloaded and deleted one file at a time without
    // checking res.ok, so a failed fetch saved the JSON error body under the
    // applicant's name and deleted the real scan straight afterwards.
    async function downloadRegistrationFiles(item) {
      try {
        var token = await getValidToken();
        var files = [];
        if (item.id_upload_front) files.push({ id: item.id_upload_front, name: 'ID_front' });
        if (item.id_upload_back) files.push({ id: item.id_upload_back, name: 'ID_back' });
        if (!files.length) return;

        // Phase 1 — fetch everything and verify it before deleting anything.
        var fetched = [];
        for (var i = 0; i < files.length; i++) {
          var res = await fetch(DIRECTUS_URL + '/assets/' + files[i].id, {
            headers: { 'Authorization': 'Bearer ' + token },
          });
          if (!res.ok) throw new Error('HTTP ' + res.status + ' fetching ' + files[i].name);
          var type = res.headers.get('content-type') || '';
          var blob = await res.blob();
          if (!blob.size) throw new Error('empty response for ' + files[i].name);
          // A blob URL carries no filename, so the extension has to come from the
          // content type — without it the saved file has no extension at all and
          // will not open on a double-click.
          var ext = /pdf/i.test(type) ? '.pdf'
            : (/png/i.test(type) ? '.png'
            : (/jpe?g/i.test(type) ? '.jpg'
            : (/webp/i.test(type) ? '.webp'
            : (/gif/i.test(type) ? '.gif'
            : (/heic|heif/i.test(type) ? '.heic' : '')))));
          fetched.push({ id: files[i].id, blob: blob, name: item.nachname + '_' + item.vorname + '_' + files[i].name + ext });
        }

        // Phase 2 — hand them to the browser.
        fetched.forEach(function(f) { downloadBlob(f.blob, f.name); });

        // Phase 3 — only now drop the originals.
        for (var d = 0; d < fetched.length; d++) {
          await fetch(DIRECTUS_URL + '/files/' + fetched[d].id, {
            method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token },
          });
        }

        await wadmin('registrations', 'items/registrations/' + item.id, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id_upload_front: null, id_upload_back: null }),
        });

        closeModal();
        loadItems();
      } catch(err) {
        alert(t('saveError') + (err.message || err));
      }
    }

    function getRegistrationModalValues() {
      return {
        vorname: getModalVal('f-reg-vorname'),
        nachname: getModalVal('f-reg-nachname'),
        email: getModalVal('f-reg-email'),
        adresse: getModalVal('f-reg-adresse'),
        plz: getModalVal('f-reg-plz'),
        ort: getModalVal('f-reg-ort'),
        geburtsdatum: getModalVal('f-reg-dob'),
        geschlecht: getModalVal('f-reg-gender'),
        nationalitaet: getModalVal('f-reg-nation'),
      };
    }

    function getModalVal(id) {
      var el = document.getElementById(id);
      return el ? (el.value || '').trim() : '';
    }

    function downloadPdfBlob(bytes, filename) {
      var blob = new Blob([bytes], { type: 'application/pdf' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = filename;
      // The anchor must be in the document and the object URL must outlive the
      // click — revoking it synchronously races the browser's download and
      // truncates the file, producing an unreadable PDF (worse the larger it is).
      a.style.display = 'none';
      document.body.appendChild(a);
      a.click();
      setTimeout(function() {
        try { document.body.removeChild(a); } catch(e) {}
        URL.revokeObjectURL(url);
      }, 60000);
    }

    // ── CP1252, the one table ────────────────────────────────────────────
    // Two things in this page have the same constraint: the PDF standard fonts
    // pdf-lib fills licence forms with, and the ClubDesk CSV export. Both speak
    // WinAnsi/CP1252 and nothing else. They used to carry separate tables with
    // DIFFERENT transliteration coverage, so a Turkish member came out "Isik" on
    // the licence form and "Is?k" in the member register — same person, two
    // spellings, from one registration. One table now serves both.
    //
    // Codepoints 0x80-0x9F are the CP1252 additions (Š ž Œ € …), which is why the
    // map carries the byte: the CSV encoder needs it, the PDF side only needs to
    // know the character is representable.
    var CP1252_EXTRA = {
      '€': 0x80, '‚': 0x82, 'ƒ': 0x83, '„': 0x84, '…': 0x85,
      '†': 0x86, '‡': 0x87, 'ˆ': 0x88, '‰': 0x89, 'Š': 0x8A,
      '‹': 0x8B, 'Œ': 0x8C, 'Ž': 0x8E, '‘': 0x91, '’': 0x92,
      '“': 0x93, '”': 0x94, '•': 0x95, '–': 0x96, '—': 0x97,
      '˜': 0x98, '™': 0x99, 'š': 0x9A, '›': 0x9B, 'œ': 0x9C,
      'ž': 0x9E, 'Ÿ': 0x9F
    };
    // Letters with no CP1252 slot AND no combining-mark decomposition — stripping
    // accents gets you nowhere, so they need naming. (ø/Ø are deliberately absent:
    // CP1252 holds them at 0xF8/0xD8, so they never reach this table.)
    var CP1252_TRANSLIT = {
      'đ': 'd', 'Đ': 'D', 'ł': 'l', 'Ł': 'L',
      'ı': 'i', 'ħ': 'h', 'Ħ': 'H', 'ŧ': 't', 'Ŧ': 'T'
    };
    function cp1252Representable(ch) {
      var c = ch.codePointAt(0);
      return (c >= 0x20 && c <= 0x7e) || (c >= 0xa0 && c <= 0xff) || CP1252_EXTRA[ch] !== undefined;
    }

    // Text for a pdf-lib form field. Outside WinAnsi pdf-lib throws, and the throw
    // lands in save() — it took down the whole document, not one field, so the
    // admin got nothing at all.
    function pdfSafe(value) {
      var out = '';
      var chars = Array.from(String(value == null ? '' : value));
      for (var i = 0; i < chars.length; i++) {
        var ch = chars[i];
        if (cp1252Representable(ch)) { out += ch; continue; }
        if (CP1252_TRANSLIT[ch]) { out += CP1252_TRANSLIT[ch]; continue; }
        var folded = '';
        try { folded = ch.normalize('NFKD').replace(/[̀-ͯ]/g, ''); } catch(e) { folded = ''; }
        var fchars = Array.from(folded);
        for (var j = 0; j < fchars.length; j++) {
          if (cp1252Representable(fchars[j])) out += fchars[j];
        }
      }
      return out;
    }

    // Current Swiss Basketball season as "YYYY/YYYY". Their administrative
    // season rolls over in July (2026-27 opened 23.07.2026), so a form generated
    // in August already carries the new season rather than the one that ended.
    function currentSeasonLabel() {
      var now = new Date();
      var start = (now.getMonth() + 1) >= 7 ? now.getFullYear() : now.getFullYear() - 1;
      return start + '/' + (start + 1);
    }

    async function generateLizenzantrag(item) {
      var data = getRegistrationModalValues();

      var pdfBytes = await fetch('/docs/demande_licence_d_new.pdf').then(function(r) { return r.arrayBuffer(); });
      var pdfDoc = await PDFLib.PDFDocument.load(pdfBytes);
      var form = pdfDoc.getForm();

      // Fill text fields (try/catch each in case field names change).
      // The generic "undefined_N" names map to the form's rows top-to-bottom —
      // verified against the field rectangles in the PDF: _2 sits at the NAME
      // label, _3 at VORNAME, _4 at STRASSE, _5/_6 are the narrow PLZ and wide
      // ORT boxes, _7 is E-MAIL. This mapping was previously shifted by one,
      // which put the email in the name box and the street into the PLZ box.
      try { form.getTextField('undefined').setText(pdfSafe('KSC Wiedikon')); } catch(e) {}
      try { form.getTextField('undefined_2').setText(pdfSafe(data.nachname)); } catch(e) {}
      try { form.getTextField('undefined_3').setText(pdfSafe(data.vorname)); } catch(e) {}
      try { form.getTextField('undefined_4').setText(pdfSafe(data.adresse)); } catch(e) {}
      try { form.getTextField('undefined_5').setText(pdfSafe(data.plz)); } catch(e) {}
      try { form.getTextField('undefined_6').setText(pdfSafe(data.ort)); } catch(e) {}
      try { form.getTextField('undefined_7').setText(pdfSafe(data.email)); } catch(e) {}

      // Date of birth (split to avoid timezone issues)
      if (data.geburtsdatum) {
        var dobParts = data.geburtsdatum.split('-'); // YYYY-MM-DD
        try { form.getTextField('Tag').setText(dobParts[2]); } catch(e) {}
        try { form.getTextField('Monat').setText(dobParts[1]); } catch(e) {}
        try { form.getTextField('Jahr').setText(dobParts[0]); } catch(e) {}
      }

      // Gender checkboxes
      try {
        if (data.geschlecht === 'männlich') form.getCheckBox('Mann').check();
        else if (data.geschlecht === 'weiblich') form.getCheckBox('Frau').check();
      } catch(e) {}

      // Nationality
      try {
        if (data.nationalitaet === 'Schweiz' || data.nationalitaet === 'Schweizerin, Schweizer') {
          form.getCheckBox('Schweiz').check();
        } else {
          form.getCheckBox('Andere').check();
          form.getTextField('KOPIE DES PASSES ODER DER ID BEILAGEN').setText(pdfSafe(data.nationalitaet));
        }
      } catch(e) {}

      // New member + player checkboxes
      // Tick the box matching the applicant's licensing situation; default to
      // "new member" for legacy rows with no stored situation.
      try {
        form.getCheckBox(({
          neu: 'Neues Mitglied Swiss Basketball',
          transfer_ch: 'Klubtransfer',
          transfer_intl: 'Internationaler Transfer',
          rueckkehr: 'Internationaler Transfer',
        }[item.bb_situation] || 'Neues Mitglied Swiss Basketball')).check();
      } catch(e) {}
      try { form.getCheckBox('undefined10').check(); } catch(e) {} // Spieler

      form.flatten();

      var filledPdf = await pdfDoc.save();
      downloadPdfBlob(filledPdf, 'Lizenzantrag_' + data.nachname + '_' + data.vorname + '.pdf');
    }

    // The Acknowledgment form's "National Member Federation of origin" box, from
    // the code the applicant picked on the registration form ('IT', or 'NONE'
    // when no federation ever licensed them). Mirrors federationOfOriginForPdf()
    // in public/js/registration-form.js — same shared federation table, same
    // English "FED (Country)" shape, so the club can regenerate a form the
    // applicant already downloaded and get the same answer. The country name
    // comes from Intl rather than that file's country table, which this page
    // cannot reach; the two differ only in wording Intl has since updated
    // (CZ reads "Czechia" here, "Czech Republic" there) and never in the
    // federation name, which is what actually identifies the body.
    function federationOfOriginForPdf(code) {
      if (!code) return '';
      if (code === 'NONE') return 'None (first licence)';
      var country = code;
      try { country = new Intl.DisplayNames(['en'], { type: 'region' }).of(code) || code; } catch (e) {}
      var table = window.KSCW_FEDERATIONS && window.KSCW_FEDERATIONS.basketball;
      var fed = table ? table[code] : '';
      return fed ? fed + ' (' + country + ')' : country;
    }

    async function generateFIBAPDFs(item) {
      var data = getRegistrationModalValues();

      // Player's Self Declaration
      var pdf1Bytes = await fetch('/docs/player-self-declaration.pdf').then(function(r) { return r.arrayBuffer(); });
      var pdf1 = await PDFLib.PDFDocument.load(pdf1Bytes);
      var form1 = pdf1.getForm();
      try { form1.getTextField('Last Name').setText(pdfSafe(data.nachname)); } catch(e) {}
      try { form1.getTextField('First Name').setText(pdfSafe(data.vorname)); } catch(e) {}
      try { form1.getTextField('Nationality').setText(pdfSafe(data.nationalitaet)); } catch(e) {}
      try { form1.getTextField('Current Club').setText(pdfSafe('KSC Wiedikon')); } catch(e) {}
      try { form1.getTextField('Season').setText(currentSeasonLabel()); } catch(e) {}
      form1.flatten();
      downloadPdfBlob(await pdf1.save(), 'SelfDeclaration_' + data.nachname + '_' + data.vorname + '.pdf');

      // Acknowledgment of National Team Restriction — replaces the former
      // "National Team Declaration", which FIBA no longer accepts as of the
      // 2026-27 season (Swiss Basketball licence mail, 22.07.2026).
      var pdf2Bytes = await fetch('/docs/acknowledgment-national-team-restriction-fiba.pdf').then(function(r) { return r.arrayBuffer(); });
      var pdf2 = await PDFLib.PDFDocument.load(pdf2Bytes);
      var form2 = pdf2.getForm();
      var fullName = data.vorname + ' ' + data.nachname;
      try { form2.getTextField('Player full name').setText(pdfSafe(fullName)); } catch(e) {}
      try {
        if (data.geburtsdatum) {
          var parts = data.geburtsdatum.split('-');
          form2.getTextField('Date of birth DDMMYYYY').setText(parts[2] + '/' + parts[1] + '/' + parts[0]);
        }
      } catch(e) {}
      try { form2.getTextField('Nationality  nationalities').setText(pdfSafe(data.nationalitaet)); } catch(e) {}
      try { form2.getTextField('National Member Federation of origin').setText(pdfSafe(federationOfOriginForPdf(item.federation_of_origin))); } catch(e) {}
      try { form2.getTextField('National Member Federation of destination').setText('Swiss Basketball'); } catch(e) {}
      try { form2.getTextField('Name').setText(pdfSafe(fullName)); } catch(e) {}
      form2.flatten();
      downloadPdfBlob(await pdf2.save(), 'NationalTeamRestriction_' + data.nachname + '_' + data.vorname + '.pdf');
    }

    function exportCSV(items) {
      // Match ClubDesk column format exactly
      var headers = [
        'Nachname', 'Vorname', 'Firma', 'Adresse', 'PLZ', 'Ort',
        'Telefon Privat', 'Telefon Mobil', '[Gruppen]', 'Sektion', 'Gruppe', 'Gruppen',
        'Anrede', 'Titel', 'Briefanrede', 'Benutzer-Id', 'Adress-Zusatz', 'Land',
        'Nationalität', 'Telefon Geschäft', 'Fax', 'E-Mail', 'E-Mail Alternativ',
        'Status', '[Rolle]', 'Eintritt', 'Mitgliedsjahre', 'Austritt', 'Zivilstand',
        'Geschlecht', 'Geburtsdatum', 'Jahrgang', 'Alter', 'Bemerkungen',
        'Firmen-Webseite', 'Rechnungsversand', 'Nie mahnen', 'IBAN', 'BIC', 'Kontoinhaber',
        'Lizenznummer', 'Lizenzart', 'Lizenz bestellt', 'Beitragskategorie',
        'Betrag Bezahlt', 'Clubnummer', 'Mittelschule ZH', 'Offiziellen Lizenz',
        'Mitgliederbeitrag', 'AHV Nummer', 'Passivmitglied', 'Offiziellen 100er',
        'Funktion', 'Rolle'
      ];

      var today = new Date();
      var todayStr = String(today.getDate()).padStart(2, '0') + '.' +
        String(today.getMonth() + 1).padStart(2, '0') + '.' + today.getFullYear();

      var rows = items.map(function(item) {
        // Format date DD.MM.YYYY (timezone-safe string split, NOT new Date())
        var dob = '';
        var jahrgang = '';
        if (item.geburtsdatum) {
          var parts = item.geburtsdatum.split('-'); // YYYY-MM-DD from Directus
          dob = parts[2] + '.' + parts[1] + '.' + parts[0];
          jahrgang = parts[0];
        }

        var sektion = item.membership_type === 'volleyball' ? 'Volleyball'
          : item.membership_type === 'basketball' ? 'Basketball' : 'KSCW';
        var status = item.membership_type === 'passive' ? 'Passivmitglied' : 'Aktivmitglied';
        var isPassive = item.membership_type === 'passive' ? 'ja' : '';

        // Build ClubDesk [Gruppen] format: "TeamName (Funktion)" per team
        var funktion = item.rolle || '';
        var teams = (item.team || '').split(',').map(function(t) { return t.trim(); }).filter(Boolean);
        var gruppenParts = [];
        for (var ti = 0; ti < teams.length; ti++) {
          gruppenParts.push(funktion ? teams[ti] + ' (' + funktion + ')' : teams[ti]);
        }
        var gruppenStr = gruppenParts.join(', ');
        var gruppeStr = teams.length ? teams[0] : '';

        return [
          item.nachname || '',           // Nachname
          item.vorname || '',            // Vorname
          '',                            // Firma
          item.adresse || '',            // Adresse
          item.plz || '',                // PLZ
          item.ort || '',                // Ort
          '',                            // Telefon Privat
          item.telefon_mobil || '',       // Telefon Mobil
          gruppenStr,                    // [Gruppen]
          sektion,                       // Sektion
          gruppeStr,                     // Gruppe
          gruppenStr,                    // Gruppen
          item.anrede || '',             // Anrede
          '',                            // Titel
          '',                            // Briefanrede
          '',                            // Benutzer-Id
          '',                            // Adress-Zusatz
          'Schweiz',                     // Land
          item.nationalitaet || '',      // Nationalität
          '',                            // Telefon Geschäft
          '',                            // Fax
          item.email || '',              // E-Mail
          '',                            // E-Mail Alternativ
          status,                        // Status
          '',                            // [Rolle]
          todayStr,                      // Eintritt
          '',                            // Mitgliedsjahre
          '',                            // Austritt
          '',                            // Zivilstand
          item.geschlecht || '',         // Geschlecht
          dob,                           // Geburtsdatum
          jahrgang,                      // Jahrgang
          '',                            // Alter
          item.bemerkungen || '',        // Bemerkungen
          '',                            // Firmen-Webseite
          'E-Mail',                      // Rechnungsversand
          'Nein',                        // Nie mahnen
          '',                            // IBAN
          '',                            // BIC
          '',                            // Kontoinhaber
          '',                            // Lizenznummer
          '',                            // Lizenzart
          '',                            // Lizenz bestellt
          item.beitragskategorie || '',  // Beitragskategorie
          '',                            // Betrag Bezahlt
          '',                            // Clubnummer
          item.kantonsschule || '',      // Mittelschule ZH
          item.lizenz || '',             // Offiziellen Lizenz
          '',                            // Mitgliederbeitrag
          item.ahv_nummer || '',         // AHV Nummer
          isPassive,                     // Passivmitglied
          '',                            // Offiziellen 100er
          funktion,                      // Funktion
          '',                            // Rolle
        ].map(csvEscape).join(';');
      });

      // ClubDesk's CSV interface is Windows-1252, NOT UTF-8 \u2014 its own export is
      // CP1252 and the scripted sync-up transcodes before upload (wiedisync
      // clubdesk-update.js toCp1252Buffer). This file is imported into ClubDesk by
      // hand, so a UTF-8 attachment mangles every accented name (D\u00FCrig \u2192 D\u00C3\u00BCrig)
      // in the legal member register. No BOM either: ClubDesk's own export has
      // none, and a BOM would leave the first header reading "\u00EF\u00BB\u00BFNachname" and
      // fail to map.
      var csv = headers.join(';') + '\n' + rows.join('\n');
      var blob = new Blob([toCp1252Bytes(csv)], { type: 'text/csv;charset=windows-1252;' });
      downloadBlob(blob, 'kscw_anmeldungen_' + new Date().toISOString().substring(0, 10) + '.csv');
    }

    // Bytes for the ClubDesk CSV. Same repertoire and same transliteration as
    // pdfSafe above, so one registration yields one spelling everywhere; mirrors
    // wiedisync's toCp1252Buffer (clubdesk-update.js), which writes into the same
    // member register from the scripted sync.
    function toCp1252Bytes(str) {
      var bytes = [];
      function pushChar(ch) {
        var cp = ch.codePointAt(0);
        if (cp <= 0x7F || (cp >= 0xA0 && cp <= 0xFF)) { bytes.push(cp); return true; }
        if (CP1252_EXTRA[ch] !== undefined) { bytes.push(CP1252_EXTRA[ch]); return true; }
        return false;
      }
      var chars = Array.from(String(str == null ? '' : str));
      for (var i = 0; i < chars.length; i++) {
        var ch = chars[i];
        if (pushChar(ch)) continue;
        var base = CP1252_TRANSLIT[ch] || ch.normalize('NFKD').replace(/[̀-ͯ]/g, '');
        var ok = base.length > 0;
        var mark = bytes.length;
        var baseChars = Array.from(base);
        for (var j = 0; j < baseChars.length; j++) {
          if (!pushChar(baseChars[j])) { ok = false; break; }
        }
        if (!ok) { bytes.length = mark; bytes.push(0x3F); } // '?'
      }
      return new Uint8Array(bytes);
    }

    // SECURITY: Neutralize spreadsheet formula prefixes (=, +, -, @, TAB, CR) so
    // attacker-controlled fields cannot execute formulas / DDE when admins open
    // the CSV in Excel / Numbers / LibreOffice.
    function csvSafe(val) {
      var s = String(val == null ? '' : val);
      if (/^[=+\-@\t\r]/.test(s)) s = "'" + s;
      return '"' + s.replace(/"/g, '""') + '"';
    }

    function csvEscape(val) {
      val = String(val == null ? '' : val);
      if (/^[=+\-@\t\r]/.test(val)) val = "'" + val;
      if (val.indexOf(';') !== -1 || val.indexOf('"') !== -1 || val.indexOf('\n') !== -1 || val.charAt(0) === "'") {
        return '"' + val.replace(/"/g, '""') + '"';
      }
      return val;
    }

    // ── Seitentexte (page text) ────────────────────────────────
    // Edits the strings the site is built from, without touching the repo.
    //
    // The dictionaries in the website repo stay the original wording; a save here
    // writes an *override* keyed by the same i18n key, and "Original" deletes that
    // override. So nothing an admin does in this tab can lose the wording the site
    // shipped with, and a page whose text was never edited is byte-for-byte what
    // the developers wrote.
    //
    // Text only, deliberately: values are applied with textContent at runtime and
    // through Astro's escaping at build time (see the note in public/js/i18n.js and
    // tests/unit/no-i18n-html.test.ts). A link inside a sentence still needs a code
    // change — which is why "<" is refused here rather than silently stripped.

    /** '/volleyball/spielplanung — Spielplanung', or 'Gemeinsame Elemente — Header'. */
    function siteTextGroupLabel(g) {
      if (g.kind === 'other') return t('siteTextOther');
      // Header/Footer and the runtime form messages belong to no single page.
      if (g.kind === 'component' || g.kind === 'runtime') return t('siteTextShared') + ' — ' + g.path;
      var title = g.labelKey && _siteText.defaults[adminLang][g.labelKey];
      return g.path + (title ? ' — ' + title : '');
    }

    function siteTextDefault(key, lang) {
      var d = _siteText.defaults[lang];
      return (d && d[key]) || '';
    }

    /** The value the site currently shows: the override if one exists, else the default. */
    function siteTextCurrent(key, lang) {
      var o = _siteText.overrides[key];
      if (o && typeof o[lang] === 'string' && o[lang] !== '') return o[lang];
      return siteTextDefault(key, lang);
    }

    /**
     * Cosmetic pre-check, mirroring what the endpoint enforces server-side.
     * Catching it here means the admin gets a sentence in their own language
     * instead of a rejected request.
     */
    function siteTextProblem(value, fallback) {
      if (!value.trim()) return t('siteTextEmptyValue');
      if (value.indexOf('<') !== -1) return t('siteTextNoMarkup');
      var required = fallback.match(/\{[a-zA-Z0-9_]+\}/g) || [];
      for (var i = 0; i < required.length; i++) {
        // A dropped {placeholder} does not fail loudly — it renders a sentence with
        // a hole in it ("Es sind Teams angemeldet"), which is why it is refused.
        if (value.indexOf(required[i]) === -1) {
          return t('siteTextPlaceholderMissing').replace('{ph}', required[i]);
        }
      }
      return null;
    }

    function renderSiteTextEditor() {
      var content = document.getElementById('admin-content');
      if (!content || !_siteText) return;
      content.textContent = '';

      // Open on a single page rather than all ~700 strings: "Alle Seiten" builds two
      // textareas per string, which is a slow first paint for a list nobody reads
      // top to bottom. It stays available for searching across the whole site.
      if (_siteTextGroupId === null && _siteText.groups.length) {
        _siteTextGroupId = _siteText.groups[0].id;
      }

      var intro = document.createElement('p');
      intro.className = 'admin-list-meta';
      intro.style.cssText = 'margin:0 0 12px;max-width:70ch;line-height:1.5;';
      intro.textContent = t('siteTextIntro');
      content.appendChild(intro);

      // ── Page picker + search ──
      var bar = document.createElement('div');
      bar.style.cssText = 'display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;';

      var picker = document.createElement('select');
      picker.className = 'form-select';
      picker.style.cssText = 'flex:1 1 320px;min-width:0;';
      var allOpt = document.createElement('option');
      allOpt.value = '';
      allOpt.textContent = t('siteTextAllPages');
      picker.appendChild(allOpt);
      _siteText.groups.forEach(function(g) {
        var opt = document.createElement('option');
        opt.value = g.id;
        opt.textContent = siteTextGroupLabel(g);
        if (g.id === _siteTextGroupId) opt.selected = true;
        picker.appendChild(opt);
      });
      picker.addEventListener('change', function() {
        _siteTextGroupId = this.value;
        renderSiteTextEditor();
      });
      bar.appendChild(picker);

      var search = document.createElement('input');
      search.type = 'search';
      search.className = 'form-input';
      search.style.cssText = 'flex:1 1 220px;min-width:0;';
      search.placeholder = t('siteTextSearch');
      search.value = _siteTextQuery;
      var searchTimer = null;
      search.addEventListener('input', function() {
        var value = this.value;
        // Re-rendering on every keystroke would rebuild up to ~700 rows and drop
        // focus with it; a short debounce keeps typing smooth.
        clearTimeout(searchTimer);
        searchTimer = setTimeout(function() {
          _siteTextQuery = value;
          renderSiteTextEditor();
          var again = document.getElementById('site-text-search');
          if (again) { again.focus(); again.setSelectionRange(again.value.length, again.value.length); }
        }, 250);
      });
      search.id = 'site-text-search';
      bar.appendChild(search);
      content.appendChild(bar);

      // ── Rows ──
      var query = _siteTextQuery.trim().toLowerCase();
      var groups = _siteText.groups.filter(function(g) {
        return !_siteTextGroupId || g.id === _siteTextGroupId;
      });

      var list = document.createElement('div');
      list.className = 'admin-list';
      var shown = 0;
      var seen = {}; // a key used on two pages is edited once, not twice

      groups.forEach(function(g) {
        var matching = g.keys.filter(function(entry) {
          if (seen[entry.key]) return false;
          if (!query) return true;
          return entry.key.toLowerCase().indexOf(query) !== -1
            || siteTextCurrent(entry.key, 'de').toLowerCase().indexOf(query) !== -1
            || siteTextCurrent(entry.key, 'en').toLowerCase().indexOf(query) !== -1;
        });
        if (!matching.length) return;

        // Only worth a heading when more than one group is on screen.
        if (!_siteTextGroupId) {
          var heading = document.createElement('h3');
          heading.className = 'admin-list-title';
          heading.style.cssText = 'margin:18px 0 6px;font-size:0.95em;color:var(--text-muted);';
          heading.textContent = siteTextGroupLabel(g);
          list.appendChild(heading);
        }

        matching.forEach(function(entry) {
          seen[entry.key] = true;
          shown++;
          list.appendChild(siteTextRow(entry));
        });
      });

      if (!shown) {
        var empty = document.createElement('div');
        empty.className = 'admin-empty';
        empty.textContent = t('siteTextNoMatches');
        content.appendChild(empty);
        return;
      }

      content.appendChild(list);
    }

    /** One editable string: DE + EN, with Save / Original / Übersetzen. */
    function siteTextRow(entry) {
      var key = entry.key;
      var row = document.createElement('div');
      row.className = 'admin-list-item';
      row.style.cssText = 'display:block;';

      // ── Header line: kind, key, changed badge ──
      var head = document.createElement('div');
      head.style.cssText = 'display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px;';

      if (entry.kind !== 'text') {
        var kindBadge = document.createElement('span');
        kindBadge.className = 'admin-badge admin-badge-gray';
        kindBadge.textContent = entry.kind === 'attr' ? t('siteTextKindAttr') : t('siteTextKindMeta');
        head.appendChild(kindBadge);
      }

      var keyLabel = document.createElement('code');
      keyLabel.style.cssText = 'font-size:0.75em;color:var(--text-muted);';
      keyLabel.textContent = key;
      head.appendChild(keyLabel);

      var changedBadge = document.createElement('span');
      changedBadge.className = 'admin-badge admin-badge-green';
      changedBadge.textContent = t('siteTextChanged');
      head.appendChild(changedBadge);

      var status = document.createElement('span');
      status.style.cssText = 'font-size:0.8em;margin-left:auto;';
      head.appendChild(status);
      row.appendChild(head);

      // ── The two language boxes ──
      var boxes = {};
      ['de', 'en'].forEach(function(lang) {
        var wrap = document.createElement('div');
        wrap.style.cssText = 'display:flex;gap:8px;align-items:flex-start;margin-bottom:6px;';

        var tag = document.createElement('span');
        tag.style.cssText = 'flex:0 0 24px;font-size:0.75em;color:var(--text-muted);padding-top:8px;';
        tag.textContent = lang.toUpperCase();
        wrap.appendChild(tag);

        var box = document.createElement('textarea');
        box.className = 'form-input';
        box.style.cssText = 'flex:1 1 auto;min-width:0;resize:vertical;font:inherit;';
        box.value = siteTextCurrent(key, lang);
        box.rows = box.value.length > 90 ? 3 : 1;
        box.addEventListener('input', refreshChrome);
        boxes[lang] = box;
        wrap.appendChild(box);

        row.appendChild(wrap);
      });

      // ── Actions ──
      var actions = document.createElement('div');
      actions.className = 'admin-list-actions';
      actions.style.cssText = 'display:flex;gap:8px;justify-content:flex-end;';

      var translateBtn = document.createElement('button');
      translateBtn.type = 'button';
      translateBtn.className = 'admin-btn admin-btn-ghost admin-btn-sm';
      translateBtn.textContent = t('siteTextTranslate');
      translateBtn.addEventListener('click', function() {
        translateSiteText(boxes.de.value, boxes.en, status, refreshChrome);
      });
      actions.appendChild(translateBtn);

      var revertBtn = document.createElement('button');
      revertBtn.type = 'button';
      revertBtn.className = 'admin-btn admin-btn-ghost admin-btn-sm';
      revertBtn.textContent = t('siteTextRevert');
      revertBtn.addEventListener('click', function() {
        confirmModal(t('siteTextRevertConfirm')).then(function(ok) {
          if (!ok) return;
          revertSiteTextRow(key, boxes, status, refreshChrome);
        });
      });
      actions.appendChild(revertBtn);

      var saveBtn = document.createElement('button');
      saveBtn.type = 'button';
      saveBtn.className = 'admin-btn admin-btn-primary admin-btn-sm';
      saveBtn.textContent = t('save');
      saveBtn.addEventListener('click', function() {
        var values = { de: boxes.de.value.trim(), en: boxes.en.value.trim() };
        var problem = siteTextProblem(values.de, siteTextDefault(key, 'de'))
          || siteTextProblem(values.en, siteTextDefault(key, 'en'));
        if (problem) {
          status.textContent = '✕ ' + problem;
          status.style.color = '#dc2626';
          return;
        }
        // Show exactly what will be stored. Without this the box keeps the
        // untrimmed text while the saved value is trimmed, so the row stays
        // "dirty" after a successful save and looks like it did not go through.
        boxes.de.value = values.de;
        boxes.en.value = values.en;
        // A language left at the shipped wording is sent as null — "not
        // overridden" — rather than as a copy of it. Storing the copy would mean a
        // later improvement to that language in the repo was silently shadowed by
        // the old default, which is the drift this whole design avoids. Both null
        // is how the endpoint recognises a revert.
        saveSiteTextRow(key, {
          de: values.de === siteTextDefault(key, 'de') ? null : values.de,
          en: values.en === siteTextDefault(key, 'en') ? null : values.en,
        }, status, refreshChrome);
      });
      actions.appendChild(saveBtn);
      row.appendChild(actions);

      /** Keeps the badge and the two buttons honest about the row's current state. */
      function refreshChrome() {
        var hasOverride = !!_siteText.overrides[key];
        var dirty = boxes.de.value !== siteTextCurrent(key, 'de')
          || boxes.en.value !== siteTextCurrent(key, 'en');
        changedBadge.style.display = hasOverride ? '' : 'none';
        // Nothing to reset on a row that has never been edited.
        revertBtn.style.display = hasOverride ? '' : 'none';
        saveBtn.disabled = !dirty; // .admin-btn:disabled already dims it
      }
      refreshChrome();

      return row;
    }

    // WEB-SEC-5 / WEB-ADM-6 (info, accepted), same as the news/event title
    // translation: the text is sent to api.mymemory.translated.net. It is website
    // copy that is public by definition, so nothing confidential leaves the admin.
    function translateSiteText(source, targetBox, statusEl, done) {
      if (!source || source.trim().length < 3) return;
      statusEl.style.color = 'var(--text-muted)';
      statusEl.textContent = '…';
      fetch('https://api.mymemory.translated.net/get?q=' + encodeURIComponent(source) + '&langpair=de|en')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var translated = data.responseData && data.responseData.translatedText;
          if (!translated) throw new Error('empty');
          // The API shouts back at short inputs ("SAVE" for "Speichern").
          if (translated === translated.toUpperCase() && source !== source.toUpperCase()) {
            translated = translated.charAt(0).toUpperCase() + translated.slice(1).toLowerCase();
          }
          targetBox.value = translated;
          statusEl.textContent = '';
          done();
        })
        .catch(function() {
          statusEl.style.color = '#dc2626';
          statusEl.textContent = '✕ ' + t('translationFailed');
        });
    }

    function saveSiteTextRow(key, values, statusEl, done) {
      statusEl.style.color = 'var(--text-muted)';
      statusEl.textContent = t('saving');
      wadmin('site_text', 'text/' + encodeURIComponent(key), {
        // PATCH rather than PUT: Directus's CORS preflight allows
        // GET,POST,PATCH,DELETE only, so a cross-origin PUT from here never
        // reaches the endpoint at all.
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(values),
      })
        .then(function(res) {
          if (!res.ok) return res.json().then(function(body) {
            throw new Error((body && body.error) || 'HTTP ' + res.status);
          }, function() { throw new Error('HTTP ' + res.status); });
          return res.json();
        })
        .then(function(body) {
          // The endpoint drops a row whose values match the shipped text in both
          // languages — editing a string back to its original is a revert, and
          // leaving a no-op row behind would keep it flagged as "changed" forever.
          if (body && body.data) _siteText.overrides[key] = { de: body.data.de, en: body.data.en };
          else delete _siteText.overrides[key];
          statusEl.style.color = '#16a34a';
          statusEl.textContent = '✓ ' + t('siteTextSaved');
          done();
        })
        .catch(function(err) {
          statusEl.style.color = '#dc2626';
          statusEl.textContent = '✕ ' + t('siteTextSaveFailed') + err.message;
        });
    }

    function revertSiteTextRow(key, boxes, statusEl, done) {
      statusEl.style.color = 'var(--text-muted)';
      statusEl.textContent = t('saving');
      wadmin('site_text', 'text/' + encodeURIComponent(key), { method: 'DELETE' })
        .then(function(res) {
          if (!res.ok && res.status !== 404) throw new Error('HTTP ' + res.status);
          delete _siteText.overrides[key];
          boxes.de.value = siteTextDefault(key, 'de');
          boxes.en.value = siteTextDefault(key, 'en');
          statusEl.style.color = '#16a34a';
          statusEl.textContent = '✓ ' + t('siteTextReverted');
          done();
        })
        .catch(function(err) {
          statusEl.style.color = '#dc2626';
          statusEl.textContent = '✕ ' + t('siteTextSaveFailed') + err.message;
        });
    }

    // ── Sponsors List ──────────────────────────────────────────
    function renderSponsorsList(items) {
      var content = document.getElementById('admin-content');
      if (!content) return;
      content.textContent = '';

      if (!items.length) {
        var emptyDiv = document.createElement('div');
        emptyDiv.className = 'admin-empty';
        emptyDiv.textContent = t('sponsorNoEntries');
        content.appendChild(emptyDiv);
        return;
      }

      var list = document.createElement('div');
      list.className = 'admin-list';

      items.forEach(function(sp) {
        var row = document.createElement('div');
