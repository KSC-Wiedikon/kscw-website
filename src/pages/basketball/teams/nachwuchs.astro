---
import PageLayout from '../../../layouts/PageLayout.astro';
import CTA from '../../../components/CTA.astro';
import YouthCards from '../../../components/YouthCards.astro';
import { t } from '../../../lib/i18n';
import { getYouthBasketball } from '../../../lib/fetch/youthBasketball';

const locale = 'de';
// Coaches (teams.coach M2M) + training slots (hall_slots), live from Directus.
const youth = await getYouthBasketball();

// Age sections, top (U18) to bottom (U8). Each entry lists the age-group codes
// that section shows; YouthCards then renders one card per Directus team in
// that group — two if the club runs two squads, none if it runs none. The chip
// label/colour stay here because they describe the slot, not the team: 2026/27
// has no U16 girls' team, so that card simply does not render.
const GROUPS = [
  {
    anchor: 'hu18', heading: 'U18',
    cards: [
      { code: 'HU18', anchor: undefined, chipBg: '#f97316', chipText: '#ffffff',
        chipKey: 'basketballTeamsNachwuchsU18BoysChip', chipLabel: 'U18 Knaben' },
      { code: 'DU18', anchor: 'du18', chipBg: '#c084fc', chipText: '#ffffff',
        chipKey: 'basketballTeamsNachwuchsU18GirlsChip', chipLabel: 'U18 Mädchen' },
    ],
  },
  {
    anchor: 'hu16', heading: 'U16',
    cards: [
      { code: 'HU16', anchor: undefined, chipBg: '#fb923c', chipText: '#ffffff',
        chipKey: 'basketballTeamsNachwuchsU16BoysChip', chipLabel: 'U16 Knaben' },
      { code: 'DU16', anchor: 'du16', chipBg: '#d8b4fe', chipText: '#1e1e1e',
        chipKey: 'basketballTeamsNachwuchsU16GirlsChip', chipLabel: 'U16 Mädchen' },
    ],
  },
  {
    anchor: 'hu14', heading: 'U14',
    cards: [
      { code: 'HU14', anchor: undefined, chipBg: '#fdba74', chipText: '#1e1e1e',
        chipKey: 'basketballTeamsNachwuchsU14BoysChip', chipLabel: 'U14 Knaben' },
      { code: 'DU14', anchor: 'du14', chipBg: '#e9d5ff', chipText: '#1e1e1e',
        chipKey: 'basketballTeamsNachwuchsU14GirlsChip', chipLabel: 'U14 Mädchen' },
    ],
  },
  {
    anchor: 'hu12', heading: 'U12',
    cards: [
      { code: 'HU12', anchor: undefined, chipBg: '#fed7aa', chipText: '#1e1e1e',
        chipKey: 'basketballTeamsNachwuchsU12BoysChip', chipLabel: 'U12 Knaben' },
      { code: 'DU12', anchor: 'du12', chipBg: '#f3e8ff', chipText: '#1e1e1e',
        chipKey: 'basketballTeamsNachwuchsU12GirlsChip', chipLabel: 'U12 Mädchen' },
    ],
  },
  {
    anchor: 'mu10', heading: 'U10',
    cards: [
      { code: 'MU10', anchor: 'du10', chipBg: '#14b8a6', chipText: '#ffffff',
        chipKey: undefined, chipLabel: 'U10 Mixed' },
    ],
  },
  {
    anchor: 'mu8', heading: 'U8',
    cards: [
      { code: 'MU8', anchor: undefined, chipBg: '#0d9488', chipText: '#ffffff',
        chipKey: undefined, chipLabel: 'U8 Mixed' },
    ],
  },
]

---
<PageLayout
  title="Basketball Nachwuchs — KSC Wiedikon"
  titleKey="basketballTeamsNachwuchsMetaTitle"
  description="KSC Wiedikon Basketball Nachwuchs — Alle Jugendteams von U8 bis U18 im Überblick."
  descriptionKey="basketballTeamsNachwuchsMetaDescription"
  locale={locale}
  pageTitle={t(locale, 'bbYouthTitle')}
  pageTitleKey="bbYouthTitle"
  pageSubtitle={t(locale, 'bbYouthSubtitle')}
  pageSubtitleKey="bbYouthSubtitle"
>
  <!-- Youth Teams -->
  <section class="section">
    <div class="container">

      <div class="youth-sections">
        {GROUPS.map(group => (
          <div id={group.anchor}>
            <div class="youth-section-title">
              <h2>{group.heading}</h2>
            </div>
            <div class="youth-grid">
              {group.cards.map(card => (
                <YouthCards
                  code={card.code}
                  data={youth}
                  anchor={card.anchor}
                  chipBg={card.chipBg}
                  chipText={card.chipText}
                  chipKey={card.chipKey}
                  chipLabel={card.chipLabel}
                  titleKey={card.chipKey && card.chipKey.replace(/Chip$/, 'Name')}
                  title={card.chipLabel}
                />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTA
    title={t(locale, 'bbYouthCTA')}
    titleKey="bbYouthCTA"
    text={t(locale, 'bbYouthCTAText')}
    textKey="bbYouthCTAText"
    buttonLabel={t(locale, 'bbYouthCTAButton')}
    buttonLabelKey="bbYouthCTAButton"
    buttonHref="/club/kontakt?sport=basketball&team=Nachwuchs"
  />

  <script src="../../../islands/scroll-animations.ts"></script>
  <!-- Eligible Jahrgänge, recomputed live: the categories shift on 1 August and
       no rebuild is triggered by a date alone. -->
  <script is:inline src="/js/birth-years.js"></script>
  <!-- Live open/waiting-list status — overrides the build-time render so
       open_for_players + waitlist_url changes appear without a site rebuild. -->
  <script is:inline src="/js/youth-status.js"></script>
</PageLayout>

<style>
  .youth-sections { display: flex; flex-direction: column; gap: var(--space-2xl); }
  .youth-section-title {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--border);
  }
  .youth-section-title .chip {
    font-size: var(--text-sm);
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    display: inline-block;
  }
  .youth-section-title h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    margin: 0;
  }
  .youth-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }
  /* .youth-card* styles live in components/YouthCards.astro, which renders
     that markup — Astro scopes styles per component, so they cannot live here. */
  /* .youth-meta styles live in components/YouthMeta.astro */
</style>
