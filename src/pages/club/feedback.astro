---
import PageLayout from '../../layouts/PageLayout.astro';
import { t } from '../../lib/i18n';

const locale = 'de';
---
<PageLayout
  title="Feedback — KSC Wiedikon"
  titleKey="clubFeedbackMetaTitle"
  description="Melde Bugs, schlage Features vor oder gib uns Feedback."
  descriptionKey="clubFeedbackMetaDescription"
  locale={locale}
  pageTitle={t(locale, 'feedbackTitle')}
  pageTitleKey="feedbackTitle"
  pageSubtitle={t(locale, 'feedbackSubtitle')}
  pageSubtitleKey="feedbackSubtitle"
>
  <section class="section">
    <div class="container">
      <div class="feedback-layout">

        <!-- Feedback Form -->
        <div class="feedback-form-wrapper">
          <form id="feedback-form" novalidate>
            <!-- Type selector (pill buttons) -->
            <div class="feedback-type-selector">
              <button type="button" class="feedback-type-pill active" data-type="bug">
                <i data-lucide="bug"></i> <span data-i18n="feedbackTypeBug">{t(locale, 'feedbackTypeBug')}</span>
              </button>
              <button type="button" class="feedback-type-pill" data-type="feature">
                <i data-lucide="lightbulb"></i> <span data-i18n="feedbackTypeFeature">{t(locale, 'feedbackTypeFeature')}</span>
              </button>
              <button type="button" class="feedback-type-pill" data-type="feedback">
                <i data-lucide="message-circle"></i> <span data-i18n="feedbackTypeFeedback">{t(locale, 'feedbackTypeFeedback')}</span>
              </button>
            </div>

            <!-- Title -->
            <div class="form-group">
              <label for="feedback-title"><span data-i18n="feedbackFieldTitle">{t(locale, 'feedbackFieldTitle')}</span> *</label>
              <input type="text" id="feedback-title" name="title" required
                placeholder={t(locale, 'feedbackFieldTitlePlaceholder')} data-i18n-placeholder="feedbackFieldTitlePlaceholder">
            </div>

            <!-- Description -->
            <div class="form-group">
              <label for="feedback-description"><span data-i18n="feedbackFieldDescription">{t(locale, 'feedbackFieldDescription')}</span> *</label>
              <textarea id="feedback-description" name="description" rows="5" required
                placeholder={t(locale, 'feedbackFieldDescriptionPlaceholder')} data-i18n-placeholder="feedbackFieldDescriptionPlaceholder"></textarea>
            </div>

            <!-- Source URL -->
            <div class="form-group">
              <label for="feedback-url">
                <span data-i18n="feedbackFieldUrl">{t(locale, 'feedbackFieldUrl')}</span>
                <span class="form-optional">(<span data-i18n="feedbackOptional">{t(locale, 'feedbackOptional')}</span>)</span>
              </label>
              <input type="url" id="feedback-url" name="source_url"
                placeholder={t(locale, 'feedbackFieldUrlPlaceholder')} data-i18n-placeholder="feedbackFieldUrlPlaceholder">
            </div>

            <!-- Screenshot upload -->
            <div class="form-group">
              <label for="feedback-screenshot">
                <span data-i18n="feedbackFieldScreenshot">{t(locale, 'feedbackFieldScreenshot')}</span>
                <span class="form-optional">(<span data-i18n="feedbackOptional">{t(locale, 'feedbackOptional')}</span>)</span>
              </label>
              <div class="feedback-dropzone" id="feedback-dropzone">
                <i data-lucide="paperclip"></i>
                <span data-i18n="feedbackFieldScreenshotHint">{t(locale, 'feedbackFieldScreenshotHint')}</span>
                <input type="file" id="feedback-screenshot" name="screenshot"
                  accept="image/png,image/jpeg,image/webp" hidden>
              </div>
              <div class="feedback-file-preview" id="feedback-file-preview" hidden>
                <span id="feedback-file-name"></span>
                <button type="button" id="feedback-file-remove" aria-label="Remove">
                  <i data-lucide="x"></i>
                </button>
              </div>
            </div>

            <!-- Name & Email (optional, for anonymous visitors) -->
            <div class="form-row">
              <div class="form-group">
                <label for="feedback-name">
                  <span data-i18n="feedbackFieldName">{t(locale, 'feedbackFieldName')}</span>
                  <span class="form-optional">(<span data-i18n="feedbackOptional">{t(locale, 'feedbackOptional')}</span>)</span>
                </label>
                <input type="text" id="feedback-name" name="name"
                  placeholder={t(locale, 'feedbackFieldNamePlaceholder')} data-i18n-placeholder="feedbackFieldNamePlaceholder">
              </div>
              <div class="form-group">
                <label for="feedback-email">
                  <span data-i18n="feedbackFieldEmail">{t(locale, 'feedbackFieldEmail')}</span>
                  <span class="form-optional">(<span data-i18n="feedbackOptional">{t(locale, 'feedbackOptional')}</span>)</span>
                </label>
                <input type="email" id="feedback-email" name="email"
                  placeholder={t(locale, 'feedbackFieldEmailPlaceholder')} data-i18n-placeholder="feedbackFieldEmailPlaceholder">
              </div>
            </div>

            <!-- Privacy consent -->
            <div class="form-group consent-group">
              <label class="consent-label">
                <input type="checkbox" id="privacy-consent" name="privacy_consent" required>
                <span data-i18n-html="clubFeedbackPrivacyConsent">Ich habe die <a href="/weiteres/datenschutz" target="_blank">Datenschutzerklärung</a> gelesen und bin damit einverstanden.</span>
              </label>
            </div>

            <!-- Turnstile CAPTCHA + Submit -->
            <div class="form-actions">
              <div id="turnstile-container"></div>
              <button type="submit" class="btn btn-primary form-submit">
                <i data-lucide="send"></i> <span data-i18n="feedbackSubmit">{t(locale, 'feedbackSubmit')}</span>
              </button>
            </div>

            <!-- Feedback message -->
            <div id="form-feedback" class="form-feedback" hidden></div>
          </form>

          <!-- Wiedisync cross-link -->
          <div class="feedback-wiedisync-hint">
            <i data-lucide="zap"></i>
            <span data-i18n="feedbackWiedisyncHint">{t(locale, 'feedbackWiedisyncHint')}</span>
            <a href="https://wiedisync.kscw.ch/feedback" data-i18n="feedbackWiedisyncLink">{t(locale, 'feedbackWiedisyncLink')}</a>
          </div>
        </div>

      </div>

      <!-- Changelog (German — shown by default) -->
      <div data-lang-only="de">
      <div class="changelog-section">
        <h2 class="changelog-heading">
          <i data-lucide="scroll-text"></i>
          {t(locale, 'changelogTitle')}
          <span class="changelog-badge">v1.0.0</span>
        </h2>

        <div class="changelog-entry">
          <div class="changelog-meta">v1.0.0 — 2026-06-19</div>
          <div class="changelog-group">
            <h3>Website &amp; Navigation</h3>
            <ul>
              <li>Zweisprachige Website (Deutsch / Englisch) mit einer kanonischen URL pro Seite und einer Sprachumschaltung, die deine Wahl merkt</li>
              <li>Live auf der vereinseigenen Domain kscw.ch</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Teams</h3>
            <ul>
              <li>Dynamische Teamseiten (Volleyball und Basketball) mit Live-Daten aus Directus: Spiele, Tabellen, Kader, Fotos und eine wöchentliche Trainingsübersicht aus dem echten Hallenplan</li>
              <li>Auf- / Abstiegsbänder in den Tabellen, saisonstabile Team-Zuordnung über den Jahreswechsel hinweg, und ein Basketball-Nachwuchsbereich mit echten Trainer*innen und Trainingszeiten</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Spiele, Tabelle &amp; Kalender</h3>
            <ul>
              <li>Spielzeilen auf der Startseite und ein Spiel-Detailfenster mit Sätzen, Schiedsrichtern und Spielort</li>
              <li>Eine Anzeigetafel mit Umschaltung Absolut / pro Spiel, und ein Live-Kalender mit Event-Tooltips und Detailfenstern</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Anmeldung &amp; Mitgliedschaft</h3>
            <ul>
              <li>Ein einheitliches Online-Anmeldeformular für Volleyball, Basketball und Passivmitgliedschaft, mit Ausweis-Upload, PDF-Vorausfüllung der Lizenzformulare und Turnstile-Spamschutz</li>
              <li>Ein Admin-Bereich für Anmeldungen mit Freigabe- / Ablehnungs-Workflow, ClubDesk-CSV-Export und automatischen Bestätigungs-E-Mails</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>News, Events &amp; Kurse</h3>
            <ul>
              <li>Vereinsnews auf der Startseite und eine eigene News-Seite mit RSS, Kalender-Events mit Anmeldelinks und Live-Anmeldezahlen, sowie Schreiberkurse mit „Zum Kalender hinzufügen“</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Kontakt &amp; Feedback</h3>
            <ul>
              <li>Ein zentrales Kontaktformular, das die richtigen Trainer*innen erreicht, ohne deren E-Mail-Adressen preiszugeben</li>
              <li>Ein Feedback-Formular (Bug / Feature / Feedback) mit Screenshot-Upload, das automatisch ein GitHub-Issue erstellt</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Inhaltsseiten</h3>
            <ul>
              <li>Über uns mit Vereinsgeschichte und Karte, der Vorstand als Organigramm, Reglemente mit SVRZ-Einbettungen, Sponsoren, Impressum und Datenschutz</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Design &amp; Feinschliff</h3>
            <ul>
              <li>Animiertes Hero, Scroll-Fortschrittsbalken, Karten-Spotlight, 3D-Tilt auf Team-Karten und bereichsabhängige Sparkle-Effekte — alle respektieren „Bewegung reduzieren“</li>
              <li>Schweizer Datumsformat tt.mm.jjjj und 24-Stunden-Zeiten überall, mit hellem / dunklem Theme</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Admin &amp; Infrastruktur</h3>
            <ul>
              <li>Ein versteckter Admin-Bereich mit Bereichsberechtigungen pro Person, serverseitig durchgesetzt — nicht nur in der UI versteckt</li>
              <li>Gebaut mit Astro 6, Directus-REST-Backend, Cloudflare-Pages-Hosting und gehärteten CSP- / Sicherheits-Headern</li>
            </ul>
          </div>
        </div>
      </div>
      </div><!-- /data-lang-only="de" -->

      <!-- Changelog (English — shown when <html lang="en"> -->
      <div data-lang-only="en">
      <div class="changelog-section">
        <h2 class="changelog-heading">
          <i data-lucide="scroll-text"></i>
          {t(locale, 'changelogTitle')}
          <span class="changelog-badge">v1.0.0</span>
        </h2>

        <div class="changelog-entry">
          <div class="changelog-meta">v1.0.0 — 2026-06-19</div>
          <div class="changelog-group">
            <h3>Site &amp; navigation</h3>
            <ul>
              <li>Bilingual German / English site with a single canonical URL per page and a language toggle that remembers your choice</li>
              <li>Live on the club's own domain, kscw.ch</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Teams</h3>
            <ul>
              <li>Dynamic team pages (volleyball and basketball) with live data from Directus: games, rankings, roster, photos and a weekly training summary from the real hall schedule</li>
              <li>Promotion / relegation colour bands on rankings, season-stable team matching that survives the yearly rollover, and a basketball youth section with live coaches and training times</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Games, scoreboard &amp; calendar</h3>
            <ul>
              <li>Homepage game rows and a game detail modal with sets, referees and venue</li>
              <li>A scoreboard with Absolute / Per-Game toggle, and a live calendar with event tooltips and detail modals</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Registration &amp; membership</h3>
            <ul>
              <li>A unified online registration form for volleyball, basketball and passive memberships, with ID upload, PDF pre-fill of the licence forms and Turnstile spam protection</li>
              <li>An admin registrations tab with approve / reject workflow, ClubDesk CSV export and automatic confirmation emails</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>News, events &amp; courses</h3>
            <ul>
              <li>Club news on the homepage and a news page with RSS, calendar events with sign-up links and live submission counts, and scorer courses with an „add to calendar“ button</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Contact &amp; feedback</h3>
            <ul>
              <li>A central contact form that reaches the right coaches without exposing their email addresses</li>
              <li>A feedback form (bug / feature / feedback) with screenshot upload that opens a GitHub issue automatically</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Content pages</h3>
            <ul>
              <li>About us with club history and a map, the board as an org chart, regulations with SVRZ embeds, sponsors, imprint and privacy policy</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Design &amp; polish</h3>
            <ul>
              <li>Animated hero, scroll-progress bar, card spotlight, 3D-tilt team cards and section-aware sparkle effects — all respecting „reduce motion“</li>
              <li>Swiss dd.mm.yyyy dates and HH:MM times throughout, with a dark / light theme</li>
            </ul>
          </div>
          <div class="changelog-group">
            <h3>Admin &amp; infrastructure</h3>
            <ul>
              <li>A hidden admin area with per-person area permissions enforced on the server, not just hidden in the UI</li>
              <li>Built on Astro 6 with a Directus REST backend, Cloudflare Pages hosting and hardened CSP / security headers</li>
            </ul>
          </div>
        </div>
      </div>
      </div><!-- /data-lang-only="en" -->

    </div>
  </section>

  <!-- Turnstile script -->
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <!-- Form handler -->
  <script is:inline src="/js/feedback-form.js"></script>

<style>
  .feedback-layout {
    max-width: 640px;
    margin: 0 auto;
  }

  .feedback-type-selector {
    display: flex;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
  }

  .feedback-type-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-md);
    border-radius: 999px;
    border: 2px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .feedback-type-pill:hover {
    border-color: var(--kscw-blue);
    color: var(--kscw-blue);
  }

  .feedback-type-pill.active[data-type="bug"] {
    background: #dc2626;
    border-color: #dc2626;
    color: white;
  }

  .feedback-type-pill.active[data-type="feature"] {
    background: var(--kscw-blue);
    border-color: var(--kscw-blue);
    color: white;
  }

  .feedback-type-pill.active[data-type="feedback"] {
    background: #16a34a;
    border-color: #16a34a;
    color: white;
  }

  .feedback-type-pill svg {
    width: 16px;
    height: 16px;
  }

  .form-group {
    margin-bottom: var(--space-md);
  }

  .form-group label {
    display: block;
    font-weight: 600;
    font-size: var(--text-sm);
    margin-bottom: var(--space-xs);
    color: var(--text-primary);
  }

  .form-optional {
    font-weight: 400;
    color: var(--text-muted);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-white);
    color: var(--text-primary);
    font-size: var(--text-base);
    font-family: inherit;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--kscw-blue);
    box-shadow: 0 0 0 3px rgba(74, 85, 162, 0.15);
  }

  .form-group input.error,
  .form-group textarea.error {
    border-color: var(--danger);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .feedback-dropzone {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-lg);
    border: 2px dashed var(--border);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .feedback-dropzone:hover,
  .feedback-dropzone.dragover {
    border-color: var(--kscw-blue);
    color: var(--kscw-blue);
  }

  .feedback-dropzone svg {
    width: 20px;
    height: 20px;
  }

  .feedback-file-preview {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-light);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    margin-top: var(--space-xs);
  }

  .feedback-file-preview button {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 2px;
    display: flex;
  }

  .feedback-file-preview button:hover {
    color: #dc2626;
  }

  .feedback-file-preview svg {
    width: 16px;
    height: 16px;
  }

  .consent-group {
    margin-bottom: var(--space-md);
  }
  .consent-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text-secondary);
    cursor: pointer;
    line-height: 1.5;
  }
  .consent-label input[type="checkbox"] {
    width: auto;
    margin-top: 3px;
    flex-shrink: 0;
  }
  .consent-label a {
    color: var(--kscw-blue, #4A55A2);
    text-decoration: underline;
  }
  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }

  .form-submit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-lg);
    background: var(--kscw-gold);
    color: var(--kscw-blue-dark);
    border: none;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: var(--text-base);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .form-submit:hover {
    opacity: 0.9;
  }

  .form-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .form-submit svg {
    width: 18px;
    height: 18px;
  }

  .form-feedback {
    margin-top: var(--space-md);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }

  .form-feedback.success {
    background: #f0fdf4;
    color: var(--success);
    border: 1px solid #bbf7d0;
  }

  .form-feedback.error {
    background: #fef2f2;
    color: var(--danger);
    border: 1px solid #fecaca;
  }

  :global(.dark) .form-feedback.success {
    background: rgba(5, 150, 105, 0.1);
    border-color: rgba(5, 150, 105, 0.3);
  }

  :global(.dark) .form-feedback.error {
    background: rgba(220, 38, 38, 0.1);
    border-color: rgba(220, 38, 38, 0.3);
  }

  .feedback-wiedisync-hint {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
    padding: var(--space-md);
    background: var(--bg-light);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .feedback-wiedisync-hint svg {
    width: 16px;
    height: 16px;
    color: var(--kscw-gold);
  }

  .feedback-wiedisync-hint a {
    color: var(--kscw-blue);
    font-weight: 600;
  }

  /* Changelog */
  .changelog-section {
    max-width: 640px;
    margin: var(--space-2xl) auto 0;
    border-top: 2px solid var(--border);
    padding-top: var(--space-xl);
  }

  .changelog-heading {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-lg);
  }

  .changelog-heading svg {
    width: 22px;
    height: 22px;
    color: var(--kscw-blue);
  }

  .changelog-badge {
    font-size: var(--text-xs);
    font-weight: 600;
    font-family: monospace;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--kscw-blue);
    color: white;
  }

  .changelog-entry {
    padding-left: var(--space-md);
    border-left: 3px solid var(--kscw-gold);
  }

  .changelog-meta {
    font-size: var(--text-sm);
    font-weight: 600;
    font-family: monospace;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .changelog-group {
    margin-bottom: var(--space-md);
  }

  .changelog-group h3 {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    margin-bottom: var(--space-xs);
  }

  .changelog-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .changelog-group li {
    position: relative;
    padding-left: var(--space-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .changelog-group li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--kscw-blue);
  }
</style>
</PageLayout>
