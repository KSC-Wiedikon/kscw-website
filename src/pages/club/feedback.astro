<style>
  .feedback-layout {
    max-width: 640px;
    margin: 0 auto;
  }

  .feedback-type-selector {
    display: flex;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
  }

  .feedback-type-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-md);
    border-radius: 999px;
    border: 2px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .feedback-type-pill:hover {
    border-color: var(--kscw-blue);
    color: var(--kscw-blue);
  }

  .feedback-type-pill.active[data-type="bug"] {
    background: #dc2626;
    border-color: #dc2626;
    color: white;
  }

  .feedback-type-pill.active[data-type="feature"] {
    background: var(--kscw-blue);
    border-color: var(--kscw-blue);
    color: white;
  }

  .feedback-type-pill.active[data-type="feedback"] {
    background: #16a34a;
    border-color: #16a34a;
    color: white;
  }

  .feedback-type-pill svg {
    width: 16px;
    height: 16px;
  }

  .form-group {
    margin-bottom: var(--space-md);
  }

  .form-group label {
    display: block;
    font-weight: 600;
    font-size: var(--text-sm);
    margin-bottom: var(--space-xs);
    color: var(--text-primary);
  }

  .form-optional {
    font-weight: 400;
    color: var(--text-muted);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-white);
    color: var(--text-primary);
    font-size: var(--text-base);
    font-family: inherit;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--kscw-blue);
    box-shadow: 0 0 0 3px rgba(74, 85, 162, 0.15);
  }

  .form-group input.error,
  .form-group textarea.error {
    border-color: var(--danger);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .feedback-dropzone {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-lg);
    border: 2px dashed var(--border);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .feedback-dropzone:hover,
  .feedback-dropzone.dragover {
    border-color: var(--kscw-blue);
    color: var(--kscw-blue);
  }

  .feedback-dropzone svg {
    width: 20px;
    height: 20px;
  }

  .feedback-file-preview {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-light);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    margin-top: var(--space-xs);
  }

  .feedback-file-preview button {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 2px;
    display: flex;
  }

  .feedback-file-preview button:hover {
    color: #dc2626;
  }

  .feedback-file-preview svg {
    width: 16px;
    height: 16px;
  }

  .consent-group {
    margin-bottom: var(--space-md);
  }
  .consent-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text-secondary);
    cursor: pointer;
    line-height: 1.5;
  }
  .consent-label input[type="checkbox"] {
    width: auto;
    margin-top: 3px;
    flex-shrink: 0;
  }
  .consent-label a {
    color: var(--kscw-blue, #4A55A2);
    text-decoration: underline;
  }
  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }

  .form-submit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-lg);
    background: var(--kscw-gold);
    color: var(--kscw-blue-dark);
    border: none;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: var(--text-base);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .form-submit:hover {
    opacity: 0.9;
  }

  .form-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .form-submit svg {
    width: 18px;
    height: 18px;
  }

  .form-feedback {
    margin-top: var(--space-md);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }

  .form-feedback.success {
    background: #f0fdf4;
    color: var(--success);
    border: 1px solid #bbf7d0;
  }

  .form-feedback.error {
    background: #fef2f2;
    color: var(--danger);
    border: 1px solid #fecaca;
  }

  :global(.dark) .form-feedback.success {
    background: rgba(5, 150, 105, 0.1);
    border-color: rgba(5, 150, 105, 0.3);
  }

  :global(.dark) .form-feedback.error {
    background: rgba(220, 38, 38, 0.1);
    border-color: rgba(220, 38, 38, 0.3);
  }

  .feedback-wiedisync-hint {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
    padding: var(--space-md);
    background: var(--bg-light);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .feedback-wiedisync-hint svg {
    width: 16px;
    height: 16px;
    color: var(--kscw-gold);
  }

  .feedback-wiedisync-hint a {
    color: var(--kscw-blue);
    font-weight: 600;
  }

  /* Changelog */
  .changelog-section {
    max-width: 640px;
    margin: var(--space-2xl) auto 0;
    border-top: 2px solid var(--border);
    padding-top: var(--space-xl);
  }

  .changelog-heading {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-lg);
  }

  .changelog-heading svg {
    width: 22px;
    height: 22px;
    color: var(--kscw-blue);
  }

  .changelog-badge {
    font-size: var(--text-xs);
    font-weight: 600;
    font-family: monospace;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--kscw-blue);
    color: white;
  }

  .changelog-entry {
    padding-left: var(--space-md);
    border-left: 3px solid var(--kscw-gold);
  }

  .changelog-meta {
    font-size: var(--text-sm);
    font-weight: 600;
    font-family: monospace;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .changelog-group {
    margin-bottom: var(--space-md);
  }

  .changelog-group h3 {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    margin-bottom: var(--space-xs);
  }

  .changelog-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .changelog-group li {
    position: relative;
    padding-left: var(--space-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .changelog-group li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--kscw-blue);
  }
</style>
</PageLayout>
