<style>
  .feedback-layout {
    max-width: 640px;
    margin: 0 auto;
  }

  .feedback-type-selector {
    display: flex;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
  }

  .feedback-type-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-md);
    border-radius: 999px;
    border: 2px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .feedback-type-pill:hover {
    border-color: var(--kscw-blue);
    color: var(--kscw-blue);
  }

  .feedback-type-pill.active[data-type="bug"] {
    background: #dc2626;
    border-color: #dc2626;
    color: white;
  }

  .feedback-type-pill.active[data-type="feature"] {
    background: var(--kscw-blue);
    border-color: var(--kscw-blue);
    color: white;
  }

  .feedback-type-pill.active[data-type="feedback"] {
    background: #16a34a;
