---
import PageLayout from '../../layouts/PageLayout.astro';
import BoardOrgChart from '../../components/BoardOrgChart.astro';
import CTA from '../../components/CTA.astro';
import { t } from '../../lib/i18n';
import boardMembers from '../../data/board-members.json';

const locale = 'de';
---
<PageLayout
  title="Vorstand — KSC Wiedikon"
  titleKey="clubVorstandMetaTitle"
  description="Der Vorstand des KSC Wiedikon — die Menschen hinter dem Verein."
  descriptionKey="clubVorstandMetaDescription"
  locale={locale}
  pageTitle={t(locale, 'boardTitle')}
  pageTitleKey="boardTitle"
  pageSubtitle={t(locale, 'boardSubtitle')}
  pageSubtitleKey="boardSubtitle"
>
  <section class="section">
    <div class="container">
      {boardMembers.length > 0 ? (
        <BoardOrgChart members={boardMembers} locale={locale} />
      ) : (
        <p data-i18n="clubVorstandNoMembers">{t(locale, 'clubVorstandNoMembers')}</p>
      )}
    </div>
  </section>

  <CTA
    title={t(locale, 'boardCTA')}
    titleKey="boardCTA"
    text={t(locale, 'boardCTAText')}
    textKey="boardCTAText"
    buttonLabel={t(locale, 'boardCTAButton')}
    buttonLabelKey="boardCTAButton"
    buttonHref="/club/kontakt"
  />

  <script src="../../islands/scroll-animations.ts"></script>
</PageLayout>
