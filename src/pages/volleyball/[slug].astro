---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { volleyballTeams } from '../../data/team-routes';
import { getActiveTeams } from '../../lib/fetch/teams';
import { t } from '../../lib/i18n';
import { getBadgeText } from '../../data/teams';
import TeamHero from '../../components/TeamHero.astro';
import TeamPhoto from '../../components/TeamPhoto.astro';
import TeamTrainings from '../../components/TeamTrainings.astro';
import { getTeamDetail } from '../../lib/fetch/teamDetail';
import { versionedAsset } from '../../lib/assetVersion';

const locale = 'de';

export async function getStaticPaths() {
  // Resolve slug → live Directus id from active teams so detail pages follow
  // the current season + the D1/D2 swap. Fall back to the static route table
  // if Directus is unreachable at build time.
  let routes = volleyballTeams.map((r) => ({ slug: r.slug, directusId: r.directusId, short: r.short }));
  try {
    const live = (await getActiveTeams()).filter((tm) => tm.sport === 'volleyball' && tm.hasDetailPage);
    if (live.length) routes = live.map((tm) => ({ slug: tm.slug, directusId: tm.directusId, short: tm.chipLabel }));
  } catch { /* keep static fallback */ }
  return routes.map((team) => ({
    params: { slug: team.slug },
    props: { directusId: team.directusId, short: team.short },
  }));
}

const { directusId, short } = Astro.props;
// Build-time hero + photo, so the page is a real team page on first paint and
// without JS. team-page.js replaces this with live Directus data on load.
const detail = await getTeamDetail(directusId);

/**
 * Page metadata.
 *
 * These 16 pages used to ship `title={short + ' — KSC Wiedikon'}` and NO description
 * at all — so search results read "D1 — KSC Wiedikon", which nobody searches for, and
 * BaseLayout omitted the description tag entirely because it renders it conditionally.
 * They are also the pages most search traffic actually lands on.
 *
 * `detail` is null whenever Directus is unreachable at build time (documented in
 * getTeamDetail), so every read is optional-chained with a fallback to the static
 * slug label — otherwise a bad build day ships "undefined — KSC Wiedikon".
 *
 * Deliberate trade-off: because the team name is data, not a dictionary key, this
 * description is NOT client-translated or editable from /admin → Seitentexte. The
 * sentence around it comes from the dictionary; only the proper noun is interpolated.
 */
const teamFull = detail?.fullName || `KSC Wiedikon ${short}`;
// `fullName` already carries the club, so the usual `… — KSC Wiedikon` suffix
// produced "KSC Wiedikon D1 — KSC Wiedikon". Lead with the team, qualify with the
// sport and league — which is what distinguishes one of these 16 pages from another.
// Through getBadgeText, so the title says "3. Liga" rather than the raw ProBasket
// code "H3LS" — and so it agrees with the badge on the card that linked here.
const leagueSuffix = detail?.league ? ` ${getBadgeText(detail.league, teamFull)}` : '';
const metaTitle = `${teamFull} — Volleyball${leagueSuffix}`;
// Same reason: strip the club prefix before dropping the name into a sentence that
// names the club itself.
const teamShort = teamFull.replace(/^KSC\s+Wiedikon\s*/i, '') || short;
const metaDescription = t(locale, 'teamMetaDescription').replace('{team}', teamShort);
---
<BaseLayout title={metaTitle} description={metaDescription} locale={locale}>
  <!-- Hero + photo: rendered at BUILD time, then replaced by team-page.js with
       live Directus data. Both containers stay, because that is what the client
       renderers target. -->
  <section id="team-hero-container"><TeamHero team={detail} sport="volleyball" /></section>

  <div id="team-photo-container"><TeamPhoto team={detail} /></div>

  <!-- Content tabs -->
  <section class="section">
    <div class="container">
      <div class="tab-bar" role="tablist">
        <button class="tab-btn active" data-tab="kader" role="tab" aria-selected="true" data-i18n="teamTabRoster">{t(locale, 'teamTabRoster')}</button>
        <button class="tab-btn" data-tab="spiele" role="tab" aria-selected="false" data-i18n="teamTabGames">{t(locale, 'teamTabGames')}</button>
        <button class="tab-btn" data-tab="rangliste" role="tab" aria-selected="false" data-i18n="teamTabRankings">{t(locale, 'teamTabRankings')}</button>
        <button class="tab-btn" data-tab="training" role="tab" aria-selected="false" data-i18n="teamTabTraining">{t(locale, 'teamTabTraining')}</button>
        <button class="tab-btn" data-tab="sponsoren" role="tab" aria-selected="false" data-i18n="teamTabSponsors">{t(locale, 'teamTabSponsors')}</button>
      </div>

      <div class="tab-panel active" data-tab-panel="kader" role="tabpanel">
        <div id="roster-view-toggle" class="roster-view-toggle">
          <button class="roster-view-btn active" data-view="grid" title="Grid" aria-label="Grid view">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          </button>
          <button class="roster-view-btn" data-view="list" title="Liste" aria-label="List view">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          </button>
        </div>
        <div id="roster-grid" class="roster-grid">
          <p class="text-muted text-sm" data-i18n="teamLoadingRoster">{t(locale, 'teamLoadingRoster')}</p>
        </div>
        <div id="roster-meta" class="mt-lg"></div>
      </div>

      <div class="tab-panel" data-tab-panel="spiele" role="tabpanel">
        <div id="upcoming-section">
          <h2 style="font-size: var(--text-2xl); margin-bottom: var(--space-lg);" data-i18n="teamUpcoming">{t(locale, 'teamUpcoming')}</h2>
          <div id="upcoming-games">
            <p class="text-muted text-sm" data-i18n="teamLoadingGames">{t(locale, 'teamLoadingGames')}</p>
          </div>
        </div>
        <div id="results-section">
          <h2 style="font-size: var(--text-2xl); margin-top: var(--space-2xl); margin-bottom: var(--space-lg);" data-i18n="teamResults">{t(locale, 'teamResults')}</h2>
          <div id="recent-results">
            <p class="text-muted text-sm" data-i18n="teamLoadingResults">{t(locale, 'teamLoadingResults')}</p>
          </div>
        </div>
      </div>

      <div class="tab-panel" data-tab-panel="rangliste" role="tabpanel">
        <div id="rankings-table">
          <p class="text-muted text-sm" data-i18n="teamLoadingRankings">{t(locale, 'teamLoadingRankings')}</p>
        </div>
      </div>

      <div class="tab-panel" data-tab-panel="training" role="tabpanel">
        <div id="training-list">
          <TeamTrainings trainings={detail?.trainings ?? []} locale={locale} />
        </div>
      </div>

      <div class="tab-panel" data-tab-panel="sponsoren" role="tabpanel">
        <div id="team-sponsors-grid" class="sponsors-page-grid"></div>
      </div>
    </div>
  </section>

  <!-- Instagram embed: rendered by JS when team has social_url -->
  <section id="instagram-embed-container" class="section" style="display:none;">
    <div class="container">
      <h2 id="instagram-heading" style="font-size: var(--text-2xl); margin-bottom: var(--space-lg);">Instagram</h2>
      <div id="instagram-embed" class="instagram-embed-wrapper"></div>
    </div>
  </section>

  <!-- CTA: rendered by JS -->
  <div id="cta-container"></div>

  <script is:inline define:vars={{ directusId, short }}>
    window.TEAM_CONFIG = { short: short, directusId: directusId };
  </script>
  <script is:inline src="/js/game-modal.js"></script>
  <!-- Eligible Jahrgänge for the U23/U20 squads. Loaded BEFORE team-page.js,
       which asks it to build the hero line. -->
  <script is:inline src="/js/birth-years.js"></script>
  <!-- Content-hashed: served max-age=14400, so without a ?v= a change here
       (e.g. the sponsor href guard) would not reach a returning visitor for
       up to four hours. -->
  <script is:inline src={versionedAsset('js/team-page.js')}></script>
</BaseLayout>
