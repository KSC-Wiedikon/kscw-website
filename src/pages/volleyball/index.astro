---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import TeamCard from '../../components/TeamCard.astro';
import CTA from '../../components/CTA.astro';
import { t } from '../../lib/i18n';
import { getActiveTeams, type Team } from '../../lib/fetch/teams';
import { allTeamDefs } from '../../data/teams';

const locale = 'de';
const basePath = `/volleyball`;

let allTeams: Team[];
try {
  allTeams = await getActiveTeams();
} catch {
  // Fallback to static defs with empty dynamic data
  allTeams = allTeamDefs.map(d => ({ ...d, league: d.fallbackLeague || '', photoUrl: '', season: '' }));
}
const vb = (cat: string) =>
  allTeams
    .filter(t => t.sport === 'volleyball' && t.category === cat)
    .sort((a, b) => a.order - b.order);

const men = vb('men');
const women = vb('women');
const youth = vb('youth');

const moreText = t(locale, 'vbMore');
---
<PageLayout
  title="Volleyball — KSC Wiedikon"
  titleKey="volleyballMetaTitle"
  description="Alle Volleyball-Teams des KSC Wiedikon — Von der 2. Liga bis zum Nachwuchs."
  descriptionKey="volleyballMetaDescription"
  locale={locale}
  pageTitle={t(locale, 'vbTitle')}
  pageTitleKey="vbTitle"
  pageSubtitle={t(locale, 'vbSubtitle')}
  pageSubtitleKey="vbSubtitle"
  sparklesHero={true}
  sparkleColor="rgba(255, 225, 77, 1)"
>
  <!-- Damen -->
  <section class="section">
    <div class="container">
      <SectionHeader title={t(locale, 'vbWomen')} titleKey="vbWomen" />
      <div class="grid grid-4">
        {women.map((team: TeamData) => (
          <TeamCard team={team} locale={locale} basePath={basePath} moreText={moreText} moreTextKey="vbMore" />
        ))}
      </div>
    </div>
  </section>

  <!-- Herren -->
  <section class="section-alt">
    <div class="container">
      <SectionHeader title={t(locale, 'vbMen')} titleKey="vbMen" />
      <div class="grid grid-4">
        {men.map((team: TeamData) => (
          <TeamCard team={team} locale={locale} basePath={basePath} moreText={moreText} moreTextKey="vbMore" />
        ))}
      </div>
    </div>
  </section>

  <!-- Nachwuchs -->
  <section class="section">
    <div class="container">
      <SectionHeader title={t(locale, 'vbYouth')} titleKey="vbYouth" />
      <div class={`grid grid-${Math.min(youth.length, 4)}`}>
        {youth.map((team: TeamData) => (
          <TeamCard team={team} locale={locale} basePath={basePath} moreText={moreText} moreTextKey="vbMore" />
        ))}
      </div>
    </div>
  </section>

  <!-- Scoreboard -->
  <section class="section-alt" id="vb-scoreboard-section">
    <div class="container">
      <SectionHeader title="KSCW Volleyball Scoreboard" />
      <div id="vb-scoreboard" data-scoreboard="volleyball"></div>
    </div>
  </section>

  <!-- CTA -->
  <CTA
    title={t(locale, 'vbCTA')}
    titleKey="vbCTA"
    text={t(locale, 'vbCTAText')}
    textKey="vbCTAText"
    buttonLabel={t(locale, 'vbCTAButton')}
    buttonLabelKey="vbCTAButton"
    buttonHref="/club/kontakt"
  />

  <script is:inline src="/js/scoreboard.js"></script>
  <script src="../../islands/scroll-animations.ts"></script>
</PageLayout>
