---
import PageLayout from '../../layouts/PageLayout.astro';
import { t } from '../../lib/i18n';
import { versionedAsset } from '../../lib/assetVersion';

const locale = 'de';
---
<PageLayout
  title="Dokumente nachreichen — KSC Wiedikon"
  titleKey="regDocsMetaTitle"
  description="Fehlende Dokumente zu deiner KSC-Wiedikon-Anmeldung sicher nachreichen."
  descriptionKey="regDocsMetaDescription"
  locale={locale}
  pageTitle={t(locale, 'regDocsTitle')}
  pageTitleKey="regDocsTitle"
  pageSubtitle={t(locale, 'regDocsSubtitle')}
  pageSubtitleKey="regDocsSubtitle"
>
  <section class="section">
    <div class="container" style="max-width: 640px;">
      <p style="color: var(--text-secondary); margin-bottom: var(--space-lg);" data-i18n="regDocsIntro">{t(locale, 'regDocsIntro')}</p>

      <form id="docstatus-form">
        <div class="form-group">
          <label for="docs-ref"><span data-i18n="regDocsRef">{t(locale, 'regDocsRef')}</span> *</label>
          <input type="text" id="docs-ref" name="reference" class="form-input" placeholder="REG-2026-1234" required autocomplete="off">
        </div>
        <div class="form-group">
          <label for="docs-email"><span data-i18n="regDocsEmail">{t(locale, 'regDocsEmail')}</span> *</label>
          <input type="email" id="docs-email" name="email" class="form-input" required autocomplete="email">
        </div>
        <button type="submit" class="btn btn-primary" id="docs-check-btn" data-i18n="regDocsCheck">{t(locale, 'regDocsCheck')}</button>
      </form>

      <div id="docs-feedback" style="display: none; margin-top: var(--space-md);"></div>
      <div id="docs-slots" style="display: none; margin-top: var(--space-lg);"></div>
    </div>
  </section>

  <script is:inline src={versionedAsset('js/anmeldung-dokumente.js')}></script>
</PageLayout>

<style>
  .form-group {
    margin-bottom: var(--space-md);
  }
  .form-group label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }
  /* Inputs deliberately carry NO local rule — `.form-input` in global.css owns
     them, and it is the only version that tracks the theme. This page used to
     hand-roll the box with `var(--bg-primary, #fff)` / `var(--border-color, …)`:
     neither token has ever existed, so both fell through to their hardcoded
     light-theme fallbacks while `--text-primary` (which DOES exist) correctly
     resolved to the dark theme's near-white #e2e8f0 — white text on a white
     box, ~1.1:1, on the one field a family has to fill in to recover their
     registration. The class must also stay global rather than scoped: the
     upload slots are created at runtime by anmeldung-dokumente.js, and an
     Astro-scoped rule never reaches a node that did not exist at build time. */
</style>
