---
import PageLayout from '../../layouts/PageLayout.astro';
import { t } from '../../lib/i18n';

const locale = 'de';

// All current Zürich cantonal schools (Mittelschulen) for the "other cantonal
// school" dropdown, alphabetical. Excludes KS Wiedikon on purpose — that's the
// dedicated KWI option above (which stores "KS Wiedikon"). Shown only when
// "Yes, other cantonal school" is selected. Notes: Rämibühl is three separate
// schools sharing the campus (Literar-/Real-/MN-Gymnasium); Oerlikon + Birch are
// the two campuses of KS Zürich Nord (2019 merger) — kept as students still use
// those names; Dübendorf opens Aug 2026 as a KS Stadelhofen branch.
const KS_OTHER = [
  'KS Birch', 'KS Büelrain', 'KS Bülach', 'KS Dübendorf', 'KS Enge',
  'KS Freudenberg', 'KS Hohe Promenade', 'KS Hottingen', 'KS Im Lee',
  'KS Küsnacht', 'KS Limmattal', 'KS Oerlikon',
  'KS Rämibühl (Literargymnasium)', 'KS Rämibühl (MN-Gymnasium)', 'KS Rämibühl (Realgymnasium)',
  'KS Riesbach', 'KS Rychenberg', 'KS Stadelhofen', 'KS Uetikon am See',
  'KS Uster', 'KS Wetzikon', 'KS Zimmerberg', 'KS Zürich Nord',
  'Liceo Artistico',
];
---
<PageLayout
  title="Anmeldung — KSC Wiedikon"
  titleKey="weiteresAnmeldungMetaTitle"
  description="Mitglied werden beim KSC Wiedikon — Anmeldung für Volleyball, Basketball und Passivmitgliedschaft."
  descriptionKey="weiteresAnmeldungMetaDescription"
  locale={locale}
  pageTitle={t(locale, 'registrationTitle')}
  pageTitleKey="registrationTitle"
  pageSubtitle={t(locale, 'registrationSubtitle')}
  pageSubtitleKey="registrationSubtitle"
>
  <section class="section">
    <div class="container" style="max-width: 720px;">

      <!-- Coach Note -->
      <div class="card" style="border-left: 4px solid var(--kscw-gold); margin-bottom: var(--space-xl);">
        <div class="card-body">
          <p style="color: var(--text-secondary); display: flex; align-items: flex-start; gap: var(--space-sm); margin: 0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--kscw-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            <span data-i18n="registrationCoachNote">{t(locale, 'registrationCoachNote')}</span>
          </p>
        </div>
      </div>

      <form id="registration-form">

        <!-- Membership Type -->
        <div class="form-group">
          <label><span data-i18n="registrationType">{t(locale, 'registrationType')}</span> *</label>
          <div style="display: flex; gap: var(--space-md); flex-wrap: wrap; margin-top: var(--space-xs);">
            <label class="radio-card">
              <input type="radio" name="membership_type" value="volleyball" required>
              <span data-i18n="registrationTypeVolleyball">{t(locale, 'registrationTypeVolleyball')}</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="membership_type" value="basketball" required>
              <span data-i18n="registrationTypeBasketball">{t(locale, 'registrationTypeBasketball')}</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="membership_type" value="passive" required>
              <span data-i18n="registrationTypePassive">{t(locale, 'registrationTypePassive')}</span>
            </label>
          </div>
        </div>

        <!-- Common Fields -->
        <div class="form-row">
          <div class="form-group">
            <label for="vorname"><span data-i18n="registrationFirstName">{t(locale, 'registrationFirstName')}</span> *</label>
            <input type="text" id="vorname" name="vorname" class="form-input" required>
            <small class="name-charset-warn" data-for="vorname" style="color: var(--kscw-gold, #b8860b); display: none;" data-i18n="registrationNameCharsetWarn">{t(locale, 'registrationNameCharsetWarn')}</small>
          </div>
          <div class="form-group">
            <label for="nachname"><span data-i18n="registrationLastName">{t(locale, 'registrationLastName')}</span> *</label>
            <input type="text" id="nachname" name="nachname" class="form-input" required>
            <small class="name-charset-warn" data-for="nachname" style="color: var(--kscw-gold, #b8860b); display: none;" data-i18n="registrationNameCharsetWarn">{t(locale, 'registrationNameCharsetWarn')}</small>
          </div>
        </div>

        <div class="form-group">
          <label for="email"><span data-i18n="registrationEmail">{t(locale, 'registrationEmail')}</span> *</label>
          <input type="email" id="email" name="email" class="form-input" required>
        </div>

        <div class="form-group">
          <label for="telefon"><span data-i18n="registrationPhone">{t(locale, 'registrationPhone')}</span> *</label>
          <input type="tel" id="telefon" name="telefon" class="form-input" required>
        </div>

        <div class="form-group">
          <label for="adresse"><span data-i18n="registrationAddress">{t(locale, 'registrationAddress')}</span> *</label>
          <input type="text" id="adresse" name="adresse" class="form-input" required>
        </div>

        <div class="form-row">
          <div class="form-group" style="flex: 0 0 120px; min-width: 0;">
            <label for="plz"><span data-i18n="registrationPLZ">{t(locale, 'registrationPLZ')}</span> *</label>
            <input type="text" id="plz" name="plz" class="form-input" required>
          </div>
          <div class="form-group">
            <label for="ort"><span data-i18n="registrationCity">{t(locale, 'registrationCity')}</span> *</label>
            <input type="text" id="ort" name="ort" class="form-input" required>
          </div>
        </div>

        <div class="form-group">
          <label for="iban"><span data-i18n="registrationIBAN">{t(locale, 'registrationIBAN')}</span> *</label>
          <input type="text" id="iban" name="iban" class="form-input" placeholder="CH00 0000 0000 0000 0000 0" required>
          <small style="color: var(--text-secondary);" data-i18n="registrationIBANNote">{t(locale, 'registrationIBANNote')}</small>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="geburtsdatum"><span data-i18n="registrationDOB">{t(locale, 'registrationDOB')}</span> *</label>
            <input type="date" id="geburtsdatum" name="geburtsdatum" class="form-input" required>
          </div>
          <div class="form-group">
            <label for="geschlecht"><span data-i18n="registrationGender">{t(locale, 'registrationGender')}</span> *</label>
            <select id="geschlecht" name="geschlecht" class="form-select" required>
              <option value="" disabled selected>—</option>
              <option value="männlich" data-i18n="registrationGenderMale">{t(locale, 'registrationGenderMale')}</option>
              <option value="weiblich" data-i18n="registrationGenderFemale">{t(locale, 'registrationGenderFemale')}</option>
            </select>
          </div>
        </div>

        <!-- Multi-select: dual nationals pick every passport they hold. The first
             one chosen is the primary and is what ClubDesk (single-valued) gets. -->
        <div class="form-group nationality-wrapper" id="nationality-wrapper">
          <label><span data-i18n="registrationNationality">{t(locale, 'registrationNationality')}</span> *</label>
          <small style="color: var(--text-secondary); display: block; margin-bottom: var(--space-xs);" data-i18n="registrationNationalityHint">{t(locale, 'registrationNationalityHint')}</small>
          <input type="hidden" id="nationalitaet" name="nationalitaet" required>
          <input type="hidden" id="nationalitaet_codes" name="nationalitaet_codes">
          <div class="country-chips" id="nationality-chips"></div>
          <button type="button" class="form-select nationality-trigger" id="nationality-trigger">
            <span id="nationality-trigger-text">—</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 4 6 8 10 4"/></svg>
          </button>
          <div class="nationality-dropdown" id="nationality-dropdown">
            <input type="text" class="form-input nationality-search" id="nationality-search" placeholder="Suchen…" data-i18n-placeholder="weiteresAnmeldungSearchPlaceholder" autocomplete="off">
            <div class="nationality-options" id="nationality-options"></div>
          </div>
        </div>

        <!-- The national federation that FIRST licensed the player — their
             federation of origin, not the most recent one. "None" is an explicit
             answer, not a blank: it says this will be their first licence.
             Mandatory for volleyball (except guests) — enforced in JS on submit;
             the star is toggled by registration-form.js to match. -->
        <div class="form-group nationality-wrapper" id="federation-wrapper">
          <label><span data-i18n="registrationFederation">{t(locale, 'registrationFederation')}</span><span id="federation-required-star" style="display: none;"> *</span></label>
          <small style="color: var(--text-secondary); display: block; margin-bottom: var(--space-xs);" data-i18n="registrationFederationHint">{t(locale, 'registrationFederationHint')}</small>
          <input type="hidden" id="federation_of_origin" name="federation_of_origin">
          <button type="button" class="form-select nationality-trigger" id="federation-trigger">
            <span id="federation-trigger-text">—</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 4 6 8 10 4"/></svg>
          </button>
          <div class="nationality-dropdown" id="federation-dropdown">
            <input type="text" class="form-input nationality-search" id="federation-search" placeholder="Suchen…" data-i18n-placeholder="weiteresAnmeldungSearchPlaceholder" autocomplete="off">
            <div class="nationality-options" id="federation-options"></div>
          </div>
        </div>

        <!-- ═══ VOLLEYBALL-ONLY FIELDS ═══ -->
        <div id="vb-fields" style="display: none;">
          <input type="hidden" id="anrede" name="anrede">

          <div class="form-group">
            <label for="funktion-vb"><span data-i18n="registrationFunktion">{t(locale, 'registrationFunktion')}</span> *</label>
            <select id="funktion-vb" name="funktion_vb" class="form-select" data-conditional-required>
              <option value="" disabled selected data-i18n="registrationFunktionPlaceholder">{t(locale, 'registrationFunktionPlaceholder')}</option>
              <option value="Spieler*in" data-i18n="registrationFunktionPlayer">{t(locale, 'registrationFunktionPlayer')}</option>
              <option value="Guest" data-i18n="registrationFunktionGuest">{t(locale, 'registrationFunktionGuest')}</option>
              <option value="Trainer*in" data-i18n="registrationFunktionCoach">{t(locale, 'registrationFunktionCoach')}</option>
              <option value="Teamverantwortliche*r" data-i18n="registrationFunktionTR">{t(locale, 'registrationFunktionTR')}</option>
              <option value="Andere" data-i18n="registrationFunktionOther">{t(locale, 'registrationFunktionOther')}</option>
            </select>
          </div>

          <div class="form-group team-wrapper" id="vb-team-wrapper" style="display: none;">
            <label><span data-i18n="registrationTeam">{t(locale, 'registrationTeam')}</span> *</label>
            <button type="button" class="form-select team-trigger" id="vb-team-trigger">
              <span id="vb-team-trigger-text" data-i18n="registrationTeamPlaceholder">{t(locale, 'registrationTeamPlaceholder')}</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 4 6 8 10 4"/></svg>
            </button>
            <div class="team-dropdown" id="vb-team-dropdown">
              <div class="team-options" id="vb-team"></div>
            </div>
          </div>

          <div class="form-group">
            <label for="vb-fee"><span data-i18n="registrationFeeCategory">{t(locale, 'registrationFeeCategory')}</span> *</label>
            <select id="vb-fee" name="vb_fee" class="form-select" data-conditional-required>
              <option value="" disabled selected data-i18n="registrationFeeCategoryPlaceholder">{t(locale, 'registrationFeeCategoryPlaceholder')}</option>
              <option value="VB Turnier KWI" data-i18n="registrationVBFeeTournamentKWI">{t(locale, 'registrationVBFeeTournamentKWI')}</option>
              <option value="VB Schüler*in Turnier" data-i18n="registrationVBFeeTournament">{t(locale, 'registrationVBFeeTournament')}</option>
              <option value="VB Schüler*in Meisterschaft" data-i18n="registrationVBFeeHighSchool">{t(locale, 'registrationVBFeeHighSchool')}</option>
              <option value="VB Student*in Meisterschaft" data-i18n="registrationVBFeeStudent">{t(locale, 'registrationVBFeeStudent')}</option>
              <option value="VB Erwerbstätige" data-i18n="registrationVBFeeWorking">{t(locale, 'registrationVBFeeWorking')}</option>
            </select>
          </div>

          <div class="form-group" id="vb-ahv-group">
            <label for="vb-ahv"><span data-i18n="registrationAHV">{t(locale, 'registrationAHV')}</span> <span id="vb-ahv-star">*</span></label>
            <input type="text" id="vb-ahv" name="vb_ahv" class="form-input">
            <small style="color: var(--text-secondary);" data-i18n="registrationAHVNote">{t(locale, 'registrationAHVNote')}</small>
          </div>

          <div class="form-group js-guest-hide">
            <label for="kantonsschule-vb"><span data-i18n="registrationKantonsschule">{t(locale, 'registrationKantonsschule')}</span> *</label>
            <select id="kantonsschule-vb" name="kantonsschule_vb" class="form-select" data-conditional-required>
              <option value="" disabled selected>—</option>
              <option value="Nein" data-i18n="registrationKantonsschuleNo">{t(locale, 'registrationKantonsschuleNo')}</option>
              <option value="KS Wiedikon" data-i18n="registrationKantonsschuleWiedikon">{t(locale, 'registrationKantonsschuleWiedikon')}</option>
              <option value="Andere Kantonsschule" data-i18n="registrationKantonsschuleOther">{t(locale, 'registrationKantonsschuleOther')}</option>
            </select>
          </div>

          <div class="form-group" id="ks-other-vb-group" style="display:none;">
            <label for="ks-other-vb"><span data-i18n="registrationKantonsschuleWhich">{t(locale, 'registrationKantonsschuleWhich')}</span> *</label>
            <select id="ks-other-vb" name="kantonsschule_other_vb" class="form-select">
              <option value="" disabled selected>—</option>
              {KS_OTHER.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>

          <div class="form-group js-guest-hide">
            <label data-i18n="registrationLicence">{t(locale, 'registrationLicence')}</label>
            <div class="toggle-group">
              <label class="toggle-label">
                <span data-i18n="registrationLicenceSchreiber">{t(locale, 'registrationLicenceSchreiber')}</span>
                <span class="toggle-switch"><input type="checkbox" name="lizenz_vb" value="Schreiber"><span class="toggle-slider"></span></span>
              </label>
              <label class="toggle-label">
                <span data-i18n="registrationLicenceSchiedsrichter">{t(locale, 'registrationLicenceSchiedsrichter')}</span>
                <span class="toggle-switch"><input type="checkbox" name="lizenz_vb" value="Schiedsrichter" id="vb-ref-check"><span class="toggle-slider"></span></span>
              </label>
            </div>
          </div>
          <div class="form-group" id="vb-ref-level-group" style="display: none;">
            <label for="vb-ref-level"><span data-i18n="registrationLicenceSchiedsrichter">{t(locale, 'registrationLicenceSchiedsrichter')}</span> — <span data-i18n="weiteresAnmeldungLevel">Stufe</span></label>
            <select id="vb-ref-level" name="vb_ref_level" class="form-select">
              <option value="" disabled selected data-i18n="registrationLicenceRefLevelPlaceholder">{t(locale, 'registrationLicenceRefLevelPlaceholder')}</option>
              <option value="N4-3">N4-3</option>
              <option value="N4-2">N4-2</option>
              <option value="N4-1">N4-1</option>
              <option value="N3-3">N3-3</option>
              <option value="N3-2">N3-2</option>
              <option value="N3-1">N3-1</option>
              <option value="N2-2">N2-2</option>
              <option value="N2-1">N2-1</option>
              <option value="N1 (NL-Kader)">N1 (NL-Kader)</option>
            </select>
          </div>
        </div>

        <!-- ═══ BASKETBALL-ONLY FIELDS ═══ -->
        <div id="bb-fields" style="display: none;">
          <div class="form-group">
            <label for="funktion-bb"><span data-i18n="registrationFunktion">{t(locale, 'registrationFunktion')}</span> *</label>
            <select id="funktion-bb" name="funktion_bb" class="form-select" data-conditional-required>
              <option value="" disabled selected data-i18n="registrationFunktionPlaceholder">{t(locale, 'registrationFunktionPlaceholder')}</option>
              <option value="Spieler*in" data-i18n="registrationFunktionPlayer">{t(locale, 'registrationFunktionPlayer')}</option>
              <option value="Guest" data-i18n="registrationFunktionGuest">{t(locale, 'registrationFunktionGuest')}</option>
              <option value="Trainer*in" data-i18n="registrationFunktionCoach">{t(locale, 'registrationFunktionCoach')}</option>
              <option value="Teamverantwortliche*r" data-i18n="registrationFunktionTR">{t(locale, 'registrationFunktionTR')}</option>
              <option value="Andere" data-i18n="registrationFunktionOther">{t(locale, 'registrationFunktionOther')}</option>
            </select>
          </div>

          <div class="form-group team-wrapper" id="bb-team-wrapper" style="display: none;">
            <label><span data-i18n="registrationTeam">{t(locale, 'registrationTeam')}</span> *</label>
            <button type="button" class="form-select team-trigger" id="bb-team-trigger">
              <span id="bb-team-trigger-text" data-i18n="registrationTeamPlaceholder">{t(locale, 'registrationTeamPlaceholder')}</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 4 6 8 10 4"/></svg>
            </button>
            <div class="team-dropdown" id="bb-team-dropdown">
              <div class="team-options" id="bb-team"></div>
            </div>
          </div>

          <div class="form-group">
            <label for="bb-fee"><span data-i18n="registrationFeeCategory">{t(locale, 'registrationFeeCategory')}</span> *</label>
            <select id="bb-fee" name="bb_fee" class="form-select" data-conditional-required>
              <option value="" disabled selected data-i18n="registrationFeeCategoryPlaceholder">{t(locale, 'registrationFeeCategoryPlaceholder')}</option>
              <option value="BB Erwerbstätige 1. Liga" data-i18n="registrationBBFeeWorking1L">{t(locale, 'registrationBBFeeWorking1L')}</option>
              <option value="BB Lernende/Studierende 1. Liga" data-i18n="registrationBBFeeStudent1L">{t(locale, 'registrationBBFeeStudent1L')}</option>
              <option value="BB Erwerbstätige" data-i18n="registrationBBFeeWorking">{t(locale, 'registrationBBFeeWorking')}</option>
              <option value="BB Lernende/Studierende" data-i18n="registrationBBFeeStudent">{t(locale, 'registrationBBFeeStudent')}</option>
              <option value="BB Jugend Meisterschaft" data-i18n="registrationBBFeeJunior">{t(locale, 'registrationBBFeeJunior')}</option>
              <option value="BB Minis Turnier" data-i18n="registrationBBFeeMinis">{t(locale, 'registrationBBFeeMinis')}</option>
            </select>
          </div>

          <div class="form-group" id="bb-ahv-group">
            <label for="bb-ahv"><span data-i18n="registrationAHV">{t(locale, 'registrationAHV')}</span> <span id="bb-ahv-star">*</span></label>
            <input type="text" id="bb-ahv" name="bb_ahv" class="form-input">
            <small style="color: var(--text-secondary);" data-i18n="registrationAHVNote">{t(locale, 'registrationAHVNote')}</small>
          </div>

          <div class="form-group js-guest-hide">
            <label for="kantonsschule-bb"><span data-i18n="registrationKantonsschule">{t(locale, 'registrationKantonsschule')}</span> *</label>
            <select id="kantonsschule-bb" name="kantonsschule_bb" class="form-select" data-conditional-required>
              <option value="" disabled selected>—</option>
              <option value="Nein" data-i18n="registrationKantonsschuleNo">{t(locale, 'registrationKantonsschuleNo')}</option>
              <option value="KS Wiedikon" data-i18n="registrationKantonsschuleWiedikon">{t(locale, 'registrationKantonsschuleWiedikon')}</option>
              <option value="Andere Kantonsschule" data-i18n="registrationKantonsschuleOther">{t(locale, 'registrationKantonsschuleOther')}</option>
            </select>
          </div>

          <div class="form-group" id="ks-other-bb-group" style="display:none;">
            <label for="ks-other-bb"><span data-i18n="registrationKantonsschuleWhich">{t(locale, 'registrationKantonsschuleWhich')}</span> *</label>
            <select id="ks-other-bb" name="kantonsschule_other_bb" class="form-select">
              <option value="" disabled selected>—</option>
              {KS_OTHER.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>

          <div class="form-group js-guest-hide">
            <label data-i18n="registrationLicenceBBScorer">{t(locale, 'registrationLicenceBBScorer')}</label>
            <div style="display: flex; gap: var(--space-lg); flex-wrap: wrap; margin-top: var(--space-xs);">
              <label class="radio-card">
                <input type="radio" name="bb_scorer_licence" value="">
                <span data-i18n="registrationLicenceNone">{t(locale, 'registrationLicenceNone')}</span>
              </label>
              <label class="radio-card">
                <input type="radio" name="bb_scorer_licence" value="OTR 1">
                <span data-i18n="registrationLicenceOTR1">{t(locale, 'registrationLicenceOTR1')}</span>
              </label>
              <label class="radio-card">
                <input type="radio" name="bb_scorer_licence" value="OTR 2">
                <span data-i18n="registrationLicenceOTR2">{t(locale, 'registrationLicenceOTR2')}</span>
              </label>
              <label class="radio-card">
                <input type="radio" name="bb_scorer_licence" value="OTN">
                <span data-i18n="registrationLicenceOTN">{t(locale, 'registrationLicenceOTN')}</span>
              </label>
            </div>
          </div>

          <div class="form-group js-guest-hide">
            <label data-i18n="registrationLicenceBBReferee">{t(locale, 'registrationLicenceBBReferee')}</label>
            <div class="toggle-group">
              <label class="toggle-label">
                <span data-i18n="registrationLicenceSchiedsrichter">{t(locale, 'registrationLicenceSchiedsrichter')}</span>
                <span class="toggle-switch"><input type="checkbox" name="bb_referee" value="Schiedsrichter" id="bb-ref-check"><span class="toggle-slider"></span></span>
              </label>
            </div>
          </div>

          <div class="form-group js-guest-hide">
            <label><span data-i18n="registrationIDUpload">{t(locale, 'registrationIDUpload')}</span> *</label>
            <small style="color: var(--text-secondary); display: block; margin-bottom: var(--space-sm);" data-i18n="registrationIDUploadNote">{t(locale, 'registrationIDUploadNote')}</small>
            <div style="display: flex; gap: var(--space-md); flex-wrap: wrap;">
              <div>
                <label for="id-front" style="font-size: var(--text-sm); font-weight: 600; display: block; margin-bottom: var(--space-xs);"><span data-i18n="registrationIDFront">{t(locale, 'registrationIDFront')}</span> *</label>
                <input type="file" id="id-front" name="id_front" accept="image/*,.pdf" data-conditional-required>
              </div>
              <div>
                <label for="id-back" style="font-size: var(--text-sm); font-weight: 600; display: block; margin-bottom: var(--space-xs);"><span data-i18n="registrationIDBack">{t(locale, 'registrationIDBack')}</span> *</label>
                <input type="file" id="id-back" name="id_back" accept="image/*,.pdf">
              </div>
            </div>
          </div>

          <div class="form-group js-guest-hide" id="bb-situation-group">
            <label><span data-i18n="registrationBBSituation">{t(locale, 'registrationBBSituation')}</span> *</label>
