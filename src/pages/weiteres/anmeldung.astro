  </section>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script is:inline src="/js/registration-form.js?v=3.12.0"></script>
  <script src="../../islands/scroll-animations.ts"></script>
</PageLayout>

<style>
  .form-group {
    margin-bottom: var(--space-md);
  }
  .form-group label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-xs);
  }
  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.625rem 0.875rem;
    font-size: var(--text-sm);
    font-family: 'Inter', sans-serif;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 8px);
    background: var(--bg-white);
    color: var(--text-primary);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    box-sizing: border-box;
  }
  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--kscw-blue, #4A55A2);
    box-shadow: 0 0 0 3px rgba(74, 85, 162, 0.15);
  }
  .form-textarea {
    min-height: 120px;
    resize: vertical;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }
  @media (max-width: 480px) {
    .form-row { grid-template-columns: 1fr; }
  }
  .form-submit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.75rem 1.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    font-family: 'Inter', sans-serif;
    color: #ffffff;
    background: var(--kscw-blue, #4A55A2);
    border: none;
    border-radius: var(--radius-md, 8px);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
  }
  .form-submit:hover {
    background: #3b4590;
  }
  .form-submit:active {
    transform: scale(0.98);
  }
  .form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  /* Radio card pills */
  .radio-card {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.5rem 1rem;
    border: 2px solid var(--border);
    border-radius: var(--radius-md, 8px);
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-white);
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
    user-select: none;
  }
  .radio-card input[type="radio"] {
    display: none;
  }
  .radio-card:has(input:checked) {
    border-color: var(--kscw-blue, #4A55A2);
    color: var(--kscw-blue, #4A55A2);
    background: rgba(74, 85, 162, 0.06);
  }
  .radio-card:hover {
    border-color: var(--kscw-blue, #4A55A2);
    color: var(--kscw-blue, #4A55A2);
  }
  /* Toggle switches */
  .toggle-group {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--space-xs);
  }
  .toggle-label {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    cursor: pointer;
    font-weight: normal;
  }
  .toggle-switch {
    position: relative;
    display: inline-flex;
    width: 44px;
    height: 24px;
    flex-shrink: 0;
    vertical-align: middle;
  }
  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
    position: absolute;
  }
  .toggle-slider {
    position: absolute;
    inset: 0;
    background: var(--border);
    border-radius: 12px;
    transition: background 0.2s ease;
  }
  .toggle-slider::before {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    left: 3px;
    bottom: 3px;
    background: white;
    border-radius: 50%;
    transition: transform 0.2s ease;
  }
  .toggle-switch input:checked + .toggle-slider {
    background: var(--kscw-blue, #4A55A2);
  }
  .toggle-switch input:checked + .toggle-slider::before {
    transform: translateX(20px);
  }
  /* Form feedback states */
  #form-feedback {
    padding: 0.875rem 1rem;
    border-radius: var(--radius-md, 8px);
    font-size: var(--text-sm);
    font-weight: 500;
    margin-top: var(--space-md);
  }
  #form-feedback.success {
    background: rgba(34, 197, 94, 0.1);
    color: #16a34a;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }
  #form-feedback.error {
    background: rgba(239, 68, 68, 0.1);
    color: #dc2626;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }
  @media (prefers-color-scheme: dark) {
    #form-feedback.success { color: #4ade80; }
    #form-feedback.error { color: #f87171; }
  }
  #turnstile-container {
    min-height: 0;
  }
  /* Success modal — created at runtime by registration-form.js. These MUST be
     :global; scoped selectors carry a build-time data-astro-cid attribute that
     JS-injected elements never get, so the modal would render unstyled (no
     overlay/centering) at the bottom of the page and look like "nothing". */
  :global(.success-modal-overlay) {
    position: fixed; inset: 0; z-index: 9999;
    background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: opacity 0.2s ease;
  }
  :global(.success-modal-overlay.visible) { opacity: 1; }
  :global(.success-modal) {
    background: var(--card-bg, #1e293b); border: 1px solid rgba(34,197,94,0.3);
    border-radius: var(--radius-lg, 12px); padding: 2rem 2.5rem;
    text-align: center; max-width: 420px; width: 90%;
    box-shadow: 0 0 40px rgba(34,197,94,0.15);
    transform: scale(0.95); transition: transform 0.2s ease;
  }
  :global(.success-modal-overlay.visible .success-modal) { transform: scale(1); }
  :global(.success-modal-icon) { margin-bottom: 1rem; }
  :global(.success-modal-msg) { font-size: var(--text-base); color: var(--text-primary, #e2e8f0); line-height: 1.6; margin: 0 0 1.5rem; }
  :global(.success-modal-btn) {
    background: #22c55e; color: #fff; border: none; border-radius: var(--radius-md, 8px);
    padding: 0.625rem 2rem; font-size: var(--text-sm); font-weight: 600;
    cursor: pointer; transition: background 0.15s;
  }
  :global(.success-modal-btn:hover) { background: #16a34a; }
  small {
    display: block;
    font-size: var(--text-xs, 0.75rem);
    margin-top: var(--space-xs);
  }
  /* Searchable nationality dropdown */
  .nationality-wrapper {
    position: relative;
  }
  .nationality-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    text-align: left;
    appearance: none;
    font-family: inherit;
    font-size: var(--text-base);
    color: var(--text-primary);
  }
  .nationality-trigger svg {
    flex-shrink: 0;
    opacity: 0.5;
    transition: transform 0.2s ease;
  }
  .nationality-wrapper.open .nationality-trigger svg {
    transform: rotate(180deg);
  }
  .nationality-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 8px);
    margin-top: 4px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    overflow: hidden;
  }
  .nationality-wrapper.open .nationality-dropdown {
    display: block;
  }
  .nationality-search {
    border: none !important;
    border-bottom: 1px solid var(--border) !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }
  .nationality-search:focus {
    box-shadow: none !important;
  }
  .nationality-options {
    max-height: 240px;
    overflow-y: auto;
  }
  :global(.nationality-opt) {
    padding: 0.875rem 1.125rem;
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--text-primary);
    transition: background 0.1s ease;
  }
  :global(.nationality-opt:hover),
  :global(.nationality-opt.highlighted) {
