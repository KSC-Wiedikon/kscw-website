          <label for="bemerkungen" data-i18n="registrationComments">{t(locale, 'registrationComments')}</label>
          <textarea id="bemerkungen" name="bemerkungen" class="form-textarea" placeholder={t(locale, 'registrationCommentsPlaceholder')} data-i18n-placeholder="registrationCommentsPlaceholder"></textarea>
        </div>

        <!-- Privacy Notice (collapsible) -->
