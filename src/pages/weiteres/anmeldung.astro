          <summary style="cursor: pointer; font-weight: 600; color: var(--kscw-blue);" data-i18n="registrationPrivacyTitle">{t(locale, 'registrationPrivacyTitle')}</summary>
          <p style="margin-top: var(--space-sm); color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.7; text-align: justify;" data-i18n="registrationPrivacyText">{t(locale, 'registrationPrivacyText')}</p>
