---
import PageLayout from '../../layouts/PageLayout.astro';
import { t } from '../../lib/i18n';

const locale = 'de';
---
<PageLayout
  title="Impressum — KSC Wiedikon"
  titleKey="weiteresImpressumMetaTitle"
  description="Impressum des KSC Wiedikon — Rechtliche Angaben und Haftungshinweise."
  descriptionKey="weiteresImpressumMetaDescription"
  locale={locale}
  pageTitle={t(locale, 'imprintTitle')}
  pageTitleKey="imprintTitle"
  pageSubtitle={t(locale, 'imprintSubtitle')}
  pageSubtitleKey="imprintSubtitle"
>
  <section class="section">
    <div class="container">
      <div class="legal-content">

        <div class="legal-card">
          <h2 data-i18n="imprintClubName">{t(locale, 'imprintClubName')}</h2>
          <p><strong>KSC Wiedikon</strong></p>
          <p>KantonsSchule Club Wiedikon</p>
        </div>

        <div class="legal-card">
          <h2 data-i18n="imprintAddress">{t(locale, 'imprintAddress')}</h2>
          <p>Schrennengasse 7</p>
          <p>8003 Zürich</p>
        </div>

        <div class="legal-card">
          <h2 data-i18n="imprintContact">{t(locale, 'imprintContact')}</h2>
          <p>E-Mail: <a href="mailto:kscw@kscw.ch">kscw@kscw.ch</a></p>
          <p>Website: <a href="https://kscw.ch">kscw.ch</a></p>
        </div>

        <div class="legal-card">
          <h2 data-i18n="imprintBoard">{t(locale, 'imprintBoard')}</h2>
          <p data-i18n="imprintBoardText">{t(locale, 'imprintBoardText')}</p>
          <p style="margin-top: var(--space-sm);"><a href="/club/vorstand" class="btn btn-sm" data-i18n="imprintBoardLink">{t(locale, 'imprintBoardLink')}</a></p>
        </div>

        <div class="legal-card">
          <h2 data-i18n="imprintDisclaimer">{t(locale, 'imprintDisclaimer')}</h2>
          <p data-i18n="imprintDisclaimerText">{t(locale, 'imprintDisclaimerText')}</p>
        </div>

        <div class="legal-card">
          <h2 data-i18n="imprintLinks">{t(locale, 'imprintLinks')}</h2>
          <p data-i18n="imprintLinksText">{t(locale, 'imprintLinksText')}</p>
        </div>

        <div class="legal-card">
          <h2 data-i18n="imprintHosting">{t(locale, 'imprintHosting')}</h2>
          <p data-i18n="imprintHostingText">{t(locale, 'imprintHostingText')}</p>
        </div>

        <div class="legal-card">
          <h2 data-i18n="imprintCopyright">{t(locale, 'imprintCopyright')}</h2>
          <p data-i18n="imprintCopyrightText">{t(locale, 'imprintCopyrightText')}</p>
        </div>

      </div>
    </div>
  </section>
</PageLayout>

<style>
  .legal-content {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    text-align: justify;
  }
  .legal-card h2 {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--accent-text, #4A55A2);
    margin-bottom: var(--space-sm);
  }
  .legal-card p {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .legal-card a {
    color: var(--accent-text, #4A55A2);
  }
  .legal-card a:hover {
    text-decoration: underline;
  }
</style>
