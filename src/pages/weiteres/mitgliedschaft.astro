---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { t } from '../../lib/i18n';

const locale = 'de';
---
<PageLayout
  title="Mitgliedschaft — KSC Wiedikon"
  titleKey="weiteresMitgliedschaftMetaTitle"
  description="Mitglied werden beim KSC Wiedikon — Beiträge, Anmeldung und Vorteile."
  descriptionKey="weiteresMitgliedschaftMetaDescription"
  locale={locale}
  pageTitle={t(locale, 'membershipTitle')}
  pageTitleKey="membershipTitle"
  pageSubtitle={t(locale, 'membershipSubtitle')}
  pageSubtitleKey="membershipSubtitle"
>
  <!-- Warum KSCW? -->
  <section class="section">
    <div class="container">
      <SectionHeader title={t(locale, 'membershipWhy')} titleKey="membershipWhy" />
      <div class="grid grid-3">

        <div class="card">
          <div class="card-body" style="text-align: center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--kscw-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: var(--space-md);"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <h3 style="margin-bottom: var(--space-sm);" data-i18n="membershipTeamSpirit">{t(locale, 'membershipTeamSpirit')}</h3>
            <p style="color: var(--text-secondary);" data-i18n="membershipTeamSpiritText">{t(locale, 'membershipTeamSpiritText')}</p>
          </div>
        </div>

        <div class="card">
          <div class="card-body" style="text-align: center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--kscw-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: var(--space-md);"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5C7 4 9 7 12 7s5-3 7.5-3a2.5 2.5 0 0 1 0 5H18"/><path d="M18 15h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M6 15H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="m2 21 8-8"/><path d="m14 21 8-8"/><path d="m8 21 4-4 4 4"/><path d="M12 3v4"/></svg>
            <h3 style="margin-bottom: var(--space-sm);" data-i18n="membershipTraining">{t(locale, 'membershipTraining')}</h3>
            <p style="color: var(--text-secondary);" data-i18n="membershipTrainingText">{t(locale, 'membershipTrainingText')}</p>
          </div>
        </div>

        <div class="card">
          <div class="card-body" style="text-align: center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--kscw-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: var(--space-md);"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            <h3 style="margin-bottom: var(--space-sm);" data-i18n="membershipCommunity">{t(locale, 'membershipCommunity')}</h3>
            <p style="color: var(--text-secondary);" data-i18n="membershipCommunityText">{t(locale, 'membershipCommunityText')}</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Mitgliederbeiträge -->
  <section class="section-alt">
    <div class="container">
      <SectionHeader title={t(locale, 'membershipFees')} titleKey="membershipFees" />
      <div style="max-width: 640px;">
        <!-- Volleyball Fees -->
        <h3 style="margin-bottom: var(--space-md);">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--kscw-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-right: 8px;"><circle cx="12" cy="12" r="10"/><path d="M19.13 5.09C15.22 9.14 10 10.44 2.25 10.94"/><path d="M21.75 12.84c-6.62-1.41-12.14 1-16.38 6.32"/><path d="M8.56 2.75c4.37 6 6 9.42 8 17.72"/></svg>
          <span data-i18n="membershipFeesVolleyball">{t(locale, 'membershipFeesVolleyball')}</span>
        </h3>
        <div class="table-wrap">
        <table style="width: 100%; border-collapse: collapse; background: var(--surface); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">
          <thead>
            <tr style="background: var(--kscw-blue); color: white;">
              <th style="padding: var(--space-md) var(--space-lg); text-align: left; font-weight: 600;" data-i18n="membershipCategory">{t(locale, 'membershipCategory')}</th>
              <th style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 600;" data-i18n="membershipFee">{t(locale, 'membershipFee')}</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-md) var(--space-lg);">
                <strong data-i18n="membershipCategoryTournamentKWI">{t(locale, 'membershipCategoryTournamentKWI')}</strong><br>
                <span style="font-size: 0.875rem; color: var(--text-secondary);" data-i18n="membershipCategoryTournamentKWIDesc">{t(locale, 'membershipCategoryTournamentKWIDesc')}</span>
              </td>
              <td style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 700; font-size: 1.125rem; color: var(--kscw-blue);">CHF 110</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-md) var(--space-lg);">
                <strong data-i18n="membershipCategoryTournament">{t(locale, 'membershipCategoryTournament')}</strong><br>
                <span style="font-size: 0.875rem; color: var(--text-secondary);" data-i18n="membershipCategoryTournamentDesc">{t(locale, 'membershipCategoryTournamentDesc')}</span>
              </td>
              <td style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 700; font-size: 1.125rem; color: var(--kscw-blue);">CHF 210</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-md) var(--space-lg);">
                <strong data-i18n="membershipCategoryHighSchool">{t(locale, 'membershipCategoryHighSchool')}</strong><br>
                <span style="font-size: 0.875rem; color: var(--text-secondary);" data-i18n="membershipCategoryHighSchoolDesc">{t(locale, 'membershipCategoryHighSchoolDesc')}</span>
              </td>
              <td style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 700; font-size: 1.125rem; color: var(--kscw-blue);">CHF 310</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-md) var(--space-lg);">
                <strong data-i18n="membershipCategoryStudent">{t(locale, 'membershipCategoryStudent')}</strong><br>
                <span style="font-size: 0.875rem; color: var(--text-secondary);" data-i18n="membershipCategoryStudentDesc">{t(locale, 'membershipCategoryStudentDesc')}</span>
              </td>
              <td style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 700; font-size: 1.125rem; color: var(--kscw-blue);">CHF 380</td>
            </tr>
            <tr>
              <td style="padding: var(--space-md) var(--space-lg);">
                <strong data-i18n="membershipCategoryWorking">{t(locale, 'membershipCategoryWorking')}</strong><br>
                <span style="font-size: 0.875rem; color: var(--text-secondary);" data-i18n="membershipCategoryWorkingDesc">{t(locale, 'membershipCategoryWorkingDesc')}</span>
              </td>
              <td style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 700; font-size: 1.125rem; color: var(--kscw-blue);">CHF 440</td>
            </tr>
          </tbody>
        </table>
        </div>
        <p style="margin-top: var(--space-md); font-size: 0.875rem; color: var(--text-secondary);">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-right: 4px;"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          <span data-i18n="membershipFeesNoteVB">{t(locale, 'membershipFeesNoteVB')}</span>
        </p>
        <p style="margin-top: var(--space-sm); font-size: 0.875rem; color: var(--kscw-blue); font-weight: 600;">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-right: 4px;"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
          <span data-i18n="membershipFeesNoteScorer">{t(locale, 'membershipFeesNoteScorer')}</span>
        </p>

        <!-- Swiss Volley Licence Fees -->
        <h3 style="margin-top: var(--space-xl); margin-bottom: var(--space-md);" data-i18n="membershipLicenceTitle">{t(locale, 'membershipLicenceTitle')}</h3>
        <div class="table-wrap">
        <table style="width: 100%; border-collapse: collapse; background: var(--surface); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">
          <thead>
            <tr style="background: var(--kscw-blue); color: white;">
              <th style="padding: var(--space-sm) var(--space-lg); text-align: left; font-weight: 600;" data-i18n="membershipCategory">{t(locale, 'membershipCategory')}</th>
              <th style="padding: var(--space-sm) var(--space-lg); text-align: right; font-weight: 600;" data-i18n="membershipFee">{t(locale, 'membershipFee')}</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-sm) var(--space-lg);" data-i18n="membershipLicenceNLL">{t(locale, 'membershipLicenceNLL')}</td>
              <td style="padding: var(--space-sm) var(--space-lg); text-align: right; font-weight: 600;">CHF 250</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-sm) var(--space-lg);" data-i18n="membershipLicenceRLL">{t(locale, 'membershipLicenceRLL')}</td>
              <td style="padding: var(--space-sm) var(--space-lg); text-align: right; font-weight: 600;">CHF 110</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-sm) var(--space-lg);" data-i18n="membershipLicenceJLL">{t(locale, 'membershipLicenceJLL')}</td>
              <td style="padding: var(--space-sm) var(--space-lg); text-align: right; font-weight: 600;">CHF 60</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-sm) var(--space-lg);" data-i18n="membershipLicenceU16">{t(locale, 'membershipLicenceU16')}</td>
              <td style="padding: var(--space-sm) var(--space-lg); text-align: right; font-weight: 600;">CHF 30</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-sm) var(--space-lg);" data-i18n="membershipLicenceU13">{t(locale, 'membershipLicenceU13')}</td>
              <td style="padding: var(--space-sm) var(--space-lg); text-align: right; font-weight: 600;">CHF 15</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-sm) var(--space-lg);" data-i18n="membershipLicenceDoppelR">{t(locale, 'membershipLicenceDoppelR')}</td>
              <td style="padding: var(--space-sm) var(--space-lg); text-align: right; font-weight: 600;">CHF 110</td>
            </tr>
            <tr>
              <td style="padding: var(--space-sm) var(--space-lg);" data-i18n="membershipLicenceDoppelN">{t(locale, 'membershipLicenceDoppelN')}</td>
              <td style="padding: var(--space-sm) var(--space-lg); text-align: right; font-weight: 600;">CHF 250</td>
            </tr>
          </tbody>
        </table>
        </div>

        <!-- Basketball Fees -->
        <h3 style="margin-top: var(--space-2xl); margin-bottom: var(--space-md);">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--kscw-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-right: 8px;"><circle cx="12" cy="12" r="10"/><path d="M9 3.6C5.4 8.6 4.2 12.2 3.2 18.4"/><path d="M21 12c-1-1-2-2-3-2s-2 1-3 2-2 2-3 2-2-1-3-2"/><path d="M14.8 3.6c3.5 5 4.8 8.6 5.8 14.8"/></svg>
          <span data-i18n="membershipFeesBasketball">{t(locale, 'membershipFeesBasketball')}</span>
        </h3>
        <div class="table-wrap">
        <table style="width: 100%; border-collapse: collapse; background: var(--surface); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">
          <thead>
            <tr style="background: var(--kscw-blue); color: white;">
              <th style="padding: var(--space-md) var(--space-lg); text-align: left; font-weight: 600;" data-i18n="membershipCategory">{t(locale, 'membershipCategory')}</th>
              <th style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 600;" data-i18n="membershipFee">{t(locale, 'membershipFee')}</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-md) var(--space-lg);">
                <strong data-i18n="membershipCategoryBBActive1L">{t(locale, 'membershipCategoryBBActive1L')}</strong><br>
                <span style="font-size: 0.875rem; color: var(--text-secondary);" data-i18n="membershipCategoryBBActive1LDesc">{t(locale, 'membershipCategoryBBActive1LDesc')}</span>
              </td>
              <td style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 700; font-size: 1.125rem; color: var(--kscw-blue);">CHF 570</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-md) var(--space-lg);">
                <strong data-i18n="membershipCategoryBBStudent1L">{t(locale, 'membershipCategoryBBStudent1L')}</strong><br>
                <span style="font-size: 0.875rem; color: var(--text-secondary);" data-i18n="membershipCategoryBBStudent1LDesc">{t(locale, 'membershipCategoryBBStudent1LDesc')}</span>
              </td>
              <td style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 700; font-size: 1.125rem; color: var(--kscw-blue);">CHF 470</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-md) var(--space-lg);">
                <strong data-i18n="membershipCategoryBBActive">{t(locale, 'membershipCategoryBBActive')}</strong><br>
                <span style="font-size: 0.875rem; color: var(--text-secondary);" data-i18n="membershipCategoryBBActiveDesc">{t(locale, 'membershipCategoryBBActiveDesc')}</span>
              </td>
              <td style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 700; font-size: 1.125rem; color: var(--kscw-blue);">CHF 520</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-md) var(--space-lg);">
                <strong data-i18n="membershipCategoryBBStudent">{t(locale, 'membershipCategoryBBStudent')}</strong><br>
                <span style="font-size: 0.875rem; color: var(--text-secondary);" data-i18n="membershipCategoryBBStudentDesc">{t(locale, 'membershipCategoryBBStudentDesc')}</span>
              </td>
              <td style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 700; font-size: 1.125rem; color: var(--kscw-blue);">CHF 420</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-md) var(--space-lg);">
                <strong data-i18n="membershipCategoryBBYouth">{t(locale, 'membershipCategoryBBYouth')}</strong><br>
                <span style="font-size: 0.875rem; color: var(--text-secondary);" data-i18n="membershipCategoryBBYouthDesc">{t(locale, 'membershipCategoryBBYouthDesc')}</span>
              </td>
              <td style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 700; font-size: 1.125rem; color: var(--kscw-blue);">CHF 320</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: var(--space-md) var(--space-lg);">
                <strong data-i18n="membershipCategoryBBMinis">{t(locale, 'membershipCategoryBBMinis')}</strong><br>
                <span style="font-size: 0.875rem; color: var(--text-secondary);" data-i18n="membershipCategoryBBMinisDesc">{t(locale, 'membershipCategoryBBMinisDesc')}</span>
              </td>
              <td style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 700; font-size: 1.125rem; color: var(--kscw-blue);">CHF 220</td>
            </tr>
            <tr>
              <td style="padding: var(--space-md) var(--space-lg);">
                <strong data-i18n="membershipCategoryBBPassive">{t(locale, 'membershipCategoryBBPassive')}</strong><br>
                <span style="font-size: 0.875rem; color: var(--text-secondary);" data-i18n="membershipCategoryBBPassiveDesc">{t(locale, 'membershipCategoryBBPassiveDesc')}</span>
              </td>
              <td style="padding: var(--space-md) var(--space-lg); text-align: right; font-weight: 700; font-size: 1.125rem; color: var(--kscw-blue);">CHF 40</td>
            </tr>
          </tbody>
        </table>
        </div>
        <p style="margin-top: var(--space-md); font-size: 0.875rem; color: var(--text-secondary);">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-right: 4px;"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          <span data-i18n="membershipFeesNoteBB">{t(locale, 'membershipFeesNoteBB')}</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Anmeldung -->
  <section class="section">
    <div class="container">
      <SectionHeader title={t(locale, 'membershipRegistration')} titleKey="membershipRegistration" />
      <div style="max-width: 720px;">
        <p style="font-size: 1.125rem; line-height: 1.8; color: var(--text-secondary); margin-bottom: var(--space-lg);">
          <span data-i18n="membershipRegistrationText">{t(locale, 'membershipRegistrationText')}</span>
        </p>

        <div style="display: flex; flex-direction: column; gap: var(--space-md); margin-bottom: var(--space-xl);">

          <div class="card" style="border-left: 4px solid var(--kscw-gold);">
            <div class="card-body" style="display: flex; align-items: flex-start; gap: var(--space-md);">
              <div style="min-width: 48px; height: 48px; background: var(--kscw-gold); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.25rem;">1</div>
              <div>
                <h3 style="margin-bottom: var(--space-xs);" data-i18n="membershipStep1">{t(locale, 'membershipStep1')}</h3>
                <p style="color: var(--text-secondary);" data-i18n="membershipStep1Text">{t(locale, 'membershipStep1Text')}</p>
              </div>
            </div>
          </div>

          <div class="card" style="border-left: 4px solid var(--kscw-blue);">
            <div class="card-body" style="display: flex; align-items: flex-start; gap: var(--space-md);">
              <div style="min-width: 48px; height: 48px; background: var(--kscw-blue); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.25rem;">2</div>
              <div>
                <h3 style="margin-bottom: var(--space-xs);" data-i18n="membershipStep2">{t(locale, 'membershipStep2')}</h3>
                <p style="color: var(--text-secondary);" data-i18n="membershipStep2Text">{t(locale, 'membershipStep2Text')}</p>
              </div>
            </div>
          </div>

          <div class="card" style="border-left: 4px solid var(--kscw-gold);">
            <div class="card-body" style="display: flex; align-items: flex-start; gap: var(--space-md);">
              <div style="min-width: 48px; height: 48px; background: var(--kscw-gold); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.25rem;">3</div>
              <div>
                <h3 style="margin-bottom: var(--space-xs);" data-i18n="membershipStep3">{t(locale, 'membershipStep3')}</h3>
                <p style="color: var(--text-secondary);" data-i18n="membershipStep3Text">{t(locale, 'membershipStep3Text')}</p>
              </div>
            </div>
          </div>

        </div>

        <div style="margin-bottom: var(--space-lg);">
          <p style="text-align: center; color: var(--text-secondary); margin-bottom: var(--space-lg);">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-right: 4px;"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            <span data-i18n="membershipCoachNote">{t(locale, 'membershipCoachNote')}</span>
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: var(--space-md); justify-content: center;">
            <a href="/weiteres/anmeldung?type=volleyball" class="btn btn-gold" style="font-size: 1rem; padding: var(--space-md) var(--space-xl);">
              <span data-i18n="membershipRegisterVB">{t(locale, 'membershipRegisterVB')}</span>
            </a>
            <a href="/weiteres/anmeldung?type=basketball" class="btn" style="font-size: 1rem; padding: var(--space-md) var(--space-xl); background: var(--kscw-blue); color: white;">
              <span data-i18n="membershipRegisterBB">{t(locale, 'membershipRegisterBB')}</span>
            </a>
          </div>
        </div>

