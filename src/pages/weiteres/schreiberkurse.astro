---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { t } from '../../lib/i18n';

const locale = 'de';
---
<PageLayout
  title="Schreiberkurse — KSC Wiedikon"
  titleKey="weiteresSchreiberkurseMetaTitle"
  description="Ausbildungsmaterial und Kursunterlagen für Volleyball-Schreiber*innen beim KSC Wiedikon."
  descriptionKey="weiteresSchreiberkurseMetaDescription"
  locale={locale}
  pageTitle={t(locale, 'scorerCoursesTitle')}
  pageTitleKey="scorerCoursesTitle"
  pageSubtitle={t(locale, 'scorerCoursesSubtitle')}
  pageSubtitleKey="scorerCoursesSubtitle"
>
  <!-- Intro -->
  <section class="section">
    <div class="container">
      <div class="measure measure-center">
        <p style="font-size: 1.125rem; line-height: 1.8; color: var(--text-secondary);" data-i18n="scorerCoursesIntro">
          {t(locale, 'scorerCoursesIntro')}
        </p>
      </div>
    </div>
  </section>

  <section class="section" data-scorer-section hidden>
    <div class="container">
      <SectionHeader title={t(locale, 'scorerSignupTitle')} titleKey="scorerSignupTitle" />
      <p class="measure measure-center" style="color: var(--text-secondary); margin-bottom: var(--space-lg);" data-i18n="scorerSignupIntro">
        {t(locale, 'scorerSignupIntro')}
      </p>
      <div
        data-scorer-courses
        class="measure-center"
        style="display: flex; flex-direction: column; gap: var(--space-xl); max-width: 760px;"
      ></div>
    </div>
  </section>

  <!-- Resources Grid -->
  <section class="section-alt">
    <div class="container">
      <SectionHeader title={t(locale, 'scorerCoursesResourcesTitle')} titleKey="scorerCoursesResourcesTitle" />
      <!-- No max-width: the cards are self-contained tiles, so they earn the full
           container instead of stacking into a 900px column with empty space beside it. -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-lg);">

        <!-- Offizielles Matchblatt -->
        <div class="card">
          <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-md);">
            <div style="display: flex; align-items: center; gap: var(--space-sm);">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--kscw-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
              <h3 style="margin: 0;" data-i18n="scorerCoursesMatchblatt">{t(locale, 'scorerCoursesMatchblatt')}</h3>
            </div>
            <p style="color: var(--text-secondary); flex: 1;" data-i18n="scorerCoursesMatchblattDesc">{t(locale, 'scorerCoursesMatchblattDesc')}</p>
            <a href="https://drive.google.com/file/d/18OH8RnmQCJsvF5Haa7FciNQBuk83B6C1/view" target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="align-self: flex-start;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              <span data-i18n="scorerCoursesDownload">{t(locale, 'scorerCoursesDownload')}</span>
            </a>
          </div>
        </div>

        <!-- Schreiberkurs-Unterlagen -->
        <div class="card">
          <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-md);">
            <div style="display: flex; align-items: center; gap: var(--space-sm);">
              <i data-lucide="file-text" style="width: 32px; height: 32px; color: var(--kscw-blue); flex-shrink: 0;"></i>
              <h3 style="margin: 0;" data-i18n="scorerCoursesHandout">{t(locale, 'scorerCoursesHandout')}</h3>
            </div>
            <p style="color: var(--text-secondary); flex: 1;" data-i18n="scorerCoursesHandoutDesc">{t(locale, 'scorerCoursesHandoutDesc')}</p>
            <a href="/docs/schreiberwesen.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="align-self: flex-start;">
              <i data-lucide="eye" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 6px;"></i>
              <span data-i18n="scorerCoursesView">{t(locale, 'scorerCoursesView')}</span>
            </a>
          </div>
        </div>

        <!-- Anleitung E-Learning-Registrierung -->
        <div class="card">
          <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-md);">
            <div style="display: flex; align-items: center; gap: var(--space-sm);">
              <i data-lucide="clipboard-list" style="width: 32px; height: 32px; color: var(--kscw-gold); flex-shrink: 0;"></i>
              <h3 style="margin: 0;" data-i18n="scorerCoursesElearningReg">{t(locale, 'scorerCoursesElearningReg')}</h3>
            </div>
            <p style="color: var(--text-secondary); flex: 1;" data-i18n="scorerCoursesElearningRegDesc">{t(locale, 'scorerCoursesElearningRegDesc')}</p>
            <a href="/docs/schreiberwesen-elearning-registration.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-gold" style="align-self: flex-start;">
              <i data-lucide="eye" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 6px;"></i>
              <span data-i18n="scorerCoursesView">{t(locale, 'scorerCoursesView')}</span>
            </a>
          </div>
        </div>

        <!-- E-Learning -->
        <div class="card">
          <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-md);">
            <div style="display: flex; align-items: center; gap: var(--space-sm);">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--kscw-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/><polygon points="10 8 16 11 10 14 10 8"/></svg>
              <h3 style="margin: 0;" data-i18n="scorerCoursesElearning">{t(locale, 'scorerCoursesElearning')}</h3>
            </div>
            <p style="color: var(--text-secondary); flex: 1;" data-i18n="scorerCoursesElearningDesc">{t(locale, 'scorerCoursesElearningDesc')}</p>
            <a href="https://swissvolley.triagonal.net/online/login/index.php" target="_blank" rel="noopener noreferrer" class="btn btn-gold" style="align-self: flex-start;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
              <span data-i18n="scorerCoursesOpen">{t(locale, 'scorerCoursesOpen')}</span>
            </a>
          </div>
        </div>

        <!-- Course PDF (2026) -->
        <div class="card">
          <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-md);">
            <div style="display: flex; align-items: center; gap: var(--space-sm);">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--kscw-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
              <h3 style="margin: 0;" data-i18n="scorerCoursesPdf">{t(locale, 'scorerCoursesPdf')}</h3>
            </div>
            <p style="color: var(--text-secondary); flex: 1;" data-i18n="scorerCoursesPdfDesc">{t(locale, 'scorerCoursesPdfDesc')}</p>
            <a href="https://drive.google.com/file/d/1oJ2V94PEBtP2n0K8yO1oQ3vC3V6MzH1D/view" target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="align-self: flex-start;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              <span data-i18n="scorerCoursesDownload">{t(locale, 'scorerCoursesDownload')}</span>
            </a>
          </div>
        </div>

        <!-- Course presentation PPT (2026) -->
        <div class="card">
          <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-md);">
            <div style="display: flex; align-items: center; gap: var(--space-sm);">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--kscw-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="M2 3h20"/><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/><path d="m7 21 5-5 5 5"/></svg>
              <h3 style="margin: 0;" data-i18n="scorerCoursesPpt">{t(locale, 'scorerCoursesPpt')}</h3>
            </div>
            <p style="color: var(--text-secondary); flex: 1;" data-i18n="scorerCoursesPptDesc">{t(locale, 'scorerCoursesPptDesc')}</p>
            <a href="https://docs.google.com/presentation/d/1vH-x7CF0YlnB3lWVx8Pduj2-mYFkoROO/edit?usp=sharing" target="_blank" rel="noopener noreferrer" class="btn btn-gold" style="align-self: flex-start;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
              <span data-i18n="scorerCoursesOpen">{t(locale, 'scorerCoursesOpen')}</span>
            </a>
          </div>
        </div>

        <!-- Prüfung: scoresheet upload -->
        <div class="card">
          <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-md);">
            <div style="display: flex; align-items: center; gap: var(--space-sm);">
              <i data-lucide="upload" style="width: 32px; height: 32px; color: var(--kscw-gold); flex-shrink: 0;"></i>
              <h3 style="margin: 0;" data-i18n="scorerCoursesExamUpload">{t(locale, 'scorerCoursesExamUpload')}</h3>
            </div>
            <p style="color: var(--text-secondary); flex: 1;" data-i18n="scorerCoursesExamUploadDesc">{t(locale, 'scorerCoursesExamUploadDesc')}</p>
            <a href="/weiteres/schreiberkurse/pruefung" class="btn btn-gold" style="align-self: flex-start;">
              <i data-lucide="upload" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 6px;"></i>
              <span data-i18n="scorerCoursesExamUploadCta">{t(locale, 'scorerCoursesExamUploadCta')}</span>
            </a>
          </div>
        </div>

        <!-- Video -->
        <div class="card" style="grid-column: 1 / -1;">
          <div class="card-body" style="display: flex; flex-direction: column; gap: var(--space-md);">
            <div style="display: flex; align-items: center; gap: var(--space-sm);">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--kscw-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.934a.5.5 0 0 0-.777-.416L16 11"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
              <h3 style="margin: 0;" data-i18n="scorerCoursesVideo">{t(locale, 'scorerCoursesVideo')}</h3>
            </div>
            <p style="color: var(--text-secondary); flex: 1;" data-i18n="scorerCoursesVideoDesc">{t(locale, 'scorerCoursesVideoDesc')}</p>
            <a href="https://drive.google.com/file/d/14rTL9Rf8mHV5ZiBuRquzB8n0IH1jJeZp/view" target="_blank" rel="noopener noreferrer" class="btn btn-gold" style="align-self: flex-start;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><polygon points="6 3 20 12 6 21 6 3"/></svg>
              <span data-i18n="scorerCoursesWatch">{t(locale, 'scorerCoursesWatch')}</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Swiss Volley Link -->
  <section class="section">
    <div class="container">
      <div class="measure measure-center" style="text-align: center;">
        <p style="font-size: 1.125rem; line-height: 1.8; color: var(--text-secondary); margin-bottom: var(--space-lg);" data-i18n="scorerCoursesSwissVolley">
          {t(locale, 'scorerCoursesSwissVolley')}
        </p>
        <a href="https://www.volleyball.ch/de/ausbildung/schiedsrichter-innen/schreiber-in-werden" target="_blank" rel="noopener noreferrer" class="btn btn-gold" style="font-size: 1.125rem; padding: var(--space-md) var(--space-xl);">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 8px;"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
          <span data-i18n="scorerCoursesSwissVolleyLink">{t(locale, 'scorerCoursesSwissVolleyLink')}</span>
        </a>
      </div>
    </div>
  </section>

  <script src="../../islands/scroll-animations.ts"></script>
  <script src="../../islands/scorer-courses.ts"></script>
</PageLayout>
